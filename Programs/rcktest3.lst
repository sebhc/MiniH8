                        ; =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
                        ;
                        ;	This program demonstrates a replacement for
                        ;	the PAM-8 Read Console Keypad (RCK) routine.
                        ;	This version is designed to work with the
                        ;	H8 Mini. The RCK routine will replace
                        ;	the PAM-8 one in the new ROM.
                        ;
                        ;
                        ;	GFR	9/1/2026
                        ;
                        
                        ;	8255 PPI at 0F0-0F3
                        
   00f0                 PPI	EQU	0F0h
   0000                 IO.A	EQU	0
                        ;
                        ;	Debounce and auto-repeat delays (ms)
                        ;
   000a                 DBDLY	EQU	10
   0190                 ARDLY	EQU	400
                        
                        ;
                        ;	Monitor entry points and key values
                        ;
   0053                 DLY	EQU	0053H		; 2ms delay routine
                        
   04b3                 PRTHEX	EQU	04B3H		; print byte in A in hex
   04c7                 PRTSPC	EQU	04C7H		; print a space
   04d6                 PRTCLS	EQU	04D6H		; print CR/LF then string
   04d9                 PRTSTR	EQU	04D9H		; print string
   04cc                 CRLF	EQU	04CCH		; print CR/LF
   2034                 KEYVAL	EQU	2034H		; temp storage for key value
   2016                 RCKA	EQU	2016H		; key passing byte
                        
   2040                 	ORG	2040h		; ORG at 040.100
                        	
   2040   cd cc 04      START:	CALL	CRLF		; start on a new line
                        ;
                        ;	Assumes PPI has been initialized by the ROM
                        ;
                        ;
                        ;	Loop calling RCK and printing result
                        ;
   2043   cd 4f 20      LOOP:	CALL	RCK		; read console keypad (blocking read)
                        
                        ;
                        ;	debounce
                        ;
   2046   cd b3 04      	CALL	PRTHEX		; print the value
   2049   cd cc 04      	CALL	CRLF		; new line
                        	
   204c   c3 43 20      	JMP	LOOP		; and loop forever...
                        
                        ;
                        ;       RCK - Read Console Keypad
                        ;
                        ;
   204f   e5            RCK:	PUSH	H
   2050   c5            	PUSH	B
                        	
   2051   0e 28         	MVI	C,ARDLY/DBDLY
   2053   21 16 20      	LXI	H,RCKA		; point to keypad byte
                        ;
                        ;	First wait for some keyboard action
                        ;
   2056   3a 34 20      RCK1:	LDA	KEYVAL		; get most recent key hit
   2059   47            	MOV	B,A		; save it
   205a   3e 05         	MVI	A,DBDLY/2	; delay to debounce
   205c   cd 53 00      	CALL	DLY
   205f   78            	MOV	A,B		; get back candidate
                        	
   2060   be            	CMP	M		; compare to RCKA
   2061   c2 68 20      	JNZ	RCK2		; have a change
   2064   0d            	DCR	C		; wait N cycles (auto repeat)
   2065   c2 56 20      	JNZ	RCK1		; changed, start over
                        
   2068   77            RCK2:	MOV	M,A
   2069   b7            	ORA	A		; set flag bits
   206a   fa 56 20      	JM	RCK1		; bit 7 set... no key pressed
                        ;
                        ;	have a key (make a sound here)
                        ;	
                        ;
                        ;	Make noise here...
                        ;
   206d   e6 0f         	ANI	17Q		; make sure it's 4 bits
                        	
   206f   c1            	POP	B
   2070   e1            	POP	H
   2071   c9            	RET
                        ;
                        ;	simple version (for testing. no debounce)
                        ;
   2072   21 16 20      RK:	LXI	H,RCKA
   2075   7e            RK1:	MOV	A,M		; fetch possible key value
   2076   b7            	ORA	A		; set flags
   2077   fa 75 20      	JM	RK1		; loop 'til not negative
   207a   c9            	RET
                        
   2040                 	END	START
0190  ARDLY         04cc  CRLF          000a  DBDLY         0053  DLY       
0000  IO.A          2034  KEYVAL        2043  LOOP          00f0  PPI       
04d6  PRTCLS        04b3  PRTHEX        04c7  PRTSPC        04d9  PRTSTR    
204f  RCK           2056  RCK1          2068  RCK2          2016  RCKA      
2072  RK            2075  RK1           2040  START         
