                        ;
                        ;	Classic LED1 demo, adapted for H8 Mini
                        ;
                        ;	Uses A85 Assembler
                        ;
                        ;	Glenn Roberts	8 September 2026
                        ;
                        
   200b                 FPLEDS	EQU	200BH
   2008                 MFLAG	EQU	2008H
                        
   0053                 DLY	EQU	0053H
                        
   00f0                 CTLPORT	EQU	360Q
                        
                        ;
                        ;	Org at 40K but we will store in ROM at 2000H
                        ;
   2040                 	ORG	02040H
                        ;
                        ; Here's the classic LED demo code ...
                        ;
   2040   3e 02         DEMO:	MVI	A,00000010B	; Disable LED updates
   2042   32 08 20      	STA	MFLAG
                        
   2045   06 00         BEGIN:	MVI	B,0		; Initial pattern
                        
   2047   21 0b 20      MLOOP:	LXI	H,FPLEDS	; Point to LED refresh RAM
   204a   0e 09         	MVI	C,9		; 9 LEDs to refresh
                        
   204c   78            	MOV	A,B		; Grab current pattern
                        ;
                        ;	copy the same pattern to all 9 LED positions
                        ;
   204d   77            LLOOP:	MOV	M,A		; Store in LED position
   204e   23            	INX	H		; Point to next LED position
   204f   0d            	DCR	C		; Count down
   2050   c2 4d 20      	JNZ	LLOOP
                        ;
                        ;	Delay a bit...
                        ;
   2053   0e 01         	MVI	C,1		; Call .DLY once
   2055   3e 32         DLOOP:	MVI	A,50
   2057   cd 53 00      	CALL	DLY		; delay...
   205a   0d            	DCR	C		; Count down
   205b   c2 55 20      	JNZ	DLOOP
                        
   205e   05            	DCR	B		; Change the pattern
   205f   c2 47 20      	JNZ	MLOOP		; Loop through all patterns
                        ;
                        ;	Have cycled through all 255 patterns, now repeat
                        ;
   2062   c3 45 20      	JMP	BEGIN		; Now start over!
                        
   2040                 	END	DEMO
2045  BEGIN         00f0  CTLPORT       2040  DEMO          2055  DLOOP     
0053  DLY           200b  FPLEDS        204d  LLOOP         2008  MFLAG     
2047  MLOOP         
