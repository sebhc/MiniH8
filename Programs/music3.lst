                        ; MUSIC3 - Program to play music on the H8 Mini
                        ;
                        ; Based on the approach by James Grogan and Robert Monteith.
                        ;
                        ; This approach was first discussed in Monteith's contribution to HUG 885-1008
                        ; (Heath User Group's first software volume). By lifting pin 9 on IC112
                        ; on the H8 front panel the speaker output can be converted to direct control
                        ; by the CPU (otherwise the CPU simply toggles the 1Khz square wave input
                        ; to the speaker.) The approach was further refined by Grogan and published
                        ; in HUG 885-1031 volumes A and B. The approach taken was to develop a Benton Harbor
                        ; BASIC program to create/edit music. The output of the BASIC program was an
                        ; HDOS executable (.ABS file) consisting of a short assembly program and
                        ; the musical SCORE. This program is based on a disassembly of the .ABS file
                        ; (the ASM source for that was never published).
                        ;
                        ; The advantage of this approach is that there are multiple music files
                        ; that have already been created that can be adapted to the Mini H8.
                        ;
                        ; G. Roberts	October 2026
                        ;
                        
                        ;
                        ;	H8 Mini equates
                        ;
                        ;	8255 PPI at 0F0-0F3
                        ;
   00f0                 PPI	EQU	0F0H
   0000                 IO.A	EQU	0
   0001                 IO.B	EQU	1
                        
   2040                 	ORG	2040H		; ORG at 040.100A
                        ;
                        ;	Plays the score then does a cold reboot on H8 Mini
                        ;
   2040   f3            START:	DI			; interrupts off
                        ;
                        ;	Blank any front panel LEDs that were left lit when
                        ;	we killed the update.
                        ;
   2041   db f0         BLANK:	IN	PPI+IO.A	; read port A settings
   2043   e6 f0         	ANI	11110000B	; clear LED selects (PA0..PA3)
   2045   47            	MOV	B,A		; save it
   2046   0e 09         	MVI	C,9		; 9 LEDs
   2048   81            BLOOP:	ADD	C		; address an LED
   2049   d3 f0         	OUT	PPI+IO.A	; select it
   204b   af            	XRA	A		; zero = all segments off
   204c   d3 f1         	OUT	PPI+IO.B	; turn off all segments
   204e   78            	MOV	A,B		; get back mask
   204f   0d            	DCR	C		; count down
   2050   c2 48 20      	JNZ	BLOOP		; and loop through all 9
                        
   2053   cd 5a 20      	CALL	PLAY		; play the tune
                        	
   2056   fb            	EI			; interrupts on
   2057   c3 00 00      	JMP	0H		; reboot
                        	
                        ;
                        ;	Play SCORE
                        ;
   205a   21 a7 20      PLAY:	LXI	H,SCORE		; point to score
   205d   e5            	PUSH	H		; keep our place
                        ;
                        ;	Note loop
                        ;
   205e   e1            NLOOP:	POP	H		; our place in the score
   205f   5e            	MOV	E,M
   2060   23            	INX	H
   2061   56            	MOV	D,M		; (DE) = note duration
   2062   23            	INX	H
   2063   7a            	MOV	A,D		; test for zero
   2064   b3            	ORA	E
   2065   ca 91 20      	JZ	PEXIT		; tune over
   2068   4e            	MOV	C,M
   2069   23            	INX	H
   206a   46            	MOV	B,M		; (BC) = period counter
   206b   23            	INX	H
   206c   e5            	PUSH	H		; save our place in the score
                        	
   206d   78            	MOV	A,B
   206e   b1            	ORA	C
   206f   c2 81 20      	JNZ	PNOTE		; BC == 0 ? rest (DE) units, else note
                        ;
                        ;	Rest - duration = (DE)
                        ;	
   2072   06 32         REST:	MVI	B,50		; 7 states
                        ;
                        ;	loop count: 7 + 50*15 + 5 + 5 + 4 + 10 = 781 = 390 uS
                        ;
   2074   05            ILOOP:	DCR	B		; 5 states (on 8080); 4 cycles (8085)
   2075   c2 74 20      	JNZ	ILOOP		; 10 states
                        	
   2078   1b            	DCX	D		; 5 states (8080); 6 states (8085)
   2079   7a            	MOV	A,D		; 5 states (8085); 4 states (8085)
   207a   b3            	ORA	E		; 4 states
   207b   c2 72 20      	JNZ	REST		; 10 states
                        	
   207e   c3 5e 20      	JMP	NLOOP
                        ;
                        ;	Play note - duration = (DE)
                        ;
   2081   60            PNOTE:	MOV	H,B
   2082   69            	MOV	L,C		; (HL) = half period count
                        ;
                        ;	set speaker to "high" state
                        ;
   2083   db f0         	IN	PPI+IO.A	; Read Port A settings
   2085   e6 3f         	ANI	00111111B	; Clear top two bits (PA6-7
   2087   f6 80         	ORI	10000000B	; PA7 on; PA6 off
   2089   d3 f0         	OUT	PPI+IO.A	; set speaker bit
                        
   208b   cd 92 20      	CALL	NOTE		; play the note
                        	
   208e   c3 5e 20      	JMP	NLOOP		; go to next note
                        
   2091   c9            PEXIT:	RET			; tune is done
                        
                        ;
                        ;	NOTE - Play a note
                        ;
                        ;	ENTRY:	A = speaker mask
                        ;		DE = duration
                        ;		HL = half period
                        ;
                        ;	USES:	BC
                        ;
   2092                 NOTE	EQU	*
                        ;
                        ;	count half the period (HL)
                        ;
                        ;	12 uS per loop
                        ;
   2092   44            	MOV	B,H
   2093   4d            	MOV	C,L		; (BC) = half period count
   2094   0b            NOTE1:	DCX 	B		; 5 cycles (8080), 6 cycles (8085)
   2095   78            	MOV	A,B		; 5 cycles (8080), 4 cycles (8085)
   2096   b1            	ORA	C		; 4 cycles (8080 & 8085)
   2097   c2 94 20      	JNZ	NOTE1		; 10 cycles
                        ;
                        ;	Toggle speaker bits
                        ;
   209a   db f0         	IN	PPI+IO.A	; Read Port A settings
   209c   ee c0         	XRI	11000000B	; toggle PA6, PA7
   209e   d3 f0         	OUT	PPI+IO.A	; toggle speaker
                        ;
                        ;	count down the time 'til done
                        ;	
   20a0   1b            	DCX	D
   20a1   7a            	MOV	A,D
   20a2   b3            	ORA	E		; (DE) == 0?
   20a3   c2 92 20      	JNZ	NOTE		; and keep toggling
                        	
   20a6   c9            	RET
                        	
                        
   20a7                 SCORE	EQU	*
                        ;
                        ;	Each note is a word pair. The first word is the note
                        ;	duration and the second word is one half the note period
                        ;	A zero duration ends the tune. a zero half period is a rest.
                        ;
                        	INCL	"MOZART.TXT"
   20a7   5d 0f         ﻿	DW	0F5DH
   20a9   00 00         	DW	0000H
   20ab   93 00         	DW	0093H
   20ad   6a 00         	DW	006AH
   20af   83 00         	DW	0083H
   20b1   77 00         	DW	0077H
   20b3   7c 00         	DW	007CH
   20b5   7e 00         	DW	007EH
   20b7   93 00         	DW	0093H
   20b9   6a 00         	DW	006AH
   20bb   c3 00         	DW	00C3H
   20bd   4f 00         	DW	004FH
   20bf   f6 00         	DW	00F6H
   20c1   3e 00         	DW	003EH
   20c3   db 00         	DW	00DBH
   20c5   46 00         	DW	0046H
