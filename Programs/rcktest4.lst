                        ; =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
                        ;
                        ;	Test the new RCK function in minipam8
                        ;
                        ;
                        ;	GFR	9/14/2026
                        ;
                        
                        
                        ;
                        ;	Monitor entry points and key values
                        ;
   0053                 DLY	EQU	0053H		; 2ms delay routine
                        
   04c5                 PRTHEX	EQU	04C5H		; print byte in A in hex
   04d9                 PRTSPC	EQU	04D9H		; print a space
   04e8                 PRTCLS	EQU	04E8H		; print CR/LF then string
   04eb                 PRTSTR	EQU	04EBH		; print string
   04de                 CRLF	EQU	04DEH		; print CR/LF
                        
   0644                 RCK	EQU	0644H		; RCK (in minipam8)
   0276                 HORN	EQU	0276H		; HORN (in minipam8)
                        
   2040                 	ORG	2040h		; ORG at 040.100
                        	
   2040   cd de 04      START:	CALL	CRLF		; start on a new line
                        ;
                        ;	Assumes PPI has been initialized by the ROM
                        ;
                        ;
                        ;	Loop calling RCK and printing result
                        ;
   2043   cd 44 06      LOOP:	CALL	RCK		; read console keypad (blocking read)
                        
   2046   f5            	PUSH	PSW
   2047   3e 14         	MVI	A,20		; 20 ms beep
   2049   cd 76 02      	CALL	HORN
   204c   f1            	POP	PSW
                        	
   204d   cd c5 04      	CALL	PRTHEX		; print the value
   2050   cd de 04      	CALL	CRLF		; new line
                        	
   2053   c3 43 20      	JMP	LOOP		; and loop forever...
                        
                        
   2040                 	END	START
04de  CRLF          0053  DLY           0276  HORN          2043  LOOP      
04e8  PRTCLS        04c5  PRTHEX        04d9  PRTSPC        04eb  PRTSTR    
0644  RCK           2040  START         
