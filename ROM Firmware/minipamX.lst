0518  HDCMD         0282  HDLY1         0284  HDLY2         0475  HEXBYT    
0497  HEXDM1        049c  HEXDM2        04ad  HEXDM3        0495  HEXDMP    
0274  HORN          023e  IN            2036  INBADDR       2038  INBLEN    
00a7  INIT          0000  INIT0         00b7  INIT2         063d  INNER     
054f  INPCMD        002c  INT5.5        003c  INT7.5        00f0  INTXIT    
0000  IO.A          0001  IO.B          0002  IO.C          02a5  IOA       
02a9  IOB           02ab  IOB1          2002  IOWRK         00f0  IP.PAD    
00f9  IP.TPC        00f8  IP.TPD        0080  K0            0020  KMATH     
0010  KNUM          0040  KR            0227  LAST          000a  LF        
06bc  LOA0          06e4  LOA1          06b9  LOAD          0573  LODCM0    
0576  LODCM1        0595  LODCM2        05a0  LODCM3        05aa  LODCM4    
056a  LODCMD        05bb  LODEXT        029a  LRA           029d  LRA.      
022b  LST2          0234  MEMM          2008  MFLAG         00e6  MI.ANI    
0076  MI.HLT        00db  MI.IN         003a  MI.LDA        0011  MI.LXID   
00d3  MI.OUT        00c9  MI.RET        01a4  MTR           01a5  MTR1      
01c4  MTR4          01e8  MTR5          01f6  MTR6          01dc  MTRA      
0219  NEXT          000d  NEXTLOC       05dc  NULCMD        00f0  OP.CTL    
00f0  OP.DIG        00f1  OP.SEG        00f9  OP.TPC        00f8  OP.TPD    
0241  OUT           055c  OUTCMD        063b  OUTER         0009  PAMVER$   
0129  PCK           0178  PCK1          0146  PCKM          015e  PCKM1     
0174  PCKN          017b  PCKQ          016b  PCKR          2035  PCKTMP    
2034  PCKVAL        0186  PCKX          0170  PCKZ          00f0  PPI       
809e  PPS           009e  PPSROM        050b  PROMPT$       0007  PRSL      
2004  PRSRAM        03f9  PRSROM        04b8  PRTADR        04ec  PRTCLS    
0446  PRTERR        04c9  PRTHEX        04d2  PRTNIB        04dd  PRTSPC    
04ef  PRTSTR        0648  RCK           064f  RCK1          0661  RCK2      
2016  RCKA          200a  REFIND        2005  REGI          0203  REGM      
201d  REGPTR        0104  RFP           06b0  RMEM          07bf  RNB       
07c3  RNB1          07bb  RNP           044c  RUNCMD        0215  RW        
01f2  SAE           00d5  SAVALL        00fa  SC.UART       04fc  SIGNON$   
079b  SRS           079b  SRS1          079f  SRS2          025e  SST1      
0256  SSTEP         8000  STACK         2000  START         0265  STPRTN    
0776  TER1          0773  TER3          075d  TFT           201b  TICCNT    
078a  TPABT         076b  TPERR         2019  TPERRX        0790  TPXIT     
0010  UCI.ER        0002  UCI.IE        0040  UCI.IR        0004  UCI.RE    
0020  UCI.RO        0001  UCI.TE        0000  UDR           02e4  UFD       
030a  UFD1          0001  UI.CLK        201f  UIVEC         0002  UMI.16X   
0040  UMI.1B        0001  UMI.1X        00c0  UMI.2B        0003  UMI.64X   
0080  UMI.HB        0000  UMI.L5        0004  UMI.L6        0008  UMI.L7    
000c  UMI.L8        0010  UMI.PA        0020  UMI.PE        0002  UO.DDU    
0080  UO.HLT        0040  UO.NFR        0001  USR           0040  USR.BD    
86a0  USR.FE        0010  USR.OE        0008  USR.PE        0002  USR.RXR   
