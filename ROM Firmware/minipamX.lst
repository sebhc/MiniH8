0066  CI2           006e  CI3           0071  CI4           0087  CI5       
0099  CI6           046f  CIN           05e5  CINN1         05ef  CINN2     
05fb  CINN3         05dd  CINNE         005e  CINT          011a  CLK2      
011f  CLK3          00fd  CLOCK         0423  CMDLP         0435  CMDLP1    
05ca  CMDTAB        0608  CO1           060f  CO2           0600  COUT      
000d  CR            0688  CRC           068f  CRC1          06a5  CRC2      
2017  CRCSUM        04e2  CRLF          050d  CSERR$        05b5  CSUMER    
0760  CTC           0003  CTLC          2009  CTLFLG        0003  CTRL      
000a  DBDLY         2011  DLEDS         0053  DLY           0058  DLY2      
0639  DLYNOI        0000  DM.MR         0001  DM.MW         0002  DM.RR     
0003  DM.RW         04c8  DMPLOC        02c5  DOD           02ca  DOD1      
067e  DODA          0672  DSPA          2007  DSPMOD        2006  DSPROT    
0704  DUMP          0529  EDTCM1        0547  EDTCM2        0526  EDTCMD    
0513  ERR$          0443  ERRMSG        0192  ERROR         200b  FPLEDS    
201b  FPSHOW        0455  GETADR        0461  GETHE2        045e  GETHEX    
