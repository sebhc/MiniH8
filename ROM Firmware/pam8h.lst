0075  CUI1          2011  DLEDS         002b  DLY           0000  DM.MR     
0001  DM.MW         0002  DM.RR         0003  DM.RW         0352  DOD       
0357  DOD1          03ee  DODA          03e2  DSPA          2007  DSPMOD    
2006  DSPROT        0202  DUMP          00d2  ERROR         200b  FPLEDS    
0192  GO            0033  GO.           0260  HORN          0263  HRN0      
0270  HRN2          017f  IN            003b  INIT          0000  INIT0     
0047  INIT1         004f  INIT2         0008  INT1          0010  INT2      
0018  INT3          0020  INT4          0028  INT5          0030  INT6      
