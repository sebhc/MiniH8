                        ;
                        ;SM8085R1 -- GWMON-80 Small Monitor for 8085 SBC rev 1
                        ;
                        ;This customization uses the 8085's built-in serial I/O and
                        ;is configured for the Glitch Works 8085 SBC rev 1 memory
                        ;map. By Jon Chapman, Glitch Works.
                        ;
                        ;;Modified by Lee Hart for mini H8 - 9 Aug 2026
                        ;;double semicolons denote changes from Jon Chapman's code
                        ;;resume editing at ------------
                        ;;
                        ;; other double-semicolon edits by Glenn Roberts marked 'gfr'
                        
                        ;
                        ;Hardware Equates
                        ;
                        ;;Mini H8 memory map, 27C256 32k ROM, jumper P3 in ROM position
                        ;; ROM at 0-1FFFh, 8000-FFFF (0-1FFFh mirrors 8000-9FFFh)
                        ;; RAM at 2000-7FFFh
                        
                        ;; have begun adding some PAM-8 functionality. RAM starts at 2000
                        ;; the first 40h bytes are reserved for PAM use. User programs 
                        ;; may be ORGed at 2040h (040.100 in split octal notation) or above.
                        ;;		- gfr
                        ;;
                        
   201b                 TICCNT	equ	201BH		;; 2ms clock tick counter
                        
                        ;STACK	equ	0000H
   8000                 STACK	equ	8000H	;;Stack at top of RAM (or 8000h for mini H8) gfr
                        
   0000                 	ORG	0000H		;Reset jump to monitor, leave room for
   0000   c3 0c 01      	JMP	CSTART		;interrupt vectors.
                        ;;
                        ;;	room for interrupt vectors - gfr
                        ;;
                        
                        ;;	Interrupt handler for RST7.5 - gfr
                        ;;
                        ;;	This code is executed whenever a 2-millisecond
                        ;;	clock interrupt occurs.
                        ;;
                        ;;	currently just increments the TICCNT counter, however
                        ;;	this is also where other scheduled services can be handled
                        ;;	(e.g. 7-segment display update).
                        ;;
   003c                 	ORG	03CH
   003c   f5            INT7.5	PUSH	PSW
   003d   c5            	PUSH	B
   003e   d5            	PUSH	D
   003f   e5            	PUSH	H
                        
                        ;; update the tick count
                        	
   0040   2a 1b 20      	LHLD	TICCNT
   0043   23            	INX	H
   0044   22 1b 20      	SHLD	TICCNT
                        	
   0047   e1            	POP	H
   0048   d1            	POP	D
   0049   c1            	POP	B
   004a   f1            	POP	PSW
                        	
   004b   fb            	EI
   004c   c9            	RET
                        	
                        
                        	
   0100                 	ORG	0100H		;Actual start of monitor
                        
                        ;;	INCLUDE	'vectors.inc'	;Standard GWMON-80 jump table
                        ;;	(included inline)
   0100   c3 0c 01      JMPTAB:	JMP	CSTART	;Cold start, initializes hardware
   0103   c3 24 01      	JMP	WSTART		;Warm start
   0106   c3 0c 03      	JMP	COUT		;Output A register to console
   0109   c3 73 01      	JMP	CIN			;Input A register from console, waits
   010c                 CSTART:	
                        					;;end of INCLUDE 'vectors.inc'
                        					
                        ;;	INCLUDE	'sm.inc' ;The small monitor (included inline)
                        ;
                        ;SM -- GWMON-80 Small Monitor
                        ;
                        ;This is the small monitor for GWMON-80. It includes the
                        ;small command processor and common monitor routines.
                        ;
                        ;Small Monitor Equates
                        ;
   7ffd                 DYNIN	equ	STACK-3
   7ffa                 DYNOUT	equ	STACK-6
                        
                        ;
                        ;SMSTRT -- SM cold start routine
                        ;
                        ;; after this code the following is installed just above the STACK:
                        ;;
                        ;;	DYNOUT	OUT xx
                        ;;		RET
                        ;;	DYNIN	IN xx
                        ;;		RET
                        ;; the 'xx' values are port numbers filled in dynamically by
                        ;; INPCMD and OUTCMD
                        ;;			- gfr
                        ;;
   010c   31 00 80      SMSTRT:	LXI	SP, STACK	;Set up stack pointer
   010f   21 d3 c9      	LXI	H, 0C9D3H	;; OUT and RET
   0112   e5            	PUSH	H
   0113   11 c9 db      	LXI	D, 0DBC9H	;; RET and IN
   0116   d5            	PUSH	D
   0117   e5            	PUSH	H		;; OUT and RET
                        
   0118   cd ca 02      	CALL	IOSET		;Do I/O module setup
   011b   cd ce 02      	CALL	IRQSET		;; initialize interrupts - gfr
   011e   21 00 02      	LXI	H, SIGNON$	;SM signon
   0121   cd f0 01      	CALL	PRTCLS
                        
                        ;
                        ;WSTART -- Warm start routine
                        ;
                        ;Falls through to the command processor.
                        ;
   0124   31 fa 7f      WSTART: LXI	SP,STACK-6	;Reload stack pointer
                        				;don't clobber dynamic IN/OUT area
                        
                        ;;	INCLUDE	'scp.inc'	; (included inline)
                        ;
                        ;SCP -- GWMON-80 Small Command Processor
                        ;
                        ;This is the small command processor for Glitch Works
                        ;Monitor for 8080/8085/Z80 and compatible.
                        ;
                        
                        ;
                        ;CMDLP -- Small command processor loop
                        ;
                        ;Get a character from the console device and immediately 
                        ;handle it by passing off to helper function.
                        ;
                        ;Falls through to ERROR if an invalid command is specified.
                        ;
   0127   21 24 01      CMDLP:	LXI	H, WSTART	;HL = warm start address
   012a   e5            	PUSH	H		;Prime stack for RET
   012b   21 0f 02      	LXI	H, PROMPT$
   012e   cd f0 01      	CALL	PRTCLS
   0131   cd 73 01      	CALL	CIN
   0134   f6 20         	ORI	20H		;allow lowercase input
                        
   0136   21 b6 02      	LXI	H,CMDTAB-1
   0139   23            CMDLP1:	INX	H		;Point to next command char
   013a   be            	CMP	M
   013b   ca 50 01      	JZ	RUNCMD		;Match, run command handler
   013e   47            	MOV	B,A
   013f   7e            	MOV	A,M
   0140   b7            	ORA	A
   0141   78            	MOV	A,B
   0142   23            	INX	H		;Get past handler address
   0143   23            	INX	H
   0144   c2 39 01      	JNZ	CMDLP1
                        
                        ;
                        ;ERROR -- Print generic error message and abort
                        ;
                        ;Falls through to PRTERR.
                        ;
   0147   21 17 02      ERROR:	LXI	H,ERR$		;Fall through to PRTERR
                        
                        ;
                        ;PRTERR -- Print a null-terminated error string
                        ;
                        ;entry: HL contains pointer to start of null-terminated string
                        ;exit: string at HL printed to console
                        ;exit: program execution returned to command loop
                        ;
   014a   cd f0 01      PRTERR:	CALL	PRTCLS
   014d   c3 24 01      	JMP	WSTART		;Warm start, restore SP
                        
                        ;
                        ;RUNCMD -- Run a command handler from CMDTAB
                        ;
                        ;entry: H register points to command letter
                        ;exit: control transferred to command handler
                        ;
   0150   cd e1 01      RUNCMD:	CALL	PRTSPC
   0153   23            	INX	H		;Point to low handler address
   0154   5e            	MOV	E,M
   0155   23            	INX	H
   0156   56            	MOV	D,M
   0157   eb            	XCHG
   0158   e9            	PCHL
                        
                        ;
                        ;GETADR -- Get a 16-bit address from the console
                        ;
                        ;pre: none
                        ;post: HL contains address from console
                        ;
   0159   cd 62 01      GETADR:	CALL	GETHEX
   015c   67            	MOV	H,A
   015d   cd 62 01      	CALL	GETHEX
   0160   6f            	MOV	L,A
   0161   c9            	RET
                        
                        ;
                        ;GETHEX -- Get byte from console as hex
                        ;
                        ;Enter at GETHE2 with character in A register from EDTCMD.
                        ;
                        ;entry: none
                        ;exit: A register contains byte from hex input
                        ;exit: Carry flag set if non-hex character received
                        ;
   0162   cd 73 01      GETHEX:	CALL	CIN
   0165   e5            GETHE2:	PUSH	H
   0166   67            	MOV	H,A
   0167   cd 73 01      	CALL	CIN
   016a   6f            	MOV	L,A
   016b   cd 79 01      	CALL	HEXBYT
   016e   e1            	POP	H
   016f   da 47 01      	JC	ERROR		;Invalid hex char, abort
   0172   c9            	RET
                        ;;end of INCLUDE 'SCP.INC'
                        					
                        ;;	INCLUDE	'common.inc' (included inline)
                        ;
                        ;COMMON -- Functions Common to SM and XM
                        ;
                        ;These functions are used by both the SM and XM versions
                        ;of GWMON-80.
                        ;
                        
                        ;
                        ;ASCII Equates
                        ;
   0003                 CTLC	equ	03
   0008                 BS	equ	08
   000a                 LF	equ	10
   000d                 CR	equ	13
                        
   0003                 CANCEL	equ	CTLC		;Escape/cancel character, CTRL+C
   000d                 NEXTLOC	equ	CR		;Keystroke for next location in E
                        				;defaults to CR
                        
                        ;
                        ;CIN -- Get a char from the console and echo
                        ;
                        ;Returns through COUT.
                        ;
                        ;entry: console device is initialized
                        ; exit: received char is in A register
                        ;		received char is echoed
                        ;
   0173   cd d3 02      CIN:	CALL	CINNE
   0176   c3 0c 03      	JMP	COUT
                        
                        ;
                        ;HEXBYT -- Convert pair of ASCII characters to byte
                        ;
                        ;entry: H register contains high ASCII coded hex nybble
                        ;		L register contains low ASCII coded hex nybble
                        ; exit: A register contains converted byte
                        ;		CY flag set if non-hex character input
                        ;		Z flag set if conversion results in 0x00
                        ;
   0179   7c            HEXBYT:	MOV	A,H
   017a   cd 8a 01      	CALL	ASCHEX
   017d   d8            	RC
   017e   07            	RLC
   017f   07            	RLC
   0180   07            	RLC
   0181   07            	RLC
   0182   67            	MOV	H,A
   0183   7d            	MOV	A,L
   0184   cd 8a 01      	CALL	ASCHEX
   0187   d8            	RC
   0188   b4            	ORA	H
   0189   c9            	RET
                        
                        ;
                        ;ASCHEX -- Convert ASCII character to hex nybble
                        ;
                        ;entry: A register contains ASCII coded nybble
                        ; exit: A register contains nybble
                        ;		CY flag set if ASCII character is invalid hex
                        ;
   018a   d6 30         ASCHEX:	SUI	'0'		;ASCII to decimal bias
   018c   d8            	RC			;Return if less than '0'
   018d   fe 0a         	CPI	0AH
   018f   3f            	CMC			;Clear CY
   0190   f8            	RM			;0x0 - 0x9, done
   0191   e6 5f         	ANI	5FH		;Upcase
   0193   d6 07         	SUI	07H		;ASCII to hex bias
   0195   fe 10         	CPI	10H
   0197   3f            	CMC			;Set CY if > 'F'
   0198   c9            	RET
                        
                        ;
                        ;HEXDMP -- Hex dump memory to console
                        ;
                        ;This routine prints the contents of memory starting at HL
                        ;and ending at DE in 16-byte blocks.
                        ;
                        ;entry: HL register pair contains starting address
                        ;		DE register pair contains ending address
                        ; exit:	contents of memory printed to console
                        ;
   0199   06 00         HEXDMP:	MVI	B,0		;Initialize B as completion flag
                        
   019b   cd bc 01      HEXDM1:	CALL	PRTADR
   019e   0e 10         	MVI	C,16		;C = line loop counter
   01a0   cd e1 01      HEXDM2:	CALL	PRTSPC
   01a3   cd cc 01      	CALL	DMPLOC
   01a6   7b            	MOV	A,E		;A = low byte of end address
   01a7   bd            	CMP	L		;Compare current low byte
   01a8   c2 b1 01      	JNZ	HEXDM3
   01ab   7a            	MOV	A,D		;A = high byte of end address
   01ac   bc            	CMP	H		;Compare current high byte
   01ad   c2 b1 01      	JNZ	HEXDM3
   01b0   05            	DCR	B		;B = nonzero, done
                        
   01b1   23            HEXDM3:	INX	H		;Increment current address pointer
   01b2   0d            	DCR	C
   01b3   c2 a0 01      	JNZ	HEXDM2		;Print more lines
                        
   01b6   78            	MOV	A,B
   01b7   b7            	ORA	A
   01b8   ca 9b 01      	JZ	HEXDM1		;Yes, dump more memory
   01bb   c9            	RET			;No, done
                        
                        ;
                        ;PRTADR -- Print an address to the console
                        ;
                        ;Prints CR, LF, a 16-bit address, a space, and a colon. 
                        ;Destroys A register contents.
                        ;
                        ;Returns through COUT.
                        ;
                        ;entry: HL pair contains address to print
                        ; exit: HL printed to console as hex
                        ;
   01bc   cd e6 01      PRTADR: CALL	CRLF
   01bf   7c            	MOV	A,H
   01c0   cd cd 01      	CALL	PRTHEX
   01c3   7d            	MOV	A,L
   01c4   cd cd 01      	CALL	PRTHEX
   01c7   3e 3a         	MVI	A,':'
   01c9   c3 0c 03      	JMP	COUT
                        
                        ;
                        ;DMPLOC -- Print a byte at HL to console
                        ;
                        ;Falls through to PRTHEX.
                        ;
                        ;pre: HL pair contains address of byte
                        ;post: byte at HL printed to console
                        ;
   01cc   7e            DMPLOC:	MOV	A,M
                        
                        ;
                        ;PRTHEX -- Output byte to console as hex
                        ;
                        ;Falls through to PRTNIB.
                        ;
                        ;entry: A register contains byte to be output
                        ; exit: byte is output to console as hex
                        ;
   01cd   f5            PRTHEX: PUSH	PSW		;Save A register on stack
   01ce   0f            	RRC			;Rotate high nybble down
   01cf   0f            	RRC
   01d0   0f            	RRC
   01d1   0f            	RRC
   01d2   cd d6 01      	CALL	PRTNIB		;Print high nybble
   01d5   f1            	POP	PSW		;Restore A register
                        
                        ;
                        ;PRTNIB -- Print hex nybble on console
                        ;
                        ;Returns through COUT.
                        ;
                        ;entry: A register contains nybble
                        ; exit: nybble printed to console
                        ;
   01d6   e6 0f         PRTNIB:	ANI	0FH		;Mask off low nybble
   01d8   c6 90         	ADI	90H
   01da   27            	DAA
   01db   ce 40         	ACI	40H
   01dd   27            	DAA
   01de   c3 0c 03      	JMP	COUT
                        
                        ;
                        ;PRTSPC -- Print a space to the console
                        ;
                        ;Returns through COUT.
                        ;
                        ;pre: none
                        ;post: ASCII space printed to console
                        ;
   01e1   3e 20         PRTSPC:	MVI	A,' '
   01e3   c3 0c 03      	JMP	COUT
                        
                        ;
                        ;CRLF -- Print a CR, LF
                        ;
                        ;Returns through COUT.
                        ;
                        ;entry: none
                        ; exit: CR, LF printed to console
                        ;
   01e6   3e 0d         CRLF:	MVI	A,CR
   01e8   cd 0c 03      	CALL	COUT
   01eb   3e 0a         	MVI	A,LF
   01ed   c3 0c 03      	JMP	COUT
                        ;
                        ;PRTCLS -- Print CR, LF, and a high bit terminated string
                        ;
                        ;Falls through to PRTSTR
                        ;
                        ;entry: HL contains pointer to start of string
                        ; exit: CR, LF, and string at HL printed to console
                        ;
   01f0   cd e6 01      PRTCLS:	CALL	CRLF
                        
                        ;
                        ;PRTSTR -- Print a high bit terminated string
                        ;
                        ;Destroys contents of A register.
                        ;
                        ;entry: HL contains pointer to start of string
                        ; exit: string at HL printed to console
                        ;
   01f3   7e            PRTSTR:	MOV	A, M
   01f4   e6 7f         	ANI	07FH		;Strip high bit
   01f6   cd 0c 03      	CALL	COUT
   01f9   7e            	MOV	A,M
   01fa   b7            	ORA	A		;Set flags
   01fb   f8            	RM			;High bit set, done
   01fc   23            	INX	H
   01fd   c3 f3 01      	JMP	PRTSTR
                        ;;end of INCLUDE 'common.inc'
                        
                        ;; ---------------------
                        ;;
                        ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        ;Small Monitor Strings
                        ;
                        ;These strings are terminated by setting the high bit in the
                        ;last character.
                        ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   0200   47 57 4d 4f   SIGNON$:	db 'GWMON-80 1.1 S', 'M' + 80H
   0204   4e 2d 38 30   
   0208   20 31 2e 31   
   020c   20 53 cd      
   020f   0a be         PROMPT$:	db LF, '>' + 80H
   0211   43 4b 53 55   CSERR$:		db 'CKSUM '
   0215   4d 20         
   0217   45 52 52 4f   ERR$:		db 'ERRO', 'R' + 80H
   021b   d2            
                        
                        ;;end of INCLUDE 'sm.inc'
                        
                        ;;	INCLUDE	'scmdstd.inc'	;SM standard commands
                        ;
                        ;SCMDSTD -- Small Monitor Standard Commands
                        ;
                        ;This file contains implementations of all standard SM
                        ;commands. The command table is located at the end of the
                        ;file.
                        ;
                        
                        ;
                        ;HDCMD -- Hex dump command
                        ;
   021c   cd 59 01      HDCMD:	CALL	GETADR		;HL = start address
   021f   eb            	XCHG			;DE = start address
   0220   cd e1 01      	CALL	PRTSPC
   0223   cd 59 01      	CALL	GETADR		;HL = end address
   0226   eb            	XCHG			;HL = start, DE = end
   0227   c3 99 01      	JMP	HEXDMP		;Return through HEXDMP
                        
                        ;
                        ;EDTCMD -- Edit memory command
                        ;
                        ;Breaks out to main command loop through GETHEX jump to
                        ;WSTART.
                        ;
   022a   cd 59 01      EDTCMD:	CALL	GETADR		;HL = address to open
   022d   cd bc 01      EDTCM1:	CALL	PRTADR		;Print location address
   0230   cd e1 01      	CALL	PRTSPC
   0233   cd cc 01      	CALL	DMPLOC		;Print contents of location
   0236   cd e1 01      	CALL	PRTSPC
   0239   cd 73 01      	CALL	CIN		;Get user input
   023c   fe 0d         	CPI	NEXTLOC		;Check for NEXTLOC character
   023e   ca 4b 02      	JZ	EDTCM2		;Yes, go to next location
   0241   cd 65 01      	CALL	GETHE2		;No, process as hex input
   0244   77            	MOV	M,A
   0245   cd e1 01      	CALL	PRTSPC
   0248   cd cc 01      	CALL	DMPLOC		;Print contents of location (verification)
   024b   23            EDTCM2:	INX	H
   024c   c3 2d 02      	JMP	EDTCM1
                        
                        ;
                        ;GOCMD -- Call out to a specified address
                        ;
                        ;The stack is primed with the GWMON-80 warm start address.
                        ;Called program can return control to GWMON-80 through a RET
                        ;as long as the stack is not disturbed.
                        ;
   024f   cd 59 01      GOCMD:	CALL	GETADR		;HL = Address to call
   0252   e9            	PCHL			;Go to specified address
                        
                        ;
                        ;INPCMD -- Input to port command
                        ;
                        ;Returns through PRTHEX.
                        ;
                        ;entry: DYNIN memory area has been initialized
                        ; exit: byte from specififed port printed to console
                        ;
   0253   cd 62 01      INPCMD:	CALL	GETHEX
   0256   32 fe 7f      	STA	DYNIN+1		;Store operand
   0259   cd e1 01      	CALL	PRTSPC
   025c   cd fd 7f      	CALL	DYNIN
   025f   c3 cd 01      	JMP	PRTHEX
                        
                        ;
                        ;LODCMD -- Load an Intel HEX file from console
                        ;
                        ;This loader accepts data with both CR (*NIX) and
                        ;CR,LF (DOS/Windows) terminated lines.
                        ;
                        ;Intel HEX record may be ended with:
                        ;   * DATA (0x00) record with length of 0
                        ;   * Any nonzero record type
                        ;
                        ; exit: Intel HEX file loaded, or error printed
                        ;
   0262   cd e6 01      LODCMD:	CALL	CRLF
   0265   cd d3 02      LODCM1:	CALL	CINNE
   0268   fe 3a         	CPI	':'
   026a   c2 65 02      	JNZ	LODCM1		;Wait for start colon
   026d   cd 0c 03      	CALL	COUT		;Print start colon
   0270   cd 62 01      	CALL	GETHEX		;Get record length
   0273   ca 99 02      	JZ	LODCM4		;Length == 0, done
   0276   47            	MOV	B,A		;Record length in B
   0277   4f            	MOV	C,A		;Start checksumming in C
                        
   0278   cd 59 01      	CALL	GETADR		;HL = 16-bit starting address
   027b   81            	ADD	C		;A == L from GETADR
   027c   84            	ADD	H
   027d   4f            	MOV	C,A		;Checksum
                        
   027e   cd 62 01      	CALL	GETHEX		;Get record type
   0281   c2 99 02      	JNZ	LODCM4		;Not Record Type 00 (DATA), done
                        
   0284   cd 62 01      LODCM2:	CALL	GETHEX		;This is the main record processing loop
   0287   77            	MOV	M,A		;Store char at HL
   0288   81            	ADD	C
   0289   4f            	MOV	C,A		;Checksum
   028a   23            	INX	H		;Move memory pointer up
   028b   05            	DCR	B
   028c   c2 84 02      	JNZ	LODCM2		;Not done with the line
   028f   cd 62 01      LODCM3:	CALL	GETHEX		;Get checksum byte
   0292   81            	ADD	C
   0293   c2 a2 02      	JNZ	CSUMER		;Checksum bad, print error
   0296   c3 62 02      	JMP	LODCMD		;Process more records
   0299   cd 73 01      LODCM4:	CALL	CIN		;Done getting data, eat chars
   029c   fe 0a         	CPI	LF
   029e   c2 99 02      	JNZ	LODCM4		;No LF, keep eating
   02a1   c9            	RET			;Got LF, return to command loop
   02a2   21 11 02      CSUMER:	LXI	H,CSERR$	;Print checksum error to console
   02a5   c3 4a 01      	JMP	PRTERR		;RET from ERROUT will return to command loop
                        
                        ;
                        ;OUTCMD -- Output to port command
                        ;
                        ;Returns through DYNOUT.
                        ;
                        ;entry: DYNOUT memory area has been initialized
                        ; exit: specified byte has been written to specified port
                        ;
   02a8   cd 62 01      OUTCMD:	CALL	GETHEX
   02ab   32 fb 7f      	STA	DYNOUT+1	;Store operand
   02ae   cd e1 01      	CALL	PRTSPC
   02b1   cd 62 01      	CALL	GETHEX
   02b4   c3 fa 7f      	JMP	DYNOUT
                        
                        ;
                        ;CMDTAB -- Table/array of commands
                        ;
                        ;This data *must* be the last item in SCMDSTD.INC to allow
                        ;chaining of additional command tables.
                        ;
                        ;Table entry structure:
                        ;    * Single command character, lowercase only
                        ;    * Pointer to implementation routine
                        ;
                        ;The last entry should contain 0x00 for the command char and
                        ;no additional address. It is provided in SCMDNULL.INC
                        ;
   02b7   64            CMDTAB:	db	'd'
   02b8   1c 02         	dw	HDCMD
   02ba   65            	db	'e'
   02bb   2a 02         	dw	EDTCMD
   02bd   67            	db	'g'
   02be   4f 02         	dw	GOCMD
   02c0   69            	db	'i'
   02c1   53 02         	dw	INPCMD
   02c3   6c            	db	'l'
   02c4   62 02         	dw	LODCMD
   02c6   6f            	db	'o'
   02c7   a8 02         	dw	OUTCMD
                        
                        ;;end of INCLUDE 'scmdstd.inc'
                        
                        ;;	INCLUDE	'scmdnull.inc'	;Command table terminator
                        ;
                        ;SCMDNULL -- SM NULL Command
                        ;
                        ;This should be the last command list included in a SM
                        ;customization. It provides consistent termination to the
                        ;command list.
                        ;
   02c9   00            NULCMD:	db	0
                        				;;end of INCLUDE 'scmdnull.inc'
                        ;;---------------
                        ;;	INCLUDE	'8085sio1.inc'	;Intel 8085 SID/SOD driver
                        ;
                        ;8085SIO1 -- Console I/O Drivers for 8085 Built-In Serial
                        ;
                        ;Use the SID and SOD pins on the Intel 8085 for bit-bang
                        ;serial I/O. This driver uses fixed bitrate constants for 
                        ;delay routines used to pace serial transmit/receive.
                        ;
                        ;Derived from Intel Application Note AP-29, August 1977.
                        ;
                        ;; mini H8 uses 4MHz crystal, so BITTIME and HALFBIT change.
                        
                        ;BITTIME	equ	0112H		;9600 BPS with 6.144 MHz crystal
                        ;HALFBIT	equ	0109H		;Half-bit time
                        
                        ;; Using Intel Application Note AP-29 the following are computed for
                        ;; 9600 BPS with 4.0 MHz crystal - gfr
                        ;;
                        ;BITTIME	equ	010AH		;9600 BPS with 4.0 MHz crystal
                        ;HALFBIT	equ	0106H		;Half-bit time
                        
                        ;; below for 2400 baud - gfr 
                        
   0137                 BITTIME	equ	0137H		;2400 BPS with 4.0 MHz crystal
   011c                 HALFBIT	equ	011CH		;Half-bit time
                        ;
                        ;SETUP -- Prepare the system for running the monitor
                        ;
                        ;Output a NUL to clear the line after a reset. Returns
                        ;through COUT.
                        ;
                        ;entry: none
                        ; exit: console ready for I/O
                        ;
   02ca   af            IOSET:	XRA	A		;NUL in A
   02cb   c3 0c 03      	JMP	COUT		;Clear the line
                        
                        ;; IRQSET - set up interrupt vectors - gfr
                        ;;
   02ce   3e 0b         IRQSET:	MVI	A,00001011b	;; bit 2 unmask only RST 7.5)
   02d0   30            	SIM			;; apply the mask
   02d1   fb            	EI			;; globally enable interrupts
   02d2   c9            	RET
                        	
                        ;
                        ;CINNE -- Get a char from the console, no echo
                        ;
                        ;entry: BITTIME, HALFBIT are initialized
                        ; exit: received char is in A register
                        ;
                        ;; on mini H8 the serial line is LOW in idle state. start bit
                        ;; indicated by low-to-high transition - gfr
                        
   02d3   c5            CINNE:	PUSH	B		;Preserve registers
   02d4   e5            	PUSH	H
   02d5   f3            	DI			;Must disable interrupts
   02d6   06 09         	MVI	B,9		;Receive bits counter
                        
   02d8   20            CI1:	RIM			;Check for start bit
   02d9   e6 80         	ANI	080h		;; look only at bit seven - gfr
   02db   ca d8 02      	JZ	CI1		;; no start bit seen yet - gfr
                        ;	JM	CI1		;; No start bit, wait (invert for mini H8)
                        
   02de   21 1c 01      	LXI	H,HALFBIT	;Delay one half-bit time, this puts
   02e1   2d            CI2:	DCR	L		;us in the middle of the start bit
   02e2   c2 e1 02      	JNZ	CI2
   02e5   25            	DCR	H
   02e6   c2 e1 02      	JNZ	CI2
                        ;;
                        ;;	Now start reading the byte - gfr
                        ;;
   02e9   21 37 01      CI3:	LXI	H,BITTIME	;Delay one bit-time, since we are shifted
   02ec   2d            CI4:	DCR	L		;a half-bit time through the start bit, this
   02ed   c2 ec 02      	JNZ	CI4		;will keep us in the middle of bits for
   02f0   25            	DCR	H		;reliable sampling.
   02f1   c2 ec 02      	JNZ	CI4
                        
   02f4   20            	RIM			;Read the SID line
   02f5   2f            	CMA			;; invert for mini H8 - gfr
   02f6   17            	RAL			;;CY = data bit (invert for mini H8)
   02f7   05            	DCR	B		;Determine if this is a stop bit
   02f8   ca 02 03      	JZ	CI5		;;Stop bit, done with char receive (invert H8)
                        
   02fb   79            	MOV	A,C		;Not done, rotate a bit in CY into C
   02fc   1f            	RAR
   02fd   4f            	MOV	C,A
   02fe   00            	NOP			;Equalize COUT and CINNE loop times
   02ff   c3 e9 02      	JMP	CI3		;Get more bits
                        
   0302   e1            CI5:	POP	H		;Restore HL
   0303   79            	MOV	A,C		;A = received character
   0304   c1            	POP	B		;Restore BC
   0305   fb            	EI
   0306   fe 03         	CPI	CANCEL		;Check for CANCEL character
   0308   ca 24 01      	JZ	WSTART		;Yes, warm start monitor
   030b   c9            	RET
                        
                        ;
                        ;COUT -- Output a character to the console
                        ;
                        ;This routine *must* preserve the contents of the A register
                        ;or CIN will not function properly.
                        ;
                        ;Interrupts are disabled to maintain critical timing in this
                        ;routine. They are unconditionally re-enabled before return.
                        ;
                        ;entry: A register contains char to be printed
                        ;		BITTIME, HALFBIT are initialized
                        ; exit: character is printed to the console
                        ;		interrupts are enabled
                        ;
   030c   f5            COUT:	PUSH	PSW		;Preserve char in A
   030d   c5            	PUSH	B		;Preserve registers
   030e   e5            	PUSH	H
   030f   f3            	DI			;Must disable interrupts
   0310   4f            	MOV	C,A		;C = character to output
   0311   af            	XRA	A		;Clear CY
   0312   06 0a         	MVI	B,10		;Bit count for entire serial transaction (10 - gfr)
                        
   0314   3e 80         CO1:	MVI	A,80H		;Set what will become SOD enable bit
   0316   1f            	RAR			;Move CY into SOD data bit
   0317   30            	SIM			;Output it on SOD
   0318   21 37 01      	LXI	H,BITTIME	;Delay one bit time
   031b   2d            CO2:	DCR	L
   031c   c2 1b 03      	JNZ	CO2
   031f   25            	DCR	H
   0320   c2 1b 03      	JNZ	CO2
                        
   0323   37            	STC			;Set CY, will become stop bit	
   0324   79            	MOV	A,C		
   0325   1f            	RAR			;Get a bit from the byte to output into CY
   0326   4f            	MOV	C,A
   0327   05            	DCR	B		;Decrement bit count
   0328   c2 14 03      	JNZ	CO1		;Not done, send more bits
                        		
   032b   e1            	POP	H		;Restore registers
   032c   c1            	POP	B
   032d   fb            	EI
                        
   032e   f1            	POP	PSW		;A = char printed
   032f   c9            	RET
                        ;;			;;end of INCLUDE '8085sio1.inc'
   0330                 	END
018a  ASCHEX        0137  BITTIME       0008  BS            0003  CANCEL    
02d8  CI1           02e1  CI2           02e9  CI3           02ec  CI4       
0302  CI5           0173  CIN           02d3  CINNE         0127  CMDLP     
