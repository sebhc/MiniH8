                        ; =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
                        ;
                        ;	This is a modified version of PAM/8, originally written by Gordon
                        ;	Letwin 50 years ago! This version is designed to support Lee Hart's
                        ;	"H8 Mini", which incorporates some hardware modifications to simplify
                        ;	the design and allow it to run on single-board 8085-based computer
                        ;	approximately 3" x 6" in size. This code uses 8085-specific instructions,
                        ;	and for timing purposes assumes a 2Mhz CPU clock rate (4Mhz resonator).
                        ;
                        ;	A modified version of Jon Chapman's Glitch Works Monitor GWMON-80
                        ;	has been added to support a console monitor, serial I/O routines, and
                        ;	an ability to load Intel Hex files.
                        ;
                        ;	As with the original PAM/8 this consists of a set of interrupt-time and
                        ;	task-time routines. The interrupt-time routines service the front
                        ;	panel (7-segment LEDs and keypad). There are two options for task-time
                        ;	processing: 1) the front panel or 2) the GWMON console.
                        ;
                        ;	Key changes over PAM/8:
                        ;	- IRQ handling limited to the 3 hardware interrupts on the
                        ;	  H8 Mini: 2ms Clock, RTM/0 and Serial start.
                        ;	- LOAD and DUMP to use the serial I/O port to load .H8T files
                        ;
                        ;	Modified from original Heath-compatible assembly code by Herb Johnson (HRJ)
                        ;	for use with the A85 assembler, 25 July, 2026.
                        ;
                        ;	Other modifications/enhancements by Glenn Roberts (GFR),
                        ;	Augutst-September, 2026.
                        ;
                        ; =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
                        ;
                        ;	Original comments from Gordon Letwin below (some no longer apply due
                        ;	to hardware differences between the original H8 and the H8 Mini):
                        ;
                        ;	PAM/8 - H8 FRONT PANEL MONITOR
                        ;
                        ;	JGL, 05/01/76.
                        ;
                        ;	FOR *WINTEK* INC.
                        ;
                        ;	COPYRIGHT  05/1976, WINTEK CORPORATION
                        ;	902 N. 9TH ST.
                        ;	LAFAYETTE, IND.
                        
                        ;	PAM/8 - H8 FRONT PANEL MONITOR
                        ;
                        ;	THIS PROGRAM RESIDES (IN ROM) IN THE LOW 1024 BYTES OF THE HEATH
                        ;	H8 COMPUTER. IT ACTUALLY CONSISTS OF TWO VIRTUALLY INDEPENDENT
                        ;	ROUTINES: A TASK-TIME PROGRAM WHICH PROVIDES SOPHISTICATED
                        ;	FRONT PANEL MONITOR SERVICE, AND AN INTERRUPT-TIME PROGRAM WHICH
                        ;	PROVIDES BOTH A REAL-TIME CLOCK AND EMULATES AN EFFECTIVE
                        ;	HARDWARE FRONT PANEL.
                        
                        ;	INTERRUPTS.
                        ;
                        ;	PAM/8 IS THE PRIMARY PROCESSOR FOR ALL INTERRUPTS.
                        ;	THEY ARE PROCESSED AS FOLLOWS:
                        ;
                        ;	RST	USE
                        ;
                        ;	0	MASTER CLEAR. (NEVER USES FOR I/O OR RESET)
                        ;
                        ;	1	CLOCK INTERRUPT. NORMALLY TAKEN BY PAM/8.
                        ;		SETTING BIT *U0.CLK* IN BYTE *MFLAG* ALLOWS
                        ;		USER PROCESSING (VIA A JUMP THROUGH *UIVEC*).
                        ;		UPON ENTRY OF THE USER ROUTINE, THE STACK
                        ;		CONTAINS:
                        ;		(STACK+0)  = RETURN ADDRESS (TO PAM/8)
                        ;		(STACK+2)  = (STACKPTR+4)
                        ;		(STACK+4)  = (AF)
                        ;		(STACK+6)  = (BC)
                        ;		(STACK+8)  = (DE)
                        ;		(STACK+10) = (HL)
                        ;		(STACK+12) = (PC)
                        ;		THE USER'S ROUTINE SHOULD RETURN TO PAM/8 VIA
                        ;		A *RET* WITHOUT ENABLING INTERRUPTS.
                        ;
                        ;	2	SINGLE STEP. SINGLE STEP INTERRUPTS GENERATED
                        ;		BY PAM/8 ARE PROCESSED BY PAM/8.
                        ;		ANY SINGLE STEP INTERRUPT RECEIVED WHEN IN
                        ;		USER MODE CAUSES A JUMP THROUGH *UIVEC*+3.
                        ;		STACK UPON USER ROUTINE ENTRY;
                        ;		(STACK+0)  = (STACKPTR+12)
                        ;		(STACK+2)  = (AF)
                        ;		(STACK+4)  = (BC)
                        ;		(STACK+6)  = (DE)
                        ;		(STACK+8)  = (HL)
                        ;		(STACK+10) = (PC)
                        ;		THE USER'S ROUTINE SHOULD HANDLE ITS OWN RETURN
                        ;		FROM THE INTERRUPT.
                        ;
                        ;
                        ;	THE FOLLOWING INTERRUPTS ARE VECTORED DIRECTLY THROUGH *UIVEC*.
                        ;	THE USER ROUTINE MUST HAVE SETUP A JUMP IN *UIVEC* BEFORE ANY
                        ;	OF THESE INTERRUPTS MAY OCCUR.
                        ;
                        ;	3	I/O 3. CAUSES A DIRECT JUMP THROUGH *UIVEC*+6
                        ;
                        ;	4	I/O 4. CAUSES A DIRECT JUMP THROUGH *UIVEC*+9
                        ;
                        ;	5	I/O 5. CAUSES A DIRECT JUMP THROUGH *UIVEC*+12
                        ;
                        ;	6	I/O 6. CAUSES A DIRECT JUMP THROUGH *UIVEC*+15
                        ;
                        ;	7	I/O 7. CAUSES A DIRECT JUMP THROUGH *UIVEC*+18
                        
                        
                        ;		ASSEMBLY CONSTANTS
                        
                        ;		I/O PORTS
                        
   00f0                 IP.PAD	EQU	360Q		; PAD INPUT PORT
   00f0                 OP.CTL	EQU	360Q		; CONTROL OUTPUT PORT
   00f0                 OP.DIG	EQU	360Q		; DIGIT SELECT OUTPUT PORT
   00f1                 OP.SEG	EQU	361Q		; SEGMENT SELECT OUTPUT PORT
   00f9                 IP.TPC	EQU	371Q		; TAPE CONTROL IN
   00f9                 OP.TPC	EQU	371Q		; TAPE CONTROL OUT
   00f8                 IP.TPD	EQU	370Q		; TAPE DATA IN
   00f8                 OP.TPD	EQU	370Q		; TAPE DATA OUT
                        
                        ;		ASCII CHARACTERS.
                        
   0016                 A.SYN	EQU	026Q		; SYNC CHARACTER
   0002                 A.STX	EQU	002Q		; STX CHARACTER
                        
                        ;		FRONT PANEL HARDWARE CONTROL BITS.
                        
   0010                 CB.SSI	EQU	00010000B	; SINGLE STEP INTERRUPT
   0020                 CB.MTL	EQU	00100000B	; MONITOR LIGHT
   0040                 CB.CLI	EQU	01000000B	; CLOCK INTERRUPT ENABLE
   0080                 CB.SPK	EQU	10000000B	; SPEAKER ENABLE
                        
                        ;		DISPLAY MODE FLAGS (IN *DSPMOD*)
                        
   0000                 DM.MR	EQU	0		; MEMORY READ
   0001                 DM.MW	EQU	1		; MEMORY WRITE
   0002                 DM.RR	EQU	2		; REGISTER READ
   0003                 DM.RW	EQU	3		; REGISTER WRITE
                        
                        ;		MACHINE INSTRUCTIONS.
                        
   0076                 MI.HLT	EQU	01110110B	; HALT
   00c9                 MI.RET	EQU	11001001B	; RETURN
   00db                 MI.IN	EQU	11011011B	; INPUT
   00d3                 MI.OUT	EQU	11010011B	; OUTPUT
   003a                 MI.LDA	EQU	00111010B	; LDA
   00e6                 MI.ANI	EQU	11100110B	; ANI
   0011                 MI.LXID EQU	00010001B	; LXI D
                        
                        ;		USER OPTION BITS.
                        ;
                        ;		THESE BITS ARE SET IN CELL MFLAG.
                        
   0080                 UO.HLT	EQU	10000000B	; DISABLE HALT PROCESSING
   0040                 UO.NFR	EQU	CB.CLI		; NO REFRESH OF FRONT PANEL
   0002                 UO.DDU	EQU	00000010B	; DISABLE DISPLAY UPDATE
   0001                 UI.CLK	EQU	00000001B	; ALLOW CLOCK INTERRUPT PROCESSING
                        
                        ;
                        ;	H8 Mini equates
                        ;
                        ;	8255 PPI at 0F0-0F3
                        ;
   00f0                 PPI	EQU	0F0H
   0000                 IO.A	EQU	0
   0001                 IO.B	EQU	1
   0002                 IO.C	EQU	2
   0003                 CTRL	EQU	3
                        
   0010                 KNUM	EQU	00010000B	; PC4
   0020                 KMATH	EQU	00100000B	; PC5
   0040                 KR	EQU	01000000B	; PC6
   0080                 K0	EQU	10000000B	; PC7
                        
                        ;
                        ;	Equates used by GWMON
                        ;
                        ;	ASCII Equates
                        ;
   0003                 CTLC	EQU	03
   0008                 BS	EQU	08
   000a                 LF	EQU	10
   000d                 CR	EQU	13
                        
   0003                 CANCEL	EQU	CTLC		; Escape/cancel character, CTRL+C
   000d                 NEXTLOC	EQU	CR		; Keystroke for next location in E
                        				; defaults to CR
                        				
   8000                 STACK	equ	8000H		; Stack at top of RAM (32K for H8 Mini)
                        
                        ;
                        ;	Keypad autorepeat delay (ARDLY) and debounce delay (DBDLY) in ms.
                        ;
   0190                 ARDLY	EQU	400
   000a                 DBDLY	EQU	10
                        
                        ;
                        ;	Bit times for bit-banged serial
                        ;
                        ; Using Intel Application Note AP-29 the following are computed for
                        ; use with 4.0 MHz crystal - gfr
                        ;
                        ;BITTIME	EQU	010AH		;9600 BPS with 4.0 MHz crystal
                        ;HALFBIT	EQU	0106H		;Half-bit time
                        
   0137                 BITTIME	EQU	0137H		;2400 BPS with 4.0 MHz crystal
   011c                 HALFBIT	EQU	011CH		;Half-bit time
                        
                        
                        	INCLUDE	"u8251.asm"	; DEFINE THE 8251 USART BITS
                        ;        STL     '8251 USART BIT DEFINITIONS.'
                        ;        EJECT
                        	PAGE
                        ;      8251 USART BIT DEFINITIONS.
                        ;
                        
                        ;      PORT ADDRESSES
                        
   0000                 UDR     EQU     0               ; DATA REGISTER IS EVEN
   0001                 USR     EQU     1               ; STATUS REGISTEP IS NEXT
                        
   00fa                 SC.UART EQU     372Q            ; CONSOLE USAPT ADDPESS (IFF 8251)
                        
                        
                        ;      MODE INSTRUCTION CONTROL BITS.
                        
   0040                 UMI.1B  EQU     01000000B       ; 1 STOP BIT
   0080                 UMI.HB  EQU     10000000B       ; 1 1/2 STOP BITS
   00c0                 UMI.2B  EQU     11000000B       ; 2 STOP BITS
   0020                 UMI.PE  EQU     00100000B       ; EVEN PARITY
   0010                 UMI.PA  EQU     00010000B       ; USE PARITY
   0000                 UMI.L5  EQU     00000000B       ; 5 BIT CHARACTERS
   0004                 UMI.L6  EQU     00000100B       ; 6 BIT CHARACTERS
   0008                 UMI.L7  EQU     00001000B       ; 7 BIT CHARACTERS
   000c                 UMI.L8  EQU     00001100B       ; 8 BIT CHARACTERS
   0001                 UMI.1X  EQU     00000001B       ; CLOCK 8 1
   0002                 UMI.16X EQU     00000010B       ; CLOCK X 16
   0003                 UMI.64X EQU     00000011B       ; CLOCK 8 64
                        
                        ;      COMMAND INSTRUCTION BITS.
                        
   0040                 UCI.IR  EQU     01000000B       ; INTERNAL RESET
   0020                 UCI.RO  EQU     00100000B       ; READER-ON CONTROL FLAG
   0010                 UCI.ER  EQU     00010000B       ; ERROR RESET
   0004                 UCI.RE  EQU     00000100B       ; RECEIVE ENABLE
   0002                 UCI.IE  EQU     00000010B       ; ENABLE INTERRUPTS FLAG
   0001                 UCI.TE  EQU     00000001B       ; TRANSMIT ENABLE
                        
                        ;      STATUS READ COMMANB BITS.
                        
   0040                 USR.BD  EQU     01000000B       ; Break Detect                    /80.08.gc/
   86a0                 USR.FE  EQU     00100000D       ; FRAMING ERROR
   0010                 USR.OE  EQU     00010000B       ; OVERRUN ERROR
   0008                 USR.PE  EQU     00001000B       ; PARITY ERROR
   0004                 USR.TXE EQU     00000100B       ; TRANSMITTER EMPTY
   0002                 USR.RXR EQU     00000010B       ; RECEIVER READY
   0001                 USR.TXR EQU     00000001B       ; TRANSMITTER READY
                        
                        
                        ;	INTERRUPT VECTORS.
                        ;
                        
                        ;	LEVEL 0 - RESET
                        ;
                        ;	The CPU will jump here on a cold start
                        ;
                        ;	THIS 'INTERRUPT' MAY NOT BE PROCESSED BY A USER PROGRAM.
                        
   0000                 	ORG	0
                        
   0000   11 f9 03      INIT0	LXI	D,PRSROM	; (DE) = ROM COPY OF PRS CODE
   0003   21 0a 20      	LXI	H,PRSRAM+PRSL-1 ; (HL) = RAM DESTINATION FOR CODE
   0006   c3 9c 00      	JMP	INIT		; INITIALIZE
                        ;	ERRPL	INIT-1000Q	; BYTE IN WORD 10A MUST BE 0
                        
   001b                 	ORG	33Q
                        ;
                        ;	Legacy relic from PAM/8 - needs updating for H8 Mini if used
                        ;
   001b   3e d0         GO.     MVI     A,CB.SSI+CB.CLI+CB.SPK ; OFF MONITOR MODE LIGHT
   001d   c3 44 02              JMP     SST1            ; RETURN TO USER PROGRAM
                        
                        
                        ;	Interrupt 5.5 - caused by RTM/0 key combination
                        ;
                        ;	On the original H8 RTM/0 generated a level 10 
                        ;	interrupt - basically the clock handler. The CLOCK
                        ;	routine would test for the RTM/0 combination and
                        ;	drop back into the monitor.
                        ;
                        ;	The H8 Mini has its own direct interrupt handler for the
                        ;	RTM/0 key combo. Need to insert similar code here.
                        ;
                        ;	This interrupt is maskable via SIM instruction.
                        ;
                        ;	NOTE: In PAM-8 location 53Q is the address of DLY, a
                        ;	general purpose delay routine. Unfortunately
                        ;	we will have to relocate DLY because of the INT5.5
                        ;	code.
                        
   002c                 	ORG	54Q
   002c                 INT5.5	EQU	*
   002c   fb            	EI
   002d   c9            	RET
                        	
                        ;	Interrupt 6.5 - Serial I/O
                        ;
                        
   0034                 	ORG	64Q
   0034   c3 5e 00      	JMP	CINT		; jump directly to handler
                        
                        	
                        ;	Interrupt 7.5 - generated by 2ms clock
                        ;
                        ;	Every 2ms this interrupt updates the TICCNT counter,
                        ;	then calls Refresh Front Panel (RFP), which refreshes
                        ;	the LED display and checks for keypad hits.
                        ;
   003c                 	ORG	74Q
   003c   cd ba 00      INT7.5	CALL	SAVALL		; save user registers
                        ;
                        ;	We need to do nested interrupt handling here, allowing the lower
                        ;	priority (RST 6.5) serial line IRQ to interrupt the front panel
                        ;	refresh. Without this serial data will be lost. First enable interrupts
                        ;	and then specifically mask out the 7.5 ones to allow lower ones in
                        ;
   003f   fb            	EI			; ok to interrupt us
   0040   3e 0d         	MVI	A,00001101B	; enable RST 6.5 - serial start bit IRQ
   0042   30            	SIM			; apply the mask
                        
   0043   16 00         	MVI	D,0		; needed for proper RFP execution
   0045   c3 e2 00      	JMP	CLOCK		; process clock interrupt
                        
   0053                 	ORG	53H
                        	
                        ;	DLY - Delay time interval
                        ;
                        ;	This routine now lives at 053H (in PAM/8 was 053Q)
                        ;	It is a much simplified version as HORN now done differently.
                        ;
                        ;	ENTRY:	(A) = (ms. delay count)/2
                        ;
                        ;	USES	A,F
                        ;
   0053   e5            DLY:	PUSH	H		; (HL) used for working storage
   0054   21 1b 20      	LXI	H,TICCNT	; (M) = low byte of TICCNT
   0057   86            	ADD	M		; (A) = TICCNT + count (ignore wrap around)
                        ;
                        ;	wait required number of tick counts. Just loop here until
                        ;	the interrupt-driven TICCNT number matches the right number.
                        ;
   0058   be            DLY2:	CMP	M		; wait until ticks have passed
   0059   c2 58 00      	JNZ	DLY2
                        
   005c   e1            	POP	H
   005d   c9            	RET
                        
                        ;	CINT - serial I/O interrupt handler
                        ;
                        ;	This interrupt is triggered by a transition from low to
                        ;	high on the SID line, which is an inverted version of the RX
                        ;	signal on the serial input header. This transition indicates
                        ;	the start bit of a 10-bit sequence (start bit, 8-bit data byte
                        ;	and stop bit). This handler decodes the byte and stores it for
                        ;	later retrieval, setting a flag to indicate data is ready. There
                        ;	currently is not a ring buffer so the user application must
                        ;	poll frequently for data. Since the 2ms interrupt (RST 7.5) is
                        ;	a higher priority and involves somewhat lengthy processing, its
                        ;	handler must yield for the RST 6.5 handler to process a byte even
                        ;	if it is in the middle of a clock update.
                        ;
                        ;	Use the SID and SOD pins on the Intel 8085 for bit-bang
                        ;	serial I/O. This driver uses fixed bitrate constants for 
                        ;	delay routines used to pace serial transmit/receive.
                        ;
                        ;	Derived from Intel Application Note AP-29, August 1977.
                        ;
   005e   f5            CINT:	PUSH	PSW
   005f   c5            	PUSH	B
   0060   e5            	PUSH	H
                        ;
                        ;	We know we have a start bit (that generated the interrupt). First
                        ;	we delay 1/2 the bit time (HALFBIT). This puts us in the middle of the
                        ;	start bit. Once we are thus shifted we just sample bits every BITTIME.
                        ;	Use (C) to build the byte (not necessary to clear it as we will overwrite
                        ;	all 8 bits). Use (B) to count the bits.
                        ;
   0061   06 09         	MVI	B,9		; Received bits counter
                        
   0063   21 1c 01      	LXI	H,HALFBIT	; Delay one half-bit time
   0066   2d            CI2:	DCR	L		; putting us in the middle of the start bit
   0067   c2 66 00      	JNZ	CI2
   006a   25            	DCR	H
   006b   c2 66 00      	JNZ	CI2
                        ;
                        ;	Loop over the bits
                        ;
   006e   21 37 01      CI3:	LXI	H,BITTIME	; Delay one bit-time. puts us in the middle
   0071   2d            CI4:	DCR	L		; of the next bit and will keep
   0072   c2 71 00      	JNZ	CI4		; us in the middle of bits for
   0075   25            	DCR	H		; reliable sampling.
   0076   c2 71 00      	JNZ	CI4
                        
   0079   20            	RIM			; Read the SID line
   007a   2f            	CMA			; invert it (for H8 Mini)
   007b   17            	RAL			; save the bit in the CY flag
   007c   05            	DCR	B		; decrement the bit counter
   007d   ca 87 00      	JZ	CI5		; Stop bit, done with char receive!
                        
   0080   79            	MOV	A,C		; get the byte under construction
   0081   1f            	RAR			; rotate the bit into place
   0082   4f            	MOV	C,A		; and save it
   0083   00            	NOP			; Equalize OUT and IN loop times
   0084   c3 6e 00      	JMP	CI3		; Get more bits
                        ;
                        ;	We now have all 8 bits, store the byte and indicate that
                        ;	it is ready to be read
                        ;
   0087   21 36 20      CI5:	LXI	H,IOBYTE	; point to storage
   008a   71            	MOV	M,C		; save it
   008b   23            	INX	H		; NOTE: assumes NBYTES follows IOBYTE
   008c   36 01         	MVI	M,1		; one byte available
                        
   008e   e1            	POP	H
   008f   c1            	POP	B
   0090   f1            	POP	PSW
   0091   fb            	EI
   0092   c9            	RET
                        
                        ;	PPSROM - PPI Setup code
                        ;
                        ;	Here we use a trick. This is the code to initialize the configuration
                        ;	of the 8255 PPI. There is a catch 22 here because this will momentarily
                        ;	disable the visibility of ROM in low memory. One solution would be to
                        ;	copy the code to RAM and execute it there, but here we use a different
                        ;	approach. The H8 Mini mirrors the low 8K of ROM to 32K,	so the routine is
                        ;	visible at this location plus 32K. We will store it here but call it from
                        ;	a location 8000H higher (PPS).
                        ;
   0093   3e 88         PPSROM:	MVI	A,10001000B	; all bits OUT except PC4..PC7
   0095   d3 f3         	OUT	PPI+CTRL
   0097   3e 10         	MVI	A,00010000B	; make sure PA4 stays high (ROM/RAM line)
   0099   d3 f0         	OUT	PPI+IO.A
   009b   c9            	RET
                        
   8093                 PPS	EQU	PPSROM+8000H	; where we will actually call it from
                        
                        
                        ;	INIT - initialize system
                        ;
                        ;	INIT is called whenever a hardware master-clear is initiated.
                        ;
                        ;	Setup PAM/8 control cells in RAM.
                        ;	Decode how much memory exists, setup stackpointer, amd
                        ;	enter the monitor loop.
                        ;
                        ;	ENTRY:	from master clear
                        ;	EXIT:	into PAM/8 main loop
                        ;
                        ;	First, initalize key locations in RAM using initial
                        ;	values stored in ROM (PRSROM). Values are copied in
                        ;	reverse order.
                        ;
   009c   1a            INIT	LDAX	D		; copying from *PRSROM* into RAM
   009d   77            	MOV	M,A		; move a byte
   009e   2b            	DCX	H		; decrement destination
   009f   1c            	INR	E		; increment source
   00a0   c2 9c 00      	JNZ	INIT		; and loop 'til done
                        ;
                        ;	Show something interesting on the LEDs
                        ;
   00a3   21 1b 20      	LXI	H,TICCNT	; Tick counter
   00a6   22 14 20      	SHLD	ABUSS		; store it
                        ;
                        ;	In PAM/8 the code determines the top of RAM by probing
                        ;	every 1K for live RAM and then set the stack pointer
                        ;	there. For the H8 Mini we assume a 32K RAM space and
                        ;	set SP there.
                        ;
   00a9   31 00 80      	LXI	SP,STACK	; Stack at top of RAM
                        	
                        ;	PUSH	H		; save *PC* value on stack
                        ;	LXI	H,ERROR		; ERROR = general bail out routine
                        ;	PUSH	H		; set as 'return address'
                        ;
                        ;	For testing purposes we now initialize key values and
                        ;	jump to GWMON console monitor
                        
                        ;
                        ;	Call the PPI setup code from its "shadow" location 8000H higher
                        ;
   00ac   cd 93 80      	CALL	PPS
                        ;
                        ;	Set up interrupt vectors
                        ;
   00af   af            	XRA	A		; clear serial I/O byte count
   00b0   32 37 20      	STA	NBYTES
   00b3   3e 09         	MVI	A,00001001B	; enable RST 7.5 (clock) and RST 6.5 (serial)
                        ;	MVI	A,00001011B	; enable RST 7.5 (clock) only
   00b5   30            	SIM			; apply the mask
   00b6   fb            	EI			; globally enable interrupts
                        ;
                        ;	Now just go to the GWMON command loop (later we'll add the
                        ;	front panel keypad code)
                        ;
   00b7   c3 00 04      	JMP	GWMON
                        
                        ;
                        ;	SAVALL - save all registers on stack.
                        ;
                        ;	Called when an interrupt is accepted, in order to
                        ;	save the contents of the registers on the stack.
                        ;
                        ;	ENTRY	called directly from the interrupt routine.
                        ;	EXIT	all registers pushed on stack.
                        ;		if not yet in monitor mode, REGPTR = address of registers
                        ;		on stack.
                        ;		(DE) = address of CTLFLG
                        
                        
   00ba   e3            SAVALL	XTHL			; set H,L on stack top
   00bb   d5            	PUSH	D
   00bc   c5            	PUSH	B
   00bd   f5            	PUSH	PSW
   00be   eb            	XCHG			; (D,E) = return address
   00bf   21 0a 00      	LXI	H,10
   00c2   39            	DAD	SP		; (H,L) = address of users SP
   00c3   e5            	PUSH	H		; set on stack as 'register'
   00c4   d5            	PUSH	D		; set return address
   00c5   11 09 20      	LXI	D,CTLFLG
   00c8   1a            	LDAX	D		; (A) = CTLFLG
   00c9   2f            	CMA
   00ca   e6 30         	ANI	CB.MTL+CB.SSI	; save register addr if user or single-step
   00cc   c8            	RZ			; return if was interrupt or monitor loop
   00cd   21 02 00      	LXI	H,2
   00d0   39            	DAD	SP		; (H,L) = address of 'STACKPTR' on stack
   00d1   22 1d 20      	SHLD	REGPTR
   00d4   c9            	RET
                        ;
                        ;	INTXID - Return to program from interrupt.
                        ;
   00d5   f1            INTXIT	POP	PSW		; remove fake 'stack register'
                        ;
                        ;	Make sure clock interrupts are enabled
                        ;
   00d6   20            	RIM			; Read interrupt mask
   00d7   e6 03         	ANI	00000011B	; leave 5.5 and 6.5 alone
   00d9   f6 08         	ORI	00001000B	; 7.5 LOW (interrupts on)
   00db   30            	SIM			; set new mask
                        	
   00dc   f1            	POP	PSW
   00dd   c1            	POP	B
   00de   d1            	POP	D
   00df   e1            	POP	H
   00e0   fb            	EI
   00e1   c9            	RET
                        ;
                        ;	CLOCK - process clock interrupt
                        ;
                        ;	Entered whenever a 2 millisecond clock interrupt is
                        ;	processed.
                        ;
                        ;	TICCNT is incremented every interrupt, then fall
                        ;	through to RFP to refresh front panel and PCK to
                        ;	probe console keypad.
                        ;
   00e2   2a 1b 20      CLOCK	LHLD	TICCNT
   00e5   23            	INX	H
   00e6   22 1b 20      	SHLD	TICCNT		; INCREMENT TICCOUNT
                        
                        ;	RFP - Refresh Front Panel (and probe keypad switches)
                        ;
                        ;	This code uses the 8255 PIA lines to do two things: 1) refresh the
                        ;	front panel LEDs and 2) probe to detect front panel keypad closures.
                        ;	This is called for every clock interrupt so it updates only one
                        ;	7-segment LED unit at a time (working right to left).
                        ;	The REFIND variable keeps track of the refresh index.
                        ;
                        ;	Since the H8 Mini makes dual purpose of the PA0..PA3 lines
                        ;	to both select LEDS and switches, it makes sense to simultaneously
                        ;	scan for keyswitch closures.
                        ;
                        ;	ENTRY: 	calling program should set (D) = 0
                        ;
   00e9   21 08 20      RFP	LXI	H,MFLAG		; ((HL)) = MFLAG
   00ec   7e            	MOV	A,M		; (A) = current MFLAG value
   00ed   47            	MOV	B,A		; save it in (B)
   00ee   e6 40         	ANI	UO.NFR		; Test No Front Refresh bit
   00f0   23            	INX	H		; code assumes CTLFLG follows MFLAG
                        
   00f1   7e            	MOV	A,M		; (A) = CTLFLG
   00f2   4a            	MOV	C,D		; (C) = 0 in case no panel refresh
                        ;
                        ;	The original PAM/8 had an ability to skip over front panel
                        ;	refresh to save CPU time, but since the keypad scan is now
                        ;	accomplished that way we have to be careful. For now 
                        ;	disable this capability. We may be able to re-introduce it
                        ;	differently later...
                        ;
                        ;	JNZ	CLK3		; NFR bit was set - no refresh
                        
   00f3   23            	INX	H		; code assumes REFIND follows CTLFLG
                        ;
                        ;	Here (HL) points to the refresh index (REFIND). Since the front
                        ;	panel LED pattern bytes (FPLEDS) immediately follow that location
                        ;	they are indexed from 1 to 9. REFIND was initialized to 1 at startup.
                        ;
   00f4   35            	DCR	M		; decrement digit index
   00f5   c2 ff 00      	JNZ	CLK2		; still positive, keep going
                        ;
                        ;	A little housekeeping for the upcoming keypad scan: Starting a new
                        ;	refresh cycle. Get ready for a new round of keypad scans:
                        ;	set PCKTMP to 0FFH
                        ;
   00f8   3e ff         	MVI	A,0FFH		; default to return if no keys pressed
   00fa   32 35 20      	STA	PCKTMP		; after scanning all 9.
                        	
   00fd   36 09         	MVI	M,9		; loop continuously counting down from 9
   00ff   5e            CLK2	MOV	E,M		; (DE) = index pointer to pattern
   0100   19            	DAD	D		; ((HL)) = (M) = LED pattern
                        ;
                        ;	Port B controls which of the segments to light
                        ;	(M) = pattern to send to the LED
                        ;
   0101   af            	XRA	A		; first zero the pattern
   0102   d3 f1         	OUT	PPI+IO.B	; this avoids "ghosting"
                        	
   0104   db f0         CLK3	IN	PPI+IO.A	; read Port A status
   0106   e6 f0         	ANI	11110000B	; clear lower 4 bits
   0108   b3            	ORA	E		; set bits for digit to select
   0109   d3 f0         	OUT	PPI+IO.A	; select it
                        ;
                        ;	Now set the segments to be lit on Port B
                        ;
   010b   7e            	MOV	A,M		; (A) = LED pattern from table
   010c   d3 f1         	OUT	PPI+IO.B	; set it!
                        ;
                        ;	PCK - Probe Console Keypad
                        ;
                        ;	While we have this line selected we can probe for switch closures by
                        ;	examining PC4..PC7. These input lines are matrixed with the various
                        ;	key switches. If a key is pressed the appropriate value is stored in PCKTMP,
                        ;	per the table below. PCKTMP is initally set to "no key pressed" (0FFH) when
                        ;	the scan cycle begins.
                        ;
                        ;	If no key is pressed on this pass we continue scanning with next clock interrupt.
                        ;	After 9 scans the value of PCKTMP is "published" to PCKVAL, where it can be
                        ;	read by the RCK routine. If no key was pressed during the 9 cycles then
                        ;	PCKVAL will be 0FFH.
                        ;
                        ;	Key Values to be returned in PCKVAL:
                        ;
                        ;	Key	  Value (decimal)
                        ;	0-9		0-9
                        ;	'+'		10
                        ;	'-'		11
                        ;	'*'		12
                        ;	'/'		13
                        ;	'#'		14
                        ;	'.'		15
                        ;     <no key>		255
                        ;
   010e   c5            PCK:	PUSH	B		; using B for scratch
                        ;
                        ;	PC4..PC7 are four input lines on the PPI chip that are matrixed
                        ;	with the various switches.
                        ;
                        ;	PC4	KNUM	Active "low"; Number [1..9]
                        ;	PC5	KMATH	Active "low"; '.', '*', '-', '+'
                        ;	PC6	KR	Active "high";'/' (RST)
                        ;	PC7	K0	Active "high", '0'
                        ;
   010f   db f2         	IN	PPI+IO.C	; read PC4..PC7
   0111   ee 30         	XRI	00110000B	; make all signals "active high"
   0113   47            	MOV	B,A		; keep a copy
   0114   e6 40         	ANI	KR		; check for '/'
   0116   c2 50 01      	JNZ	PCKR		; pressed, jump
                        	
   0119   78            	MOV	A,B		; restore reading
   011a   e6 80         	ANI	K0		; check for '0'
   011c   c2 55 01      	JNZ	PCKZ		; pressed, jump
                        	
   011f   78            	MOV	A,B		; restore reading
   0120   e6 10         	ANI	KNUM		; check for [1..9]
   0122   c2 59 01      	JNZ	PCKN
                        	
   0125   78            	MOV	A,B		; restore reading
   0126   e6 20         	ANI	KMATH		; check for '.', '*', '-', '+'
   0128   ca 60 01      	JZ	PCKQ		; no match to any, skip to end
                        ;
                        ;	A "math" key pressed ('#', '.', '*', '-' or '+')
                        ;
                        ;	First we need to test whether this came from the SM ('#')
                        ;	switch. To test that we need to momentarily turn off all refresh
                        ;	lines (LED segments will briefly extinguish).
                        ;
   012b   db f0         PCKM:	IN	PPI+IO.A	; read Port A status
   012d   4f            	MOV	C,A		; save it (for restoration later)
   012e   e6 f0         	ANI	11110000B	; clear refresh lines
   0130   d3 f0         	OUT	PPI+IO.A	; turn off all lines
   0132   db f2         	IN	PPI+IO.C	; re-read the inputs
   0134   47            	MOV	B,A		; save it
                        ;
                        ;	now immediately turn the LEDs back on (hopefully nobody noticed!)
                        ;	
   0135   79            	MOV	A,C		; get back desired line state
   0136   d3 f0         	OUT	PPI+IO.A	; select it
                        	
   0138   78            	MOV	A,B		; now let's see if KMATH was asserted
   0139   e6 20         	ANI	KMATH		; (remember "low" = key pressed)
   013b   c2 43 01      	JNZ	PCKM1		; "high" -> no key pressed (not SM)
   013e   3e 0e         	MVI	A,14		; "low" -> SM ('#') key was pressed
   0140   c3 5d 01      	JMP	PCK1		; done!
                        ;
                        ;	Set key value according to original PAM/8 scheme:
                        ; E = 1:	'.'	15
                        ; E = 2:	'*'	12
                        ; E = 3:	'-'	11
                        ; E = 4:	'+'	10
                        ;
                        ; for E = 2, 3 or 4 just subtract from 14. E = 1 is special case
                        ;
   0143   3e 0e         PCKM1:	MVI	A,14
   0145   93            	SUB	E		; A = 14 - (E)
   0146   fe 0d         	CPI	13		; 13 should be 15
   0148   da 5d 01      	JC	PCK1		; <13 is OK
   014b   c6 02         	ADI	2		; make the adjustment
   014d   c3 5d 01      	JMP	PCK1
                        ;
                        ;	RST ('/') pressed
                        ;
   0150   3e 0d         PCKR:	MVI	A,13		; '/' = 13
   0152   c3 5d 01      	JMP	PCK1		; done
                        ;
                        ;	'0' pressed
                        ;
   0155   af            PCKZ:	XRA	A		; '0' = 0
   0156   c3 5d 01      	JMP	PCK1		; done
                        ;
                        ;	'1' through '9' pressed
                        ;
   0159   7b            PCKN:	MOV	A,E		; return the scan number
   015a   c3 5d 01      	JMP	PCK1		; done
                        ;
                        ;	Come here with (A) = keycode if key press was detected
                        ;
   015d   32 35 20      PCK1:	STA	PCKTMP		; save the key value
                        
                        
   0160   c1            PCKQ:	POP	B		; restore B, and done ...
   0161   1d            	DCR	E		; set 'Z' flag
   0162   c2 6b 01      	JNZ	PCKX		; not done yet
                        ;
                        ;	Done with 9 scans, move "temp" value to actual
                        ;
   0165   3a 35 20      	LDA	PCKTMP		; load our scratch copy
   0168   32 34 20      	STA	PCKVAL		; make it official
                        ;
                        ;	End of keypad processing
                        ;
   016b                 PCKX	EQU	*
                        ;
                        ;	See if time to decode display values
                        ;
   016b   21 1b 20      	LXI	H,TICCNT	; check the clock
   016e   7e            	MOV	A,M		; low byte only
   016f   e6 1f         	ANI	31		; multiple of 32?
                        ;
                        ;	every 32 interrupts update the front panel and
                        ;	check for key presses
                        ;
   0171   cc ba 03      	CZ	UFD		; Update front panel display
                        ;
                        ;	Exit clock interrupt
                        ;
                        ;	For testing purposes simply exit here. Code that follows is to handle
                        ;	processing of HLT instructions
                        ;
   0174   c3 d5 00      	JMP	INTXIT
                        
                        
                        ;	LXI	B,CTLFLG
                        ;	LDAX	B		; (A) = CTLFLG
                        ;	ANI	CB.MTL
                        ;	JNZ	INTXIT		; IF IN MONITOR CODE
                        ;	DCX	B
                        ;	ERRNZ	CTLFLG-MFLAG-1	; code assumes CTLFLG follows MFLAG
                        ;	LDAX	B		; (A) = MFLAG
                        ;	ERRNZ	UO.HLT-200Q	; ASSUME HIGH-ORDER
                        ;	RAL
                        ;	JC	CLK4		; SKIP IT
                        
                        ;	NOT IN MONITOR MODE, CHECK FOR HALT
                        
                        ;	MVI	A,10		; (A) = INDEX OF *P* REG
                        ;	CALL	LRA.		; LOCATE REGISTER ADDRESS
                        ;	MOV	E,M
                        ;	INX	H
                        ;	MOV	D,M		; (D,E) = PC CONTENTS
                        ;	DCX	D
                        ;	LDAX	D
                        ;	CPI	MI.HLT		; CHECK FOR HALT
                        ;	JZ	ERROR		; IF HALT, BE IN MONITOR MODE
                        
                        ;	CHECK FOR 'RETURN TO MONITOR' KEY ENTRY.
                        ;CLK4	EQU	*
                        ;	 IN	 IP.PAD
                        ;	 CPI	 56Q		 ; SEE IF '0' AND '#'
                        ;	 JNZ	 CUI1		 ; IF NOT, ALLOW USER PROCESSING OF CLOCK
                        
                        ;	ERROR - COMMAND ERROR.
                        ;
                        ;	ERROR IS CALLED AS A 'BAIL-OUT' ROUTINE.
                        ;
                        ;	IT RESETS THE OPERATIONAL MODE, AND RESTORES THE STACKPOINTER.
                        ;
                        ;	ENTRY	NONE
                        ;	EXIT	TO MTR LOOP
                        ;		CTLFLG SET
                        ;		MFLAG CLEARED
                        ;	USES	ALL
                        
   0177   21 08 20      ERROR:	LXI	H,MFLAG
   017a   7e            	MOV	A,M		; (A) = MFLAG
   017b   e6 bd         	ANI	377Q-UO.DDU-UO.NFR ; RE-ENABLE DISPLAYS
   017d   77            	MOV	M,A		; REPLACE
   017e   23            	INX	H		; next point to CTLFLG
   017f   36 f0         	MVI	M,CB.SSI+CB.MTL+CB.CLI+CB.SPK ; RESTORE *CTLFLG*
                        ;	ERRNZ	CTLFLG-MFLAG-1	; code assumes CTLFLG follows MFLAG
   0181   fb            	EI
   0182   2a 1d 20      	LHLD	REGPTR
   0185   f9            	SPHL			; RESTORE STACK POINTER TO EMPTY STATE
   0186   cd c3 02      	CALL	ALARM		; ALARM FOR 200 MS
                        
                        ;	MTR - MONITOR LOOP.
                        ;
                        ;	THIS IS THE MAIN EXECUTIVE LOOP FOR THE FRONT PANEL EMULATOR.
                        
   0189   fb            MTR	EI
                        
   018a   21 8a 01      MTR1	LXI	H,MTR1
   018d   e5            	PUSH	H		; SET 'MTR1' AS RETURN ADDRESS
   018e   01 07 20      	LXI	B,DSPMOD	; (BC) = #DSPMOD
   0191   0a            	LDAX	B
   0192   e6 01         	ANI	1		; (A) = 1 IF ALTER
   0194   2f            	CMA
   0195   32 06 20      	STA	DSPROT		; ROTATE LED PERIODS IF ALTER
                        
                        ;	READ KEY
                        
   0198   cd 25 06      	CALL	RCK		; READ CONSOLE KEYPAD
   019b   2a 14 20      	LHLD	ABUSS
   019e   fe 0a         	CPI	10
   01a0   d2 aa 01      	JNC	MTR4		; IF IN 'ALWAYS VALID' GROUP
   01a3   5f            	MOV	E,A		; SAVE VALUE
                        ;	SET	DSPMOD
   01a4   0a            	LDAX	B		; (A) = DSPMOD
   01a5   0f            	RRC
   01a6   da ce 01      	JC	MTR5		; IF IN ALTER MODE
   01a9   7b            	MOV	A,E		; (A) = CODE
                        
                        ;	HAVE A COMMAND (NOT A VALUE)
                        
   01aa   d6 04         MTR4	SUI	4		; (A) = COMMAND
   01ac   da 77 01      	JC	ERROR		; IF BAD
   01af   5f            	MOV	E,A
   01b0   e5            	PUSH	H		; SAVE ABUSS VALUE
   01b1   21 c2 01      	LXI	H,MTRA
   01b4   16 00         	MVI	D,0
   01b6   19            	DAD	D		; (H,L) = ADDRESS OF TABLE ENTRY
   01b7   5e            	MOV	E,M
   01b8   19            	DAD	D		; (H,L) = ADDRESS OF PROCESSOR
   01b9   e3            	XTHL			; SET ADDRESS, (H,L) = (ABUSS)
   01ba   11 05 20      	LXI	D,REGI		; (D,E) = ADDRESS OF REG INDEX
                        ;	SET	DSPMOD
   01bd   0a            	LDAX	B		; (A) = DSPMOD
   01be   e6 02         	ANI	2		; SET 'Z' IF MEMORY
   01c0   0a            	LDAX	B		; (A) = DSPMOD
   01c1   c9            	RET			; JUMP TO PROCESSOR
                        
   01c2                 MTRA				; JUMP TABLE
   01c2   77            	DB	GO-$		; 4 - GO
   01c3   63            	DB	IN- $		; 5 - INPUT
   01c4   65            	DB	OUT-$		; 6 - OUTPUT
   01c5   77            	DB	SSTEP-$		; 7 - SINGLE STEP
   01c6   92            	DB	RMEM-$		; 8 - CASSETTE LOAD
   01c7   9a            	DB	WMEM-$		; 9 - CASSETTE DUMP
   01c8   38            	DB	NEXT-$		; + - NEXT
   01c9   45            	DB	LAST-$		; - - LAST
   01ca   43            	DB	ABORT-$		; * - ABORT
   01cb   31            	DB	RW-$		; / - DISPLAY/ALTER
   01cc   4f            	DB	MEMM-$		; # - MEMORY MODE
   01cd   1c            	DB	REGM-$		; . - REGISTER MODE
                        
                        ;	PROCESS MEMORY/REGISTER ALTERATIONS.
                        ;
                        ;	THIS CODE IS ENTERED IF
                        ;
                        ;	1) AM IN ALTER MODE, AND
                        ;	2) A KEY FROM 0-7 WAS ENTERED.
                        
   01ce   0f            MTR5	RRC
   01cf   7b            	MOV	A,E		; (A) = VALUE
   01d0   da dc 01      	JC	MTR6		; IS REGISTER
   01d3   37            	STC			; INDICATE 1ST DIGIT IS IN (A)
   01d4   cd 7f 03      	CALL	IOB		; INPUT OCTAL BYTE
   01d7   23            	INX	H		; DISPLAY NEXT LOCATION
                        
                        ;	SAE - STORE ABUSS AND EXIT.
                        ;
                        ;	ENTRY	(HL) = ABUSS VALUE
                        ;	EXIT	TO (RET)
                        ;	USES	NONE
                        
   01d8   22 14 20      SAE	SHLD	ABUSS
   01db   c9            	RET
                        
                        ;	ALTER REGISTER
                        
   01dc   f5            MTR6	PUSH	PSW		; SAVE CODE
   01dd   cd 70 03      	CALL	LRA		; LOCATE REGISTER ADDRESS
   01e0   a7            	ANA	A
   01e1   ca 77 01      	JZ	ERROR		; NOT ALLOWED TO ALTER STACKPOINTER
   01e4   23            	INX	H
   01e5   f1            	POP	PSW		; RESTORE VALUE AND CARRY FLAG
   01e6   c3 7b 03      	JMP	IOA		; INPUT OCTAL ADDRESS
                        
                        
                        ;	REGM - ENTER REGISTER DISPLAY MODE.
                        ;
                        ;	ENTRY	(A) = DSPMOD
                        ;		(BC) = #DSPMOD
                        
   01e9   3e 02         REGM	MVI	A,00000010B	; Set dispolay to register mode
                        ;	SET	DSPMOD
   01eb   02            	STAX	B		; SET DISPLAY REGISTER MODE
                        ;	ERRNZ	DSPMOD-DSPROT-1	; code assumesDSPMOD follows DSPROT
   01ec   0b            	DCX	B		; (BC) = #DSPROT
   01ed   af            	XRA	A
   01ee   2f            	CMA			; H8 Mini uses '1' for LED segment on - gfr
   01ef   02            	STAX	B		; SET ALL PERIODS ON
   01f0   cd 25 06      	CALL	RCK		; READ KEY ENTRY
   01f3   3d            	DCR	A		; DISPLACE
   01f4   fe 06         	CPI	6
   01f6   d2 77 01      	JNC	ERROR		; NOT 1-6
   01f9   07            	RLC
   01fa   12            	STAX	D		; SET NEW REG IND
                        ;	SET	REGI
   01fb   c9            	RET
                        
                        ;	RW - TOGGLE DISPLAY/ALTER MODE.
                        ;
                        ;	ENTRY	(A) = DSPMOD
                        ;		(BC) = ADDRESS OF DSPMOD
                        
                        ;	SET	DSPMOD
   01fc   ee 01         RW	XRI	1
   01fe   02            	STAX	B
   01ff   c9            	RET
                        
                        ;	NEXT - INCREMENT DISPLAY ELEMENT
                        ;
                        ;	ENTRY	(HL) = (ABUSS)
                        ;		(DE) = ADDRESS OF REGIND
                        
   0200   23            NEXT	INX	H
   0201   ca d8 01      	JZ	SAE		; IF MEMORY, STORE VALUES AND EXIT
                        
                        ;	IS REGISTER MODE.
                        
                        ;	SET	REGI
   0204   1a            	LDAX	D		; (A) = REGI
   0205   c6 02         	ADI	2		; INCREMENT REGISTER INDEX
   0207   12            	STAX	D		; WRAP TO *SP*
   0208   fe 0c         	CPI	12
   020a   d8            	RC			; IF NOT TOO LARGE, EXIT
   020b   af            	XRA	A		; OVERFLOW
   020c   12            	STAX	D
   020d   c9            ABORT	RET
                        
                        ;	LAST - INCREMENT DISPLAY ELEMENT
                        ;
                        ;	ENTRY	(HL) = (ABUSS)
                        ;		(DE) = ADDRESS OF REGIND
                        ;
                        
   020e   2b            LAST	DCX	H
   020f   ca d8 01      	JZ	SAE		; IF MEMORY, STORE AND EXIT
                        
                        ;	IS REGISTER MODE
                        
                        ;	SET	REGI
   0212   1a            LST2	LDAX	D		; (A) = REGI
   0213   d6 02         	SUI	2
   0215   12            	STAX	D
   0216   d0            	RNC			; IF OK
   0217   3e 0a         	MVI	A,10		; UNDERFLOW TO *PC*
   0219   12            	STAX	D
   021a   c9            	RET
                        
                        ;	MEMM - ENTER DISPLAY MEMORY MODE
                        ;
                        ;	ENTRY	(BC) = ADDRESS OF DSPMOD
                        
   021b   af            MEMM	XRA	A		; (A) = 0
                        ;	SET	DSPMOD
   021c   02            	STAX	B		; SET DISPLAY MEMORY MODE
                        ;	ERRNZ	DSPMOD-DSPROT-1	; code assumes DSPMOD follows DSPROT
   021d   0b            	DCX	B		; (BC) = #DSPROT
   021e   2f            	CMA			; H8 Mini uses '1' for 
   021f   02            	STAX	B		; SET ALL PERIODS ON
   0220   21 15 20      	LXI	H,ABUSS+1
   0223   c3 7b 03      	JMP	IOA		; INPUT OCTAL ADDRESS
                        
                        ;	IN - Input a data byte
                        ;
                        ;	OUT - Output a data byte
                        ;
                        ;	ENTRY:	(HL) = (ABUSS)
                        ;		(H) = value (for OUT)
                        ;		(L) = port
                        ;
                        ;	EXIT:	ABUSS updated
                        ;		(A) = value (for IN)
                        ;
   0226   06 db         IN	MVI	B,MI.IN		; Store the IN instruction in RAM
   0228   11            	DB	MI.LXID		; clever trick (skip over 'OUT' if doing 'IN')
   0229   06 d3         OUT	MVI	B,MI.OUT	; store the OUT instruction in RAM
   022b   7c            	MOV	A,H		; (A) = value
   022c   65            	MOV	H,L		; (H) = port
   022d   68            	MOV	L,B		; (L) = IN/OUT instruction
   022e   22 02 20      	SHLD	IOWRK		; Store instruction and port
   0231   cd 02 20      	CALL	IOWRK		; do the actual I/O call
   0234   6c            	MOV	L,H		; (L) = port
   0235   67            	MOV	H,A		; (H) = value
   0236   c3 d8 01      	JMP	SAE		; store ABUSS and exit
                        
                        ;	GO - RETURN TO USER MODE
                        ;
                        ;	ENTRY	NONE
                        
   0239   c3 1b 00      GO	JMP	GO.		; ROUTINE IS IN WASTE SPACE
                        
                        ;	SSTEP - SINGLE STEP INSTRUCTION
                        ;
                        ;	ENTRY	NONE
                        
   023c                 SSTEP				; SINGLE STEP
   023c   f3            	DI			; DISABLE INTERRUPTS UNTIL THE RIGHT TIME
   023d   3a 09 20      	LDA	CTLFLG
   0240   ee 10         	XRI	CB.SSI		; CLEAR SINGLE STEP INHIBIT
   0242   d3 f0         	OUT	OP.CTL		; PRIME SINGLE STEP INTERRUPT
   0244   32 09 20      SST1	STA	CTLFLG		; SET NEW FLAG VALUES
   0247   e1            	POP	H		; CLEAN STACK
   0248   c3 d5 00      	JMP	INTXIT		; RETURN TO USER ROUTINE FOR STEP
                        
                        ;	STPRTN - SINGLE STEP RETURN
                        
   024b                 STPRTN
   024b   f6 10         	ORI	CB.SSI		; DISABLE SINGLE STEP INTERRUPTION
   024d   d3 f0         	OUT	OP.CTL		; TURN OFF SINGLE STEP ENABLE
                        ;	SET	CTLFLG
   024f   12            	STAX	D
   0250   e6 20         	ANI	CB.MTL		; SEE IF IN MONITOR MODE
   0252   c2 89 01      	JNZ	MTR
   0255   c3 22 20      	JMP	UIVEC+3		; TRANSFER TO USER'S ROUTINE
                        
                        ;	RMEM - LOAD MEMORY FROM TAPE
                        ;
                        
   0258   21 15 03      RMEM	LXI	H,TPABT
   025b   22 19 20      	SHLD	TPERRX		; SETUP ERROR EXIT ADDRESS
   025e   c3 86 06      	JMP	LOAD
                        
                        
                        ;	DUMP - DUMP MEMORY TO MAG TAPE.
                        ;
                        ;	DUMP SPECIFIED MEMORY RANGE TO MAG TAPE.
                        ;
                        ;	ENTRY	(START) = START ADDRESS
                        ;		(ABUSS) = END ADDRESS
                        ;		USER PC = ENTRY POINT ADDRESS
                        ;	EXIT	TO CALLER.
                        
   0261   21 15 03      WMEM	LXI	H,TPABT
   0264   22 19 20      	SHLD	TPERRX		; TAPE ERROR EXIT
                        
   0267   3e 01         DUMP	MVI	A,UCI.TE
   0269   d3 f9         	OUT	OP.TPC		; SETUP TAPE CONTROL
   026b   3e 16         	MVI	A,A.SYN
   026d   26 20         	MVI	H,32		; (H) = # OF SYNC CHARACTERS
   026f   cd 5d 03      WME1	CALL	WNB
   0272   25            	DCR	H
   0273   c2 6f 02      	JNZ	WME1		; WRITE SYN HEADER
   0276   3e 02         	MVI	A,A.STX
   0278   cd 5d 03      	CALL	WNB		; WRITE STX
   027b   6c            	MOV	L,H		; (HL) = 00
   027c   22 17 20      	SHLD	CRCSUM		; CLEAR CRC 16
   027f   21 01 81      	LXI	H,100401Q	; RT.MI+80H*256+1 FIRST AND LAST MI RECORD
   0282   cd 58 03      	CALL	WNP
   0285   2a 00 20      	LHLD	START
   0288   eb            	XCHG			; (D,E) = START ADDRESS
   0289   2a 14 20      	LHLD	ABUSS		; (H,L) = STOP ADDR
   028c   23            	INX	H		; COMPUTE WITH STOP+1
   028d   7d            	MOV	A,L
   028e   93            	SUB	E
   028f   6f            	MOV	L,A
   0290   7c            	MOV	A,H
   0291   9a            	SBB	D
   0292   67            	MOV	H,A		; (HL) = COUNT
   0293   cd 58 03      	CALL	WNP		; WRITE COUNT
   0296   e5            	PUSH	H
   0297   3e 0a         	MVI	A,10
   0299   d5            	PUSH	D		; SAVE (DE)
   029a   cd 73 03      	CALL	LRA.		; LOCATE P-REG ADDRESS
   029d   7e            	MOV	A,M
   029e   23            	INX	H
   029f   66            	MOV	H,M
   02a0   6f            	MOV	L,A		; (HL) = CONTENTS OF PC
   02a1   cd 58 03      	CALL	WNP		; WRITE HEADER
   02a4   e1            	POP	H		; (HL) = ADDRESS
   02a5   d1            	POP	D		; (DE) = COUNT
   02a6   cd 58 03      	CALL	WNP
                        
   02a9   7e            WME2	MOV	A,M
   02aa   cd 5d 03      	CALL	WNB		; WRITE BYTE
   02ad   22 14 20      	SHLD	ABUSS		; SET ADDRESS FOR DISPLAY
   02b0   23            	INX	H
   02b1   1b            	DCX	D
   02b2   7a            	MOV	A,D
   02b3   b3            	ORA	E
   02b4   c2 a9 02      	JNZ	WME2		; IF MORE TO GO
                        
                        ;	WRITE CHECKSUM
                        
   02b7   2a 17 20      	LHLD	CRCSUM
   02ba   cd 58 03      	CALL	WNP		; WRITE IT
   02bd   cd 58 03      	CALL	WNP		; FLUSH CHECKSUM
                        ;	JMP	TFT
                        
                        ;	TFT - TURN OFF TAPE.
                        ;
                        ;	STOP THE TAPE TRANSPORT.
                        ;
                        
   02c0   af            TFT	XRA	A
   02c1   d3 f9         	OUT	OP.TPC		; TURN OFF TAPE
                        
                        ;	HORN - make noise
                        ;
                        ;	This routine works completely differently than the PAM/8
                        ;	version. The H8 Mini has to continuously toggle the speaker to
                        ;	generate a tone (the H8 just has to turn on/off a 1kHz square wave).
                        ;	For best results interrupts should be disabled (2ms clock interrupts
                        ;	will otherwise affect the sound).
                        ;
                        ;	To be compatible with the H8 we play "high" C (C6) at 1046.5 Hz.
                        ;
                        ;	ENTRY	(A) = duration (ms.)
                        ;
                        ;	USES	A,F
                        ;
   02c3   3e c8         ALARM:	MVI	A,200		; 200 ms. beep
                        
   02c5   c5            HORN:	PUSH	B		; BC used for working storage
   02c6   4f            	MOV	C,A		; C = duration
   02c7   f3            	DI			; interrupts off
   02c8   cd 01 06      	CALL	BLANK		; blank the LEDs
                        ;
                        ;	Set speaker to "high" state
                        ;
   02cb   db f0         	IN	PPI+IO.A	; Read Port A settings
   02cd   e6 3f         	ANI	00111111B	; Clear top two bits (PA6-7)
   02cf   f6 80         	ORI	10000000B	; PA7 on; PA6 off
   02d1   d3 f0         	OUT	PPI+IO.A	; set speaker bits
                        ;
                        ;	Play the tone
                        ;
   02d3   06 35         HDLY1:	MVI	B,53		; half period
                        ;
                        ;	9 uS delay loop
                        ;
   02d5   00            HDLY2:	NOP			; 4 T-states
   02d6   05            	DCR	B		; 4 T-states
   02d7   c2 d5 02      	JNZ	HDLY2		; 10 T-states
                        ;
                        ;	Toggle the speaker
                        ;
   02da   db f0         	IN	PPI+IO.A	; Read Port A settings
   02dc   ee c0         	XRI	11000000B	; toggle PA6, PA7
   02de   d3 f0         	OUT	PPI+IO.A	; set speaker bits
   02e0   17            	RAL			; test bit 7
   02e1   da d3 02      	JC	HDLY1		; now wait the other half period
                        	
   02e4   0d            	DCR	C		; decrement duration counter
   02e5   c2 d3 02      	JNZ	HDLY1		; repeat cycle 'til done
                        	
   02e8   fb            	EI
   02e9   c1            	POP	B
   02ea   c9            	RET
                        
                        ;	CTC - VERIFY CHECKSUM.
                        ;
                        ;	ENTRY	TAPE JUST BEFORE CRC
                        ;	EXIT	TO CALLER IF OK
                        ;		TO *TPERR* IF BAD
                        ;	USES	A,F,H,L
                        
   02eb   cd 46 03      CTC	CALL	RNP		; READ NEXT PAIR
   02ee   2a 17 20      	LHLD	CRCSUM
   02f1   7c            	MOV	A,H
   02f2   b5            	ORA	L
   02f3   c8            	RZ			; RETURN IF OK
   02f4   3e 01         	MVI	A,1		; CHECKSUM ERROR
                        ;	JMP	TPERR		; (B) = CODE
                        
                        ;	TPERR - PROCESS TAPE ERROR.
                        ;
                        ;	DISPLAY ERR NUMBER IN LOW BYTE OF ABUSS
                        ;
                        ;	IF ERROR NUMBER EVEN, DON'T ALLOW #
                        ;	IF ERROR NUMBER ODD, ALLOW #
                        ;
                        ;	ENTRY	(A) = NUMBER
                        
   02f6   32 14 20      TPERR	STA	ABUSS
   02f9   47            	MOV	B,A		; (B) = CODE
   02fa   cd c0 02      	CALL	TFT		; TURN OFF TAPE
                        
                        ;	IS #, RETURN (IF PARITY ERROR)
                        
   02fd   e6            	DB	MI.ANI		; FALL THROUGH WITH CARRY CLEAR
   02fe   78            TER3	MOV	A,B
                        
   02ff   0f            	RRC
   0300   d8            	RC			; RETURN IF OK
                        
                        ;	BEEP AND FLASH ERROR NUMBER
                        
   0301   dc c3 02      TER1	CC	ALARM		; ALARM IF PROPER TIME
   0304   cd 1b 03      	CALL	TPXIT		; SEE IF #
   0307   db f0         	IN	IP.PAD
   0309   fe 2f         	CPI	00101111B	; CHECK FOR #
   030b   ca fe 02      	JZ	TER3		; IF #
   030e   3a 1c 20      	LDA	TICCNT+1
   0311   1f            	RAR			; 'C' SET IF 1/2 SECOND
   0312   c3 01 03      	JMP	TER1
                        
                        ;	TPABT - ABORT TAPE LOAD OR DUMP.
                        ;
                        ;	ENTERED WHEN LOADING OR DUMPING, AND THE '*' KEY
                        ;	IS STRUCK.
                        
   0315   af            TPABT	XRA	A
   0316   d3 f9         	OUT	OP.TPC		; OFF TAPE
   0318   c3 77 01      	JMP	ERROR
                        
                        ;	TPXIT - CHECK FOR USER FORCED EDIT.
                        ;
                        ;	TPXIT CHECKS FOR AN `*` KEYPAD ENTRY. IF SO, TAKE
                        ;	THE TAPE DRIVER ABNORMAL EXIT.
                        ;
                        ;	ENTRY	NONE
                        ;	EXIT	TO *RET* IF NOT '*'
                        ;		(A) = PORT STATUS
                        ;		TO (TPERRX) IF '*' DOWN
                        ;	USES	A,F
                        
   031b   db f0         TPXIT	IN	IP.PAD
   031d   fe 6f         	CPI	01101111B	; *
   031f   db f9         	IN	IP.TPC		; READ TAPE STATUS
   0321   c0            	RNZ			; NOT '*', RETURN WITH STATUS
   0322   2a 19 20      	LHLD	TPERRX
   0325   e9            	PCHL			; ENTER (TPERRX)
                        
                        ;	SRS - SCAN RECORD START
                        ;
                        ;	SRS READS BYTES UNTIL IT RECOGNIZES THE START OF A RECORD.
                        ;
                        ;	THIS REQUIRES
                        ;	AT LEAST 10 SYNC CHARACTERS
                        ;	1 STX CHARACTER
                        ;
                        ;	THE CRC-16 IS THEN INITIALIZED.
                        ;
                        ;	ENTRY	NONE
                        ;	EXIT	TAPE POSITIONED (AND MOVING), CRCSUM=0
                        ;		(DE) = HEADER BYTES
                        ;		(HL) = RECORD COUNT
                        ;	USES	A,F,D,E,H,L
                        
   0326                 SRS
   0326   16 00         SRS1	MVI	D,0
   0328   62            	MOV	H,D
   0329   6a            	MOV	L,D		; (HL) = 0
   032a   cd 4a 03      SRS2	CALL	RNB		; READ NEXT BYTE
   032d   14            	INR	D
   032e   fe 16         	CPI	A.SYN
   0330   ca 2a 03      	JZ	SRS2		; HAVE SYN
   0333   fe 02         	CPI	A.STX
   0335   c2 26 03      	JNZ	SRS1		; NOT STX - START OVER
                        
   0338   3e 0a         	MVI	A,10
   033a   ba            	CMP	D		; SEE IF ENOUGH SYNC CHARACTERS
   033b   d2 26 03      	JNC	SRS1		; NOT ENOUGH
   033e   22 17 20      	SHLD	CRCSUM		; CLEAR CRC-16
   0341   cd 46 03      	CALL	RNP		; READ LEADER
   0344   54            	MOV	D,H
   0345   5f            	MOV	E,A
                        ;	JMP	RNP		; READ COUNT
                        
                        ;	RNP - READ NEXT PAIR.
                        ;
                        ;	RNP READS THE NEXT TWO BYTES FROM THE INPUT DEVICE.
                        ;
                        ;	ENTRY	NONE
                        ;	EXIT	(H,A) = BYTE PAIR
                        ;	USES	A,F,H
                        
   0346   cd 4a 03      RNP	CALL	RNB		; READ NEXT BYTE
   0349   67            	MOV	H,A
                        ;	JMP	RNB		; READ NEXT BYTE
                        
                        ;	RNB - READ NEXT BYTE
                        ;
                        ;	RNB READS THE NEXT SINGLE BYTE FROM THE INPUT DEVICE.
                        ;	THE CHECKSUM IS TAKEN FOR THE CHARACTER.
                        ;
                        ;	ENTRY	NONE
                        ;	EXIT	(A) = CHARACTER
                        ;	USES	A,F
                        
   034a   3e 34         RNB	MVI	A,UCI.RO+UCI.ER+UCI.RE ; TURN ON READER FOR NEXT BYTE
   034c   d3 f9         	OUT	OP.TPC
   034e   cd 1b 03      RNB1	CALL	TPXIT		; CHECK FOR *, READ STATUS
   0351   e6 02         	ANI	USR.RXR
   0353   ca 4e 03      	JZ	RNB1		; IF NOT READY
   0356   db f8         	IN	IP.TPD		; INPUT DATA
                        ;	JMP	CRC		; CHECKSUM
                        
                        
                        ;	WNP - WRITE NEXT PAIR
                        ;
                        ;	WNP WRITE THE NEXT TWO BYTES TO THE CASSETTE DRIVE.
                        ;
                        ;	ENTRY	(H,L) = BYTES
                        ;	EXIT	WRITTEN.
                        ;	USES	A,F
                        
   0358   7c            WNP	MOV	A,H
   0359   cd 5d 03      	CALL	WNB
   035c   7d            	MOV	A,L
                        ;	JMP	WNB		; WRITE NEXT BYTE
                        
                        ;	WNB - WRITE NEXT BYTE
                        ;
                        ;	WNB WRITE THE NEXT BYTE TO THE CASSETTE TAPE.
                        ;
                        ;	ENTRY	(A) = BYTE
                        ;	EXIT	NONE.
                        ;	USES	F
                        
   035d   f5            WNB	PUSH	PSW
   035e   cd 1b 03      WNB1	CALL	TPXIT		; CHECK FOR #, READ STATUS
   0361   e6 01         	ANI	USR.TXR
   0363   ca 5e 03      	JZ	WNB1		; IF MORE TO GO
   0366   3e 11         	MVI	A,UCI.ER+UCI.TE ; ENABLE TRANSMITTER
   0368   d3 f9         	OUT	OP.TPC		; TURN ON TAPE
   036a   f1            	POP	PSW
   036b   d3 f8         	OUT	OP.TPD		; OUTPUT DATA
   036d   c3 5e 06      	JMP	CRC		; COMPUTE CRC
                        
                        ;	LRA - LOCATE REGISTER ADDRESS
                        ;
                        ;	ENTRY	NONE.
                        ;	EXIT	(A) = REGISTER INDEX
                        ;		(H,L) = STORAGE ADDRESS
                        ;		(D,E) = (0,A)
                        ;	USES	A,D,E,H,L,F
                        
   0370   3a 05 20      LRA	LDA	REGI
   0373   5f            LRA.	MOV	E,A
   0374   16 00         	MVI	D,0
   0376   2a 1d 20      	LHLD	REGPTR
   0379   19            	DAD	D		; (DE) = (REGPTR)+(REGI)
   037a   c9            	RET
                        
                        ;	IOA - INPUT OCTAL NUMBER
                        ;
                        ;	ENTRY	(H,L) = ADDRESS OF RECEPTION DOUBLE BYTE.
                        ;	EXIT	TO *RET* IF ERROK
                        ;		TO *RET*+1 IF OK, VALUE IN MEMORY.
                        ;	USES	A,B,E,H,C,F
                        
   037b   cd 7f 03      IOA	CALL	IOB		; INPUT BYTE
   037e   2b            	DCX	H
                        
                        ;	IOB - INPUT OCTAL BYTE.
                        ;
                        ;	READ ONE OCTAL BYTE FROM THE KEYSET.
                        ;
                        ;	ENTRY	(H,L) = ADDRESS OF BYTE TO HOLD VALUE
                        ;		'C' SET IF FIRST DIGIT IN (A)
                        ;	EXIT	TO *RET* IF ALL OK
                        ;		TO *ERROR* IF ERROR
                        ;	USES	A,D,E,H,L,F
                        
   037f   16 03         IOB	MVI	D,3		; (D) = DIGIT COUNT
   0381   d4 25 06      IOB1	CNC	RCK		; READ CONSOLE KEYSET
                        
   0384   fe 08         	CPI	8
   0386   d2 77 01      	JNC	ERROR		; IF ILLEGAL DIGIT
                        
   0389   5f            	MOV	E,A		; (E) = VALUE
   038a   7e            	MOV	A,M
   038b   07            	RLC			; SHIFT 3
   038c   07            	RLC
   038d   07            	RLC
   038e   e6 f8         	ANI	370Q
   0390   b3            	ORA	E
   0391   77            	MOV	M,A		; REPLACE
   0392   15            	DCR	D
   0393   c2 81 03      	JNZ	IOB1		; IF NOT DONE
   0396   3e 0f         	MVI	A,30/2		; BEEP FOR 30 MS
   0398   c3 c5 02      	JMP	HORN
                        
                        ;	DOD - DECODE FOR OCTAL DISPLAY
                        ;
                        ;	ENTRY	(H,L) = ADDRESS OF LED REFRESH AREA
                        ;		(B) = *OR* PATTERN TO FORCE ON BARS OR PERIODS
                        ;		(A) = OCTAL VALUE
                        ;	EXIT	(H,L) = HEX DIGIT ADDRESS
                        ;	USES	A,B,C,D,H,L
                        
   039b   d5            DOD	PUSH	D
   039c   16 06         	MVI	D,DODA/256
   039e   0e 03         	MVI	C,3
   03a0   17            DOD1	RAL			; LEFT 3 PLACES
   03a1   17            	RAL
   03a2   17            	RAL
   03a3   f5            	PUSH	PSW		; SAVE FOR NEXT DIGIT
   03a4   e6 07         	ANI	7
   03a6   c6 54         	ADI	LOW DODA	; HRJ was DODA#256
   03a8   5f            	MOV	E,A		; (D) = INDEX
   03a9   1a            	LDAX	D		; (A) = PATTERN
   03aa   a8            	XRA	B
   03ab   e6 7f         	ANI	177Q
   03ad   a8            	XRA	B
   03ae   77            	MOV	M,A		; SET IN MEMORY
   03af   23            	INX	H
   03b0   78            	MOV	A,B
   03b1   07            	RLC
   03b2   47            	MOV	B,A
   03b3   f1            	POP	PSW		; (A) = VALUE
   03b4   0d            	DCR	C
   03b5   c2 a0 03      	JNZ	DOD1		; IF MORE TO GO
   03b8   d1            	POP	D
   03b9   c9            	RET			; RETURN
                        
                        ;	UFD - UPDATE FRONT PANEL DISPLAYS.
                        ;
                        ;	UFD IS CALLED BY THE CLOCK INTERRUPT PROCESSOR WHEN IT IS
                        ;	TIME TO UPDATE THE DISPLAY CONTENTS. CURRENTLY, THIS IS DONE
                        ;	EVERY 32 INTERRUPTS, OR ABOUT 32 TIMES A SECOND.
                        ;
                        ;	ENTRY	(H,L) = ADDRESS OF REFCNT
                        ;		(B) = MFLAG 	(gfr)
                        ;
                        ;	EXIT	NONE
                        ;	USES	ALL
                        
   03ba   3e 02         UFD	MVI	A,UO.DDU	; Disable Display Update
   03bc   a0            	ANA	B		; in MFLAG?
   03bd   c0            	RNZ			; IF NOT TO HANDLE UPDATE
                        
   03be   2e 06         	MVI	L,LOW DSPROT	; (HL) = DSPROT (same page)
   03c0   7e            	MOV	A,M		; fetch period pattern
   03c1   07            	RLC			; rotate it left
   03c2   77            	MOV	M,A		; and save
   03c3   47            	MOV	B,A
   03c4   23            	INX	H		; now point to DSPMOD
                        ;	ERRNZ	DSPMOD-DSPROT-1	; code assumes DSPMOD follows DSPROT
   03c5   7e            	MOV	A,M		; (A) = DSPMOD
   03c6   e6 02         	ANI	00000010B	; Memory display mode?
   03c8   2a 14 20      	LHLD	ABUSS
   03cb   ca e0 03      	JZ	UFD1		; IF MEMORY
                        
                        ;	Displaying registers
                        
   03ce   cd 70 03      	CALL	LRA		; LOCATE REGISTER ADDRESS
   03d1   e5            	PUSH	H
   03d2   21 48 06      	LXI	H,DSPA
   03d5   19            	DAD	D		; (H,L) = ADDRESS OF REG NAME PATTERNS
   03d6   7e            	MOV	A,M
   03d7   23            	INX	H
   03d8   66            	MOV	H,M
   03d9   6f            	MOV	L,A		; (H,L) = REG NAME PATTERN
   03da   e3            	XTHL
   03db   b4            	ORA	H		; CLEAR 'Z'
   03dc   7e            	MOV	A,M
   03dd   23            	INX	H
   03de   66            	MOV	H,M
   03df   6f            	MOV	L,A		; (HL) = ADDRESS OF REGISTER PAIR CONTENTS
                        
                        ;	Displaying Memory
                        
   03e0   f5            UFD1	PUSH	PSW
   03e1   eb            	XCHG
   03e2   21 0b 20      	LXI	H,ALEDS
   03e5   7a            	MOV	A,D
   03e6   cd 9b 03      	CALL	DOD		; FORMAT ABANK HIGH HALF
   03e9   7b            	MOV	A,E
   03ea   cd 9b 03      	CALL	DOD		; FORMAT ABANK LOW HALF
   03ed   f1            	POP	PSW
   03ee   1a            	LDAX	D
   03ef   ca 9b 03      	JZ	DOD		; IF MEMORY, DECODE BYTE VALUE
                        
                        ;	IS REGISTER, SET REGISTER NAME,
                        
   03f2   36 00         	MVI	M,0		; CLEAR DIGIT - gfr
   03f4   e1            	POP	H
   03f5   22 12 20      	SHLD	DLEDS+1
   03f8   c9            	RET
                        
                        
                        ;	I/O ROUTINES TO BE COPIED INTO AND USED IN RAM.
                        ;
                        ;	MUST CONTINUE TO 3777A FOR PROPER COPY.
                        ;	THE TABLE MUST ALSO BE BACKWARDS TO THE FINAL RAM.
                        
   03f9                 	ORG	0400H-7
                        
   03f9   01            PRSROM:	DB	1	; REFIND
   03fa   00            	DB	0	; CTLFLG
   03fb   00            	DB	0	; MFLAG
   03fc   00            	DB	0	; DSPMOD
   03fd   00            	DB	0	; DSPROT
   03fe   0a            	DB	10	; REGI
   03ff   c9            	DB	MI.RET
                        
                        
                        
                        
   0400                 	ORG	0400H
                        ;
                        ;	Here is a modified version of Jon Chapman's
                        ;	GWMON. Jumping here invokes the console monitor loop.
                        ;	All initialization code has been moved to the main
                        ;	PAM-8 section.
                        ;
                        ;	- gfr
                        ;
                        ;SM8085R1 -- GWMON-80 Small Monitor for 8085 SBC rev 1
                        ;
                        ;This customization uses the 8085's built-in serial I/O and
                        ;is configured for the Glitch Works 8085 SBC rev 1 memory
                        ;map. By Jon Chapman, Glitch Works.
                        ;
                        ;;Modified by Lee Hart for H8 Mini - 9 Aug 2026
                        ;;double semicolons denote changes from Jon Chapman's code
                        ;;resume editing at ------------
                        ;;
                        ;; other double-semicolon edits by Glenn Roberts marked 'gfr'
                        
                        ;
                        ;Hardware Equates
                        ;
                        ;;H8 Mini memory map, 27C256 32k ROM, jumper P3 in ROM position
                        ;; ROM at 0-1FFFh, 8000-FFFF (0-1FFFh mirrors 8000-9FFFh)
                        ;; RAM at 2000-7FFFh
                        
                        ; get console ready for I/O
                        ;
   0400                 GWMON	EQU	*
                        
   0400   af            	XRA	A		;NUL in A
   0401   cd dd 05      	CALL	COUT		;Clear the line
                        	
   0404   21 e6 04      	LXI	H, SIGNON$	;SM signon
   0407   cd d6 04      	CALL	PRTCLS
                        ;
                        ;WSTART -- Warm start routine
                        ;
                        ;Falls through to the command processor.
                        ;
   040a   31 00 80      WSTART: LXI	SP,STACK	; Reload stack pointer
                        
                        ;
                        ;SCP -- GWMON-80 Small Command Processor
                        ;
                        ;This is the small command processor for Glitch Works
                        ;Monitor for 8080/8085/Z80 and compatible.
                        ;
                        
                        
                        ;
                        ;CMDLP -- Small command processor loop
                        ;
                        ;Get a character from the console device and immediately 
                        ;handle it by passing off to helper function.
                        ;
                        ;Falls through to ERROR if an invalid command is specified.
                        ;
   040d   21 0a 04      CMDLP:	LXI	H,WSTART	; (HL) = warm start address
   0410   e5            	PUSH	H		; prime stack for RET
                        
   0411   21 f5 04      	LXI	H,PROMPT$	; console prompt
   0414   cd d6 04      	CALL	PRTCLS		; print it
   0417   cd 59 04      	CALL	CIN		; wait for single character
   041a   f6 20         	ORI	20H		; allow lowercase input
                        ;
                        ;	Command dispatch
                        ;
   041c   21 b3 05      	LXI	H,CMDTAB-1
   041f   23            CMDLP1:	INX	H		; Point to next valid command char
   0420   be            	CMP	M		; match?
   0421   ca 36 04      	JZ	RUNCMD		; yes, run command handler
   0424   47            	MOV	B,A		; save user entry
   0425   7e            	MOV	A,M		; examine command
   0426   b7            	ORA	A		; set flags
   0427   78            	MOV	A,B		; restore user entry
   0428   23            	INX	H		; Get past handler address
   0429   23            	INX	H
   042a   c2 1f 04      	JNZ	CMDLP1		; fall through if at end of table
                        
                        ;
                        ;ERRMSG -- Print generic error message and abort
                        ;
                        ;Falls through to PRTERR.
                        ;
   042d   21 fd 04      ERRMSG:	LXI	H,ERR$		;Fall through to PRTERR
                        
                        ;
                        ;PRTERR -- Print a null-terminated error string
                        ;
                        ;entry: HL contains pointer to start of null-terminated string
                        ;exit: string at HL printed to console
                        ;exit: program execution returned to command loop
                        ;
   0430   cd d6 04      PRTERR:	CALL	PRTCLS
   0433   c3 0a 04      	JMP	WSTART		;Warm start, restore SP
                        
                        ;
                        ;RUNCMD -- Run a command handler from CMDTAB
                        ;
                        ;entry: H register points to command letter
                        ;exit: control transferred to command handler
                        ;
   0436   cd c7 04      RUNCMD:	CALL	PRTSPC
   0439   23            	INX	H		;Point to low handler address
   043a   5e            	MOV	E,M
   043b   23            	INX	H
   043c   56            	MOV	D,M
   043d   eb            	XCHG
   043e   e9            	PCHL
                        
                        ;
                        ;GETADR -- Get a 16-bit address from the console
                        ;
                        ;pre: none
                        ;post: HL contains address from console
                        ;
   043f   cd 48 04      GETADR:	CALL	GETHEX
   0442   67            	MOV	H,A
   0443   cd 48 04      	CALL	GETHEX
   0446   6f            	MOV	L,A
   0447   c9            	RET
                        
                        ;
                        ;GETHEX -- Get byte from console as hex
                        ;
                        ;Enter at GETHE2 with character in A register from EDTCMD.
                        ;
                        ;entry: none
                        ;exit: A register contains byte from hex input
                        ;exit: Carry flag set if non-hex character received
                        ;
   0448   cd 59 04      GETHEX:	CALL	CIN
   044b   e5            GETHE2:	PUSH	H
   044c   67            	MOV	H,A
   044d   cd 59 04      	CALL	CIN
   0450   6f            	MOV	L,A
   0451   cd 5f 04      	CALL	HEXBYT
   0454   e1            	POP	H
   0455   da 2d 04      	JC	ERRMSG		;Invalid hex char, abort
   0458   c9            	RET
                        ;;end of INCLUDE 'SCP.INC'
                        					
                        ;;	INCLUDE	'common.inc' (included inline)
                        ;
                        ;COMMON -- Functions Common to SM and XM
                        ;
                        ;These functions are used by both the SM and XM versions
                        ;of GWMON-80.
                        ;
                        
                        
                        ;
                        ;CIN -- Get a char from the console and echo
                        ;
                        ;Returns through COUT.
                        ;
                        ;entry: console device is initialized
                        ; exit: received char is in A register
                        ;		received char is echoed
                        ;
   0459   cd c7 05      CIN:	CALL	CINNE
   045c   c3 dd 05      	JMP	COUT
                        
                        ;
                        ;HEXBYT -- Convert pair of ASCII characters to byte
                        ;
                        ;entry: H register contains high ASCII coded hex nybble
                        ;		L register contains low ASCII coded hex nybble
                        ; exit: A register contains converted byte
                        ;		CY flag set if non-hex character input
                        ;		Z flag set if conversion results in 0x00
                        ;
   045f   7c            HEXBYT:	MOV	A,H
   0460   cd 70 04      	CALL	ASCHEX
   0463   d8            	RC
   0464   07            	RLC
   0465   07            	RLC
   0466   07            	RLC
   0467   07            	RLC
   0468   67            	MOV	H,A
   0469   7d            	MOV	A,L
   046a   cd 70 04      	CALL	ASCHEX
   046d   d8            	RC
   046e   b4            	ORA	H
   046f   c9            	RET
                        
                        ;
                        ;ASCHEX -- Convert ASCII character to hex nybble
                        ;
                        ;entry: A register contains ASCII coded nybble
                        ; exit: A register contains nybble
                        ;		CY flag set if ASCII character is invalid hex
                        ;
   0470   d6 30         ASCHEX:	SUI	'0'		; remove ASCII bias
   0472   d8            	RC			; Return error if less than 0
   0473   fe 0a         	CPI	10		; check for hex
   0475   3f            	CMC			; Clear CY
   0476   f8            	RM			; if [0..9] ... done
   0477   e6 5f         	ANI	01011111B	; Upper case
   0479   d6 07         	SUI	'A'-'9'-1	; ASCII to hex bias
   047b   fe 10         	CPI	16		; check for hexadecimal range
   047d   3f            	CMC			; return error if >= 16
   047e   c9            	RET
                        
                        ;
                        ;HEXDMP -- Hex dump memory to console
                        ;
                        ;This routine prints the contents of memory starting at HL
                        ;and ending at DE in 16-byte blocks.
                        ;
                        ;entry: HL register pair contains starting address
                        ;		DE register pair contains ending address
                        ; exit:	contents of memory printed to console
                        ;
   047f   06 00         HEXDMP:	MVI	B,0		;Initialize B as completion flag
                        
   0481   cd a2 04      HEXDM1:	CALL	PRTADR
   0484   0e 10         	MVI	C,16		;C = line loop counter
   0486   cd c7 04      HEXDM2:	CALL	PRTSPC
   0489   cd b2 04      	CALL	DMPLOC
   048c   7b            	MOV	A,E		;A = low byte of end address
   048d   bd            	CMP	L		;Compare current low byte
   048e   c2 97 04      	JNZ	HEXDM3
   0491   7a            	MOV	A,D		;A = high byte of end address
   0492   bc            	CMP	H		;Compare current high byte
   0493   c2 97 04      	JNZ	HEXDM3
   0496   05            	DCR	B		;B = nonzero, done
                        
   0497   23            HEXDM3:	INX	H		;Increment current address pointer
   0498   0d            	DCR	C
   0499   c2 86 04      	JNZ	HEXDM2		;Print more lines
                        
   049c   78            	MOV	A,B
   049d   b7            	ORA	A
   049e   ca 81 04      	JZ	HEXDM1		;Yes, dump more memory
   04a1   c9            	RET			;No, done
                        
                        ;
                        ;PRTADR -- Print an address to the console
                        ;
                        ;Prints CR, LF, a 16-bit address, a space, and a colon. 
                        ;Destroys A register contents.
                        ;
                        ;Returns through COUT.
                        ;
                        ;entry: HL pair contains address to print
                        ; exit: HL printed to console as hex
                        ;
   04a2   cd cc 04      PRTADR: CALL	CRLF
   04a5   7c            	MOV	A,H
   04a6   cd b3 04      	CALL	PRTHEX
   04a9   7d            	MOV	A,L
   04aa   cd b3 04      	CALL	PRTHEX
   04ad   3e 3a         	MVI	A,':'
   04af   c3 dd 05      	JMP	COUT
                        
                        ;
                        ;DMPLOC -- Print a byte at HL to console
                        ;
                        ;Falls through to PRTHEX.
                        ;
                        ;pre: HL pair contains address of byte
                        ;post: byte at HL printed to console
                        ;
   04b2   7e            DMPLOC:	MOV	A,M
                        
                        ;
                        ;PRTHEX -- Output byte to console as hex
                        ;
                        ;Falls through to PRTNIB.
                        ;
                        ;entry: A register contains byte to be output
                        ; exit: byte is output to console as hex
                        ;
   04b3   f5            PRTHEX: PUSH	PSW		;Save A register on stack
   04b4   0f            	RRC			;Rotate high nybble down
   04b5   0f            	RRC
   04b6   0f            	RRC
   04b7   0f            	RRC
   04b8   cd bc 04      	CALL	PRTNIB		;Print high nybble
   04bb   f1            	POP	PSW		;Restore A register
                        
                        ;
                        ;PRTNIB -- Print hex nybble on console
                        ;
                        ;Returns through COUT.
                        ;
                        ;entry: A register contains nybble
                        ; exit: nybble printed to console
                        ;
   04bc   e6 0f         PRTNIB:	ANI	0FH		;Mask off low nybble
   04be   c6 90         	ADI	90H
   04c0   27            	DAA
   04c1   ce 40         	ACI	40H
   04c3   27            	DAA
   04c4   c3 dd 05      	JMP	COUT
                        
                        ;
                        ;PRTSPC -- Print a space to the console
                        ;
                        ;Returns through COUT.
                        ;
                        ;pre: none
                        ;post: ASCII space printed to console
                        ;
   04c7   3e 20         PRTSPC:	MVI	A,' '
   04c9   c3 dd 05      	JMP	COUT
                        
                        ;
                        ;CRLF -- Print a CR, LF
                        ;
                        ;Returns through COUT.
                        ;
                        ;entry: none
                        ; exit: CR, LF printed to console
                        ;
   04cc   3e 0d         CRLF:	MVI	A,CR
   04ce   cd dd 05      	CALL	COUT
   04d1   3e 0a         	MVI	A,LF
   04d3   c3 dd 05      	JMP	COUT
                        ;
                        ;PRTCLS -- Print CR, LF, and a high bit terminated string
                        ;
                        ;Falls through to PRTSTR
                        ;
                        ;entry: HL contains pointer to start of string
                        ; exit: CR, LF, and string at HL printed to console
                        ;
   04d6   cd cc 04      PRTCLS:	CALL	CRLF
                        
                        ;
                        ;PRTSTR -- Print a high bit terminated string
                        ;
                        ;Destroys contents of A register.
                        ;
                        ;entry: HL contains pointer to start of string
                        ; exit: string at HL printed to console
                        ;
   04d9   7e            PRTSTR:	MOV	A, M
   04da   e6 7f         	ANI	07FH		;Strip high bit
   04dc   cd dd 05      	CALL	COUT
   04df   7e            	MOV	A,M
   04e0   b7            	ORA	A		;Set flags
   04e1   f8            	RM			;High bit set, done
   04e2   23            	INX	H
   04e3   c3 d9 04      	JMP	PRTSTR
                        ;;end of INCLUDE 'common.inc'
                        
                        ;; ---------------------
                        ;;
                        ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        ;Small Monitor Strings
                        ;
                        ;These strings are terminated by setting the high bit in the
                        ;last character.
                        ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   04e6   47 57 4d 4f   SIGNON$:	DB 'GWMON-80 1.1 S', 'M' + 80H
   04ea   4e 2d 38 30   
   04ee   20 31 2e 31   
   04f2   20 53 cd      
   04f5   0a be         PROMPT$:	DB LF, '>' + 80H
   04f7   43 4b 53 55   CSERR$:		DB 'CKSUM '
   04fb   4d 20         
   04fd   45 52 52 4f   ERR$:		DB 'ERRO', 'R' + 80H
   0501   d2            
                        
                        ;;end of INCLUDE 'sm.inc'
                        
                        ;;	INCLUDE	'scmdstd.inc'	;SM standard commands
                        ;
                        ;SCMDSTD -- Small Monitor Standard Commands
                        ;
                        ;This file contains implementations of all standard SM
                        ;commands. The command table is located at the end of the
                        ;file.
                        ;
                        
                        ;
                        ;HDCMD -- Hex dump command
                        ;
   0502   cd 3f 04      HDCMD:	CALL	GETADR		;HL = start address
   0505   eb            	XCHG			;DE = start address
   0506   cd c7 04      	CALL	PRTSPC
   0509   cd 3f 04      	CALL	GETADR		;HL = end address
   050c   eb            	XCHG			;HL = start, DE = end
   050d   c3 7f 04      	JMP	HEXDMP		;Return through HEXDMP
                        
                        ;
                        ;EDTCMD -- Edit memory command
                        ;
                        ;Breaks out to main command loop through GETHEX jump to
                        ;WSTART.
                        ;
   0510   cd 3f 04      EDTCMD:	CALL	GETADR		;HL = address to open
   0513   cd a2 04      EDTCM1:	CALL	PRTADR		;Print location address
   0516   cd c7 04      	CALL	PRTSPC
   0519   cd b2 04      	CALL	DMPLOC		;Print contents of location
   051c   cd c7 04      	CALL	PRTSPC
   051f   cd 59 04      	CALL	CIN		;Get user input
   0522   fe 0d         	CPI	NEXTLOC		;Check for NEXTLOC character
   0524   ca 31 05      	JZ	EDTCM2		;Yes, go to next location
   0527   cd 4b 04      	CALL	GETHE2		;No, process as hex input
   052a   77            	MOV	M,A
   052b   cd c7 04      	CALL	PRTSPC
   052e   cd b2 04      	CALL	DMPLOC		;Print contents of location (verification)
   0531   23            EDTCM2:	INX	H
   0532   c3 13 05      	JMP	EDTCM1
                        
                        ;
                        ;GOCMD -- Call out to a specified address
                        ;
                        ;The stack is primed with the GWMON-80 warm start address.
                        ;Called program can return control to GWMON-80 through a RET
                        ;as long as the stack is not disturbed.
                        ;
   0535   cd 3f 04      GOCMD:	CALL	GETADR		;HL = Address to call
   0538   e9            	PCHL			;Go to specified address
                        
                        ;
                        ;INPCMD -- Input to port command; print value to console
                        ;
                        ;	Revised to use PAM-8 port I/O routine
                        ;		-gfr
                        ;
   0539   cd 48 04      INPCMD:	CALL	GETHEX		; Get port from console
   053c   6f            	MOV	L,A		; save in (L)
   053d   cd c7 04      	CALL	PRTSPC		; space separator
   0540   cd 26 02      	CALL	IN		; input via PAM-8 IN routine
   0543   c3 b3 04      	JMP	PRTHEX		; display the result
                        
                        ;
                        ;OUTCMD -- Output to port command
                        ;
                        ;	Revised to use PAM-8 port I/O routine
                        ;		-gfr
                        ;
   0546   cd 48 04      OUTCMD:	CALL	GETHEX		; get port number
   0549   6f            	MOV	L,A		; (L) = port
   054a   cd c7 04      	CALL	PRTSPC		; space separator
   054d   cd 48 04      	CALL	GETHEX		; get value to output
   0550   67            	MOV	H,A		; (H) = value
   0551   c3 29 02      	JMP	OUT		; output via PAM-8 OUT routine
                        
                        ;
                        ;LODCMD -- Load an Intel HEX file from console
                        ;
                        ;This loader accepts data with both CR (*NIX) and
                        ;CR,LF (DOS/Windows) terminated lines.
                        ;
                        ;Intel HEX record may be ended with:
                        ;   * DATA (0x00) record with length of 0
                        ;   * Any nonzero record type
                        ;
                        ; exit: Intel HEX file loaded, or error printed
                        ;
                        ; First suspend all clock interrupts (RST 7.5) and clear LEDs. We leave
                        ; other interrupts running in anticipation of interrupt-driven serial
                        ; I/O in the future.
                        ;
   0554   20            LODCMD:	RIM			; Read interrupt mask
   0555   e6 03         	ANI	00000011B	; leave 5.5 and 6.5 alone
   0557   f6 0c         	ORI	00001100B	; 7.5 HIGH (interrupts off)
   0559   30            	SIM			; set new mask
                        	
   055a   cd 01 06      	CALL	BLANK		; blank the LEDs
                        ;
                        ;	Loop over records
                        ;
   055d   cd cc 04      LODCM0:	CALL	CRLF		; start a new ouput line
   0560   cd c7 05      LODCM1:	CALL	CINNE		; read a byte
   0563   fe 3a         	CPI	':'		; all records start with ':'
   0565   c2 60 05      	JNZ	LODCM1		; Wait for start colon
                        ;
                        ;	Have new record
                        ;
   0568   cd dd 05      	CALL	COUT		; Print starting colon
   056b   cd 48 04      	CALL	GETHEX		; Get record length
   056e   ca 94 05      	JZ	LODCM4		; Length == 0, done
   0571   47            	MOV	B,A		; Record length in B
   0572   4f            	MOV	C,A		; Start checksumming in C
                        
   0573   cd 3f 04      	CALL	GETADR		; HL = 16-bit starting address
   0576   81            	ADD	C		; A == L from GETADR
   0577   84            	ADD	H
   0578   4f            	MOV	C,A		; Checksum
                        
   0579   cd 48 04      	CALL	GETHEX		; Get record type
   057c   c2 94 05      	JNZ	LODCM4		; Not Record Type 00 (DATA), done
                        ;
                        ;	Process the record
                        ;
   057f   cd 48 04      LODCM2:	CALL	GETHEX		; This record processing loop
   0582   77            	MOV	M,A		; Store char at HL
   0583   81            	ADD	C
   0584   4f            	MOV	C,A		; update checksum
   0585   23            	INX	H		; point to next destination
   0586   05            	DCR	B		; decrement the line count
   0587   c2 7f 05      	JNZ	LODCM2		; Not done with the line
                        	
   058a   cd 48 04      LODCM3:	CALL	GETHEX		; Get checksum byte
   058d   81            	ADD	C
   058e   c2 9f 05      	JNZ	CSUMER		; Checksum bad, print error
   0591   c3 5d 05      	JMP	LODCM0		; Process more records
                        ;
                        ;	Done getting data, eat remaining characters.
                        ;
   0594   cd 59 04      LODCM4:	CALL	CIN		; grab a byte
   0597   fe 0a         	CPI	LF		; end of line?
   0599   c2 94 05      	JNZ	LODCM4		; No LF, keep eating
   059c   c3 a5 05      	JMP	LODEXT		; Got LF, done!
                        ;
                        ;	Checksum error
                        ;
   059f   21 f7 04      CSUMER:	LXI	H,CSERR$	; Print checksum error to console
   05a2   cd 30 04      	CALL	PRTERR
                        ;
                        ;	Exit, reenable clock interrupts and LED refresh.
                        ;
   05a5   20            LODEXT:	RIM			; Read interrupt mask
   05a6   e6 03         	ANI	00000011B	; leave 5.5 and 6.5 alone
   05a8   f6 08         	ORI	00001000B	; 7.5 LOW (interrupts on)
   05aa   30            	SIM			; set new mask
                        
   05ab   3a 08 20      	LDA	MFLAG		; get MFLAG byte
   05ae   e6 bf         	ANI	377Q-UO.NFR	; turn on FP refresh
   05b0   32 08 20      	STA	MFLAG		; save it
   05b3   c9            	RET			; and done...
                        
                        ;
                        ;	CMDTAB -- Table/array of commands
                        ;
                        ;	Table entry structure:
                        ;	  * Single command character, lowercase only (0x00 = end)
                        ;	  * Pointer to implementation routine
                        ;
   05b4   64            CMDTAB:	DB	'd'
   05b5   02 05         	DW	HDCMD
   05b7   65            	DB	'e'
   05b8   10 05         	DW	EDTCMD
   05ba   67            	DB	'g'
   05bb   35 05         	DW	GOCMD
   05bd   69            	DB	'i'
   05be   39 05         	DW	INPCMD
   05c0   6c            	DB	'l'
   05c1   54 05         	DW	LODCMD
   05c3   6f            	DB	'o'
   05c4   46 05         	DW	OUTCMD
                        	
   05c6   00            NULCMD:	DB	0		; terminate command list
                        
                        				;;end of INCLUDE 'scmdnull.inc'
                        ;;---------------
                        ;;	INCLUDE	'8085sio1.inc'	;Intel 8085 SID/SOD driver
                        ;
                        ;8085SIO1 -- Console I/O Drivers for 8085 Built-In Serial
                        ;
                        ;
                        
                        	
                        ;
                        ;	CINNE -- Get a char from the console, no echo
                        ;
                        ;	Since serial I/O is interrupt-driven we simply
                        ;	look to see if a byte is available. If not, we wait
                        ;	otherwise return the byte and reset the NBYTES count.
                        ;	Put interrupts on hold while we're playing with these
                        ;	values
                        ;
                        
   05c7   3a 37 20      CINNE:	LDA	NBYTES		; get byte count
   05ca   b7            	ORA	A		; test for zero
   05cb   ca c7 05      	JZ	CINNE		; loop if nothing there
                        ;
                        ;	we have a byte, load it and return
                        ;
   05ce   f3            	DI			; don't step on the IRQ handler
   05cf   af            	XRA	A		; zero the count
   05d0   32 37 20      	STA	NBYTES		; save it
   05d3   3a 36 20      	LDA	IOBYTE		; fetch the byte
   05d6   fb            	EI
                        	
   05d7   fe 03         	CPI	CANCEL		; Check for CANCEL character
   05d9   ca 0a 04      	JZ	WSTART		; Yes, warm start monitor
   05dc   c9            	RET
                        	
                        ;	PUSH	H
                        ;	LXI	H,NBYTES	; point to counter
                        ;	
                        ;
                        ;	Here we just wait for a start bit. This should happen
                        ;	before disabling interrupts - gfr
                        ;
                        ;CI1:	RIM			; read RIN signal
                        ;	ANI	080h		; check for start bit
                        ;	JZ	CI1		; wait 'til we get one...
                        ;
                        ;	Incoming data... here we go!
                        ;
                        ;	DI			;Must disable interrupts
                        ;	MVI	B,9		;Receive bits counter
                        ;
                        ;
                        ;	LXI	H,HALFBIT	;Delay one half-bit time, this puts
                        ;CI2:	DCR	L		;us in the middle of the start bit
                        ;	JNZ	CI2
                        ;	DCR	H
                        ;	JNZ	CI2
                        ;;
                        ;;	Now start reading the byte - gfr
                        ;;
                        ;CI3:	LXI	H,BITTIME	;Delay one bit-time, since we are shifted
                        ;CI4:	DCR	L		;a half-bit time through the start bit, this
                        ;	JNZ	CI4		;will keep us in the middle of bits for
                        ;	DCR	H		;reliable sampling.
                        ;	JNZ	CI4
                        ;
                        ;	RIM			;Read the SID line
                        ;	CMA			; invert for H8 Mini - gfr
                        ;	RAL			; CY = data bit (invert for H8 Mini)
                        ;	DCR	B		; Determine if this is a stop bit
                        ;	JZ	CI5		; Stop bit, done with char receive (invert H8 Mini)
                        ;
                        ;	MOV	A,C		;Not done, rotate a bit in CY into C
                        ;	RAR
                        ;	MOV	C,A
                        ;	NOP			;Equalize COUT and CINNE loop times
                        ;	JMP	CI3		;Get more bits
                        ;
                        ;CI5:	POP	H		;Restore HL
                        ;	MOV	A,C		;A = received character
                        ;	POP	B		;Restore BC
                        ;	EI
                        ;	CPI	CANCEL		;Check for CANCEL character
                        ;	JZ	WSTART		;Yes, warm start monitor
                        ;	RET
                        
                        ;
                        ;COUT -- Output a character to the console
                        ;
                        ;This routine *must* preserve the contents of the A register
                        ;or CIN will not function properly.
                        ;
                        ;Interrupts are disabled to maintain critical timing in this
                        ;routine. They are unconditionally re-enabled before return.
                        ;
                        ;entry: A register contains char to be printed
                        ;		BITTIME, HALFBIT are initialized
                        ; exit: character is printed to the console
                        ;		interrupts are enabled
                        ;
   05dd   f5            COUT:	PUSH	PSW		;Preserve char in A
   05de   c5            	PUSH	B		;Preserve registers
   05df   e5            	PUSH	H
   05e0   f3            	DI			;Must disable interrupts
   05e1   4f            	MOV	C,A		;C = character to output
   05e2   af            	XRA	A		;Clear CY
   05e3   06 0a         	MVI	B,10		;Bit count for entire serial transaction (10 - gfr)
                        
   05e5   3e 80         CO1:	MVI	A,80H		;Set what will become SOD enable bit
   05e7   1f            	RAR			;Move CY into SOD data bit
   05e8   30            	SIM			;Output it on SOD
   05e9   21 37 01      	LXI	H,BITTIME	;Delay one bit time
   05ec   2d            CO2:	DCR	L
   05ed   c2 ec 05      	JNZ	CO2
   05f0   25            	DCR	H
   05f1   c2 ec 05      	JNZ	CO2
                        
   05f4   37            	STC			;Set CY, will become stop bit	
   05f5   79            	MOV	A,C		
   05f6   1f            	RAR			;Get a bit from the byte to output into CY
   05f7   4f            	MOV	C,A
   05f8   05            	DCR	B		;Decrement bit count
   05f9   c2 e5 05      	JNZ	CO1		;Not done, send more bits
                        		
   05fc   e1            	POP	H		;Restore registers
   05fd   c1            	POP	B
   05fe   fb            	EI
                        
   05ff   f1            	POP	PSW		;A = char printed
   0600   c9            	RET
                        
                        ;	END GWMON Code
                        
                        ;
                        ;	BLANK - ensure that all LED segments are extinguished.
                        ;
                        ;	This is useful when interrupts are disabled for any noticeable period of
                        ;	time, otherwise some LED segments will appear to be "stuck" on (as the
                        ;	interrupt-driven refresh cycle was stopped mid refresh.)  Typically
                        ;	immediately preceded by a DI instruction.
                        ;
                        ;	USES:	A,F
                        ;
   0601   c5            BLANK:	PUSH	B		; BC used for working storage
                        
   0602   db f0         	IN	PPI+IO.A	; read port A settings
   0604   e6 f0         	ANI	11110000B	; clear LED selects (PA0..PA3)
   0606   47            	MOV	B,A		; save it
   0607   0e 09         	MVI	C,9		; 9 LEDs, work right to left
   0609   81            BLOOP:	ADD	C		; address an LED
   060a   d3 f0         	OUT	PPI+IO.A	; select it
   060c   af            	XRA	A		; zero = all segments off
   060d   d3 f1         	OUT	PPI+IO.B	; turn off all segments
   060f   78            	MOV	A,B		; get back mask
   0610   0d            	DCR	C		; count down
   0611   c2 09 06      	JNZ	BLOOP		; and loop through all 9
                        
   0614   c1            	POP	B
   0615   c9            	RET
                        
                        
                        ;	DLYNOI - Delay with No Interrupts. Delays the specified number of
                        ;	2ms intervals, e.g. if A = 100/2 then delay 100 ms.
                        ;
                        ;	Functionally equivalent to the original Heath DLY routine
                        ;	but for use when interrupts are disabled. Uses simple nested
                        ;	loop counters to delay.
                        ;
                        ;	Timing parameters are tuned for an 8085 running at 2Mhz.
                        ;
                        ;	USES:	A,F
                        ;
                        ; =====================================================================
   0616   c5            DLYNOI:	PUSH	B		; BC used for working storage
   0617   47            	MOV	B,A		; B = outer loop counter
                        ;
                        ;	Each inner loop takes 18 T-states or 9 uS of time. 222 repetitions
                        ;	gives 1,998 uS of time.
                        ;
   0618   0e de         OUTER:	MVI	C,222		; 222 * 9 ~= 2 ms
   061a   00            INNER:	NOP			; kill time (4 T-states)
   061b   0d            	DCR	C		; decrement inner counter (4 T-states)
   061c   c2 1a 06      	JNZ	INNER		; count down (10 T-states each jump)
                        	
   061f   05            	DCR	B		; decrement outer counter
   0620   c2 18 06      	JNZ	OUTER		; loop 'til done
                        	
   0623   c1            	POP	B		; restore BC
   0624   c9            	RET
                        
                        ;	RCK - Read Console Keypad
                        ;
                        ;	RCK is called to read a keystroke from the console keypad.
                        ;	Read operations are blocking - the routine will wait until a key
                        ;	is pressed before returning.
                        ;
                        ;	This version differs substantially from the original PAM/8 version.
                        ;	The H8 Mini multiplexes the LED panel refresh with keypad reads. Reading a
                        ;	keystroke, therefore, is broken into two components: an interrupt-time
                        ;	service routine (PCK) and a task-time routine to return the result (RCK).
                        ;	Probe Console Keypad (PCK) is called at each 2ms interrupt, however it takes
                        ;	9 calls to scan all possible keys, therefore it can take up to 18ms to
                        ;	detect and return a keystroke.
                        ;
                        ;	RCK performs debouncing, and auto-repeat. a *bip* is sounded
                        ;	when a value is accepted.
                        ;
                        ;	EXIT:	Key value in (A):
                        ;
                        ;	Key	  Value (decimal)
                        ;	0-9		0-9
                        ;	'+'		10
                        ;	'-'		11
                        ;	'*'		12
                        ;	'/'		13
                        ;	'#'		14
                        ;	'.'		15
                        ;
                        ;	USES	A,F
                        ;
   0625   e5            RCK:	PUSH	H
   0626   c5            	PUSH	B
                        	
   0627   0e 28         	MVI	C,ARDLY/DBDLY	; loop for auto-repeat
   0629   21 16 20      	LXI	H,RCKA		; point to keypad byte
                        ;
                        ;	First wait for some keyboard action
                        ;
   062c   3a 34 20      RCK1:	LDA	PCKVAL		; get most recent key hit
   062f   47            	MOV	B,A		; save it
   0630   3e 05         	MVI	A,DBDLY/2	; delay to debounce
   0632   cd 53 00      	CALL	DLY
   0635   78            	MOV	A,B		; get back candidate
                        	
   0636   be            	CMP	M		; compare to RCKA
   0637   c2 3e 06      	JNZ	RCK2		; have a change
   063a   0d            	DCR	C		; wait N cycles (auto repeat)
   063b   c2 2c 06      	JNZ	RCK1		; changed, start over
                        
   063e   77            RCK2:	MOV	M,A
   063f   b7            	ORA	A		; set flag bits
   0640   fa 2c 06      	JM	RCK1		; bit 7 set... no key pressed
                        ;
                        ;	have a key
                        ;	
                        ;
                        ;	Make noise here...
                        ;
   0643   e6 0f         	ANI	17Q		; make sure it's 4 bits
                        	
   0645   c1            	POP	B
   0646   e1            	POP	H
   0647   c9            	RET
                        
                        ;	DISPLAY SEGMENT CODING:
                        ;
                        ;	BYTE = 76 5453 210
                        ;
                        ;	   1
                        ;	  ---
                        ;	6|   |2
                        ;	 | 0 |
                        ;	  ---
                        ;	5|   |3
                        ;	 |   |
                        ;	  --- o7
                        ;	   4
                        
                        ;	Register index to 7-segment pattern
                        ;
                        ;	NOTE: H8 Mini is inverse of H8
                        
   0648   5b 67         DSPA:	DW	675BH		; SP
   064a   6f 63         	DW	636FH		; AF
   064c   79 72         	DW	7279H		; BC
   064e   3d 73         	DW	733DH		; DE
   0650   6d 70         	DW	706DH		; HL
   0652   67 31         	DW	3167H		; PC
                        
                        ;	Octal to 7-segment pattern
                        ;
                        ;	NOTE: H8 Mini is inverse of H8
                        
                        
   0654   7e            DODA:	DB	7EH		; 0
   0655   0c            	DB	0CH		; 1
   0656   37            	DB	37H		; 2
   0657   1f            	DB	1FH		; 3
   0658   4d            	DB	4DH		; 4
   0659   5b            	DB	5BH		; 5
   065a   7b            	DB	7BH		; 6
   065b   0e            	DB	0EH		; 7
   065c   7f            	DB	7FH		; 8
   065d   5f            	DB	5FH		; 9
                        	
                        ;
                        ;	CRC - COMPUTE CRC-16
                        ;
                        ;	CRC COMPUTES A CRC-16 CHECKSUM FOR THE POLYNOMIAL
                        ;
                        ;	(X + 1) * (X^15 + X + 1)
                        ;
                        ;	SINCE THE CHECKSUM GENERATED IS A DIVISION REMAINDER,
                        ;	A CHECKSUMED DATA SEQUENCE CAN BE VERIFIED BY RUNNING
                        ;	THE DATA THROUGH CRC, AND THEN RUNNING THE PREVIOUSLY OBTAINED
                        ;	CHECKSUM THROUGH CRC. THE RESULTANT CHECKSUM SHOULD BE 0.
                        ;
                        ;	ENTRY	(CRCSUM) = CURRENT CHECKSUM
                        ;		(A) = BYTE
                        ;	EXIT	(CRCSUM) UPDATED
                        ;		(A) UNCHANGED
                        ;	USES	F
                        
   065e   c5            CRC	PUSH	B		; SAVE (BC)
   065f   06 08         	MVI	B,8		; (B) = BIT COUNT
   0661   e5            	PUSH	H
   0662   2a 17 20      	LHLD	CRCSUM
   0665   07            CRC1	RLC
   0666   4f            	MOV	C,A		; (C) = BIT
   0667   7d            	MOV	A,L
   0668   87            	ADD	A
   0669   6f            	MOV	L,A
   066a   7c            	MOV	A,H
   066b   17            	RAL
   066c   67            	MOV	H,A
   066d   17            	RAL
   066e   a9            	XRA	C
   066f   0f            	RRC
   0670   d2 7b 06      	JNC	CRC2		; IF NOT TO XOR
   0673   7c            	MOV	A,H
   0674   ee 80         	XRI	200Q
   0676   67            	MOV	H,A
   0677   7d            	MOV A,L
   0678   ee 05         	XRI	5Q
   067a   6f            	MOV	L,A
   067b   79            CRC2	MOV	A,C
   067c   05            	DCR	B
   067d   c2 65 06      	JNZ	CRC1		; IF MORE TO GO
   0680   22 17 20      	SHLD	CRCSUM
   0683   e1            	POP	H		; RESTORE (HL)
   0684   c1            	POP	B		; RESTORE (BC)
   0685   c9            	RET			; EXIT
                        
                        ;	LOAD - LOAD MEMORY FROM TAPE
                        ;
                        ;	READ THE NEXT RECORD FROM THE CASSETTE TAPE.
                        ;
                        ;	USE THE LOAD ADDRESS IN THE TAPE RECORD.
                        ;
                        ;	ENTRY	(HL) = ERROR EXIT ADDRESS
                        ;	EXIT	USER P-REG (IN STACK) SET TO ENTRY ADDRESS
                        ;		TO CALLER IF ALL OK
                        ;		TO ERROR EXIT IF TAPE ERRORS DETECTED.
                        
   0686   01 00 fe      LOAD	LXI	B,177000Q	 ; 400Q-RT.MI*256-256 (BC) = - REQUIRED TYPE AND #
   0689   cd 26 03      LOA0	CALL	SRS		; SCAN FOR RECORD START
   068c   6f            	MOV	L,A		; (HL) = COUNT
   068d   eb            	XCHG			; (DE) = COUNT, (HL) = TYPE AND #
   068e   0d            	DCR	C		; (C) = - NEXT #
   068f   09            	DAD	B
   0690   7c            	MOV	A,H
   0691   c5            	PUSH	B		; SAVE TYPE AND #
   0692   f5            	PUSH	PSW		; SAVE TYPE CODE
   0693   e6 7f         	ANI	177Q		; CLEAR END FLAG BIT
   0695   b5            	ORA	L
   0696   3e 02         	MVI	A,2		; SEQUENCE ERROR
   0698   c2 f6 02      	JNZ	TPERR		; IF NOT RIGHT TYPE OF SEQUENCE
   069b   cd 46 03      	CALL	RNP		; READ ADDR
   069e   44            	MOV	B,H
   069f   4f            	MOV	C,A		; (BC) = P-REG ADDRESS
   06a0   3e 0a         	MVI	A,10
   06a2   d5            	PUSH	D		; SAVE (DE)
   06a3   cd 73 03      	CALL	LRA.		; LOCATE REG ADDRESS
   06a6   d1            	POP	D		; RESTORE (DE)
   06a7   71            	MOV	M,C		; SET P-REG IN MEM
   06a8   23            	INX	H
   06a9   70            	MOV	M,B
   06aa   cd 46 03      	CALL	RNP		; READ ADDRESS
   06ad   6f            	MOV	L,A		; (HL) = ADDRESS, (DE) = COUNT
   06ae   22 00 20      	SHLD	START
                        
   06b1   cd 4a 03      LOA1	CALL	RNB		; READ BYTE
   06b4   77            	MOV	M,A
   06b5   22 14 20      	SHLD	ABUSS		; SET ABUSS FOR DISPLAY
   06b8   23            	INX	H
   06b9   1b            	DCX	D
   06ba   7a            	MOV	A,D
   06bb   b3            	ORA	E
   06bc   c2 b1 06      	JNZ	LOA1		; IF MORE TO GO
                        
   06bf   cd eb 02      	CALL	CTC		; CHECK TAPE CHECKSUM
                        
                        ;	READ NEXT BLOCK
                        
   06c2   f1            	POP	PSW		; (A) = FILE TYPE BYTE
   06c3   c1            	POP	B		; (BC) = -(LAST TYPE, LAST #0
   06c4   07            	RLC
   06c5   da c0 02      	JC	TFT		; ALL DONE - TURN OFF TAPE
   06c8   c3 89 06      	JMP	LOA0		; READ ANOTHER RECORD
                        
                        ;
                        ;	PAM-8 uses the first 64 bytes of RAM for working space
                        ;
                        ;	THE FOLLOWING ARE CONTROL CELLS AND FLAGS USED BY THE KEYPAD
                        ;	MONITOR.
                        
   2000                 	ORG	2000H	; 8192 = beginning of RAM
                        	
   2000                 START	DS	2	; DUMP STARTING ADDRESS
                        ;
                        ;	These two bytes are updated in real time to be either
                        ;	IN or OUT instructions and the associated port - gfr
                        ;
   2002                 IOWRK	DS	2	; IN OR OUT INSTRUCTION
                        ;
                        ;	The following locations are initialized from PRSROM - gfr
                        ;
   2004                 PRSRAM	DS	1	; RET (from IOWRK)
                        
                        ;
                        ;	REGI:	2	AF
                        ;		4	BC
                        ;		6	DE
                        ;		8	HL
                        ;		A	Pc
                        ;
   2005                 REGI	DS	1	; INDEX OF REGISTER UNDER DISPLAY
   2006                 DSPROT	DS	1	; PERIOD FLAG BYTE
   2007                 DSPMOD	DS	1	; DISPLAY MODE (if bit 0 set then in Alter mode)
                        
   2008                 MFLAG	DS	1	; USER FLAG OPTIONS
                        			; SEE *UI.XXX* BITS DESCRIBED AT FRONT
                        
   2009                 CTLFLG	DS	1	; FRONT PANEL CONTROL BITS
   200a                 REFIND	DS	1	; REFRESH INDEX (0 TO 7)
   0007                 PRSL	EQU	7	; END OF AREA INITIALIZED FROM ROM
                        
                        
                        
   200b                 FPLEDS			; FRONT PANEL LED PATTERNS
   200b                 ALEDS	DS	1	; ADDR 0
   200c                 	DS	1	; ADDR 1
   200d                 	DS	1	; ADDR 2
                        
   200e                 	DS	1	; ADDR 3
   200f                 	DS	1	; ADDR 4
   2010                 	DS	1	; ADDR 5
                        
   2011                 DLEDS	DS	1	; DATA 0
   2012                 	DS	1	; DATA 1
   2013                 	DS	1	; DATA 2
                        
   2014                 ABUSS	DS	2	; ADDRESS BUS
   2016                 RCKA	DS	1	; RCK SAVE AREA
   2017                 CRCSUM	DS	2	; CRC-16 CHECKSUM
   2019                 TPERRX	DS	2	; TAPE ERROR EXIT ADDRESS
   201b                 TICCNT	DS	2	; CLOCK TIC COUNTER
                        
   201d                 REGPTR	DS	2	; REGISTER CONTENTS POINTER
                        
   201f                 UIVEC			; USER INTERRUPT VECTOR
   201f                 	DS	3	; JUMP TO CLOCK PROCESSOR
   2022                 	DS	3	; JUMP TO SINGLE STEP PROCESSOR
   2025                 	DS	3	; JUMP TO I/O 3
   2028                 	DS	3	; JUMP TO I/O 4
   202b                 	DS	3	; JUMP TO I/O 5
   202e                 	DS	3	; JUMP TO I/O 6
   2031                 	DS	3	; JUMP TO I/O 7
                        ;
                        ;	new RAM locations for MiniPAM8
                        ;
   2034                 PCKVAL	DS	1	; PCK value from most recent scan (9 ticks)
   2035                 PCKTMP	DS	1	; temporary candidate keypad response from PCK
                        
   2036                 IOBYTE	DS	1	; byte read by serial I/O handler
   2037                 NBYTES	DS	1	; number of bytes read (0 or 1)
                        
   2038                 	END
