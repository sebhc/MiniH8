00c0  UMI.2B        0003  UMI.64X       0080  UMI.HB        0000  UMI.L5    
0004  UMI.L6        0008  UMI.L7        000c  UMI.L8        0010  UMI.PA    
0020  UMI.PE        0002  UO.DDU        0080  UO.HLT        0040  UO.NFR    
