058f  INPCMD        002c  INT5.5        0034  INT6.5        003c  INT7.5    
00b6  INTXIT        0000  IO.A          0001  IO.B          0002  IO.C      
0268  IOA           026c  IOB           026e  IOB1          2002  IOWRK     
00f0  IP.PAD        00f9  IP.TPC        00f8  IP.TPD        0080  K0        
0020  KMATH         0010  KNUM          0040  KR            01ea  LAST      
000a  LF            06f6  LOA0          071e  LOA1          06f3  LOAD      
05b0  LODCM0        05b3  LODCM1        05d2  LODCM2        05dd  LODCM3    
05e7  LODCM4        05aa  LODCMD        05f8  LODEXT        025d  LRA       
0260  LRA.          01ee  LST2          01f7  MEMM          2008  MFLAG     
00e6  MI.ANI        0076  MI.HLT        00db  MI.IN         003a  MI.LDA    
