                        ; =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
                        ;
                        ;	MiniPAM8 - monitor for H8 Mini
                        ;	Rev. 00.09.02 Beta
                        ;
                        ;	This is a modified version of PAM/8, originally written by Gordon
                        ;	Letwin 50 years ago! This version is designed to support Lee Hart's
                        ;	"H8 Mini", which incorporates some hardware modifications to simplify
                        ;	the design and allow it to run on single-board 8085-based computer
                        ;	approximately 3" x 6" in size. This code uses 8085-specific instructions,
                        ;	and for timing purposes assumes a 2Mhz CPU clock rate (4Mhz resonator).
                        ;
                        ;	A modified version of Jon Chapman's Glitch Works Monitor GWMON-80
                        ;	has been added to support a console monitor, serial I/O routines, and
                        ;	an ability to load Intel Hex files.
                        ;
                        ;	As with the original PAM/8 this consists of a set of interrupt-time and
                        ;	task-time routines. The interrupt-time routines service the front
                        ;	panel (7-segment LEDs and keypad). There are two options for task-time
                        ;	processing: 1) the front panel or 2) the GWMON console.
                        ;
                        ;	Key changes over PAM/8:
                        ;	- IRQ handling limited to the 3 hardware interrupts on the
                        ;	  H8 Mini: 2ms Clock, RTM/0 and Serial I/O.
                        ;
                        ;	Modified from original Heath-compatible assembly code by Herb Johnson (HRJ)
                        ;	for use with the A85 assembler, 25 July, 2026.
                        ;
                        ;	Other modifications/enhancements by Glenn Roberts (GFR),
                        ;	August-September, 2026.
                        ;
                        ;	Revision History:
                        ;	0.9.0	initial beta
                        ;	0.9.1	added interrupt-driven console input buffer
                        ;
                        ; =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
                        ;
                        ;	Original comments from Gordon Letwin below (some no longer apply due
                        ;	to hardware differences between the original H8 and the H8 Mini):
                        ;
                        ;	PAM/8 - H8 FRONT PANEL MONITOR
                        ;
                        ;	JGL, 05/01/76.
                        ;
                        ;	FOR *WINTEK* INC.
                        ;
                        ;	COPYRIGHT  05/1976, WINTEK CORPORATION
                        ;	902 N. 9TH ST.
                        ;	LAFAYETTE, IND.
                        
                        ;	PAM/8 - H8 FRONT PANEL MONITOR
                        ;
                        ;	THIS PROGRAM RESIDES (IN ROM) IN THE LOW 1024 BYTES OF THE HEATH
                        ;	H8 COMPUTER. IT ACTUALLY CONSISTS OF TWO VIRTUALLY INDEPENDENT
                        ;	ROUTINES: A TASK-TIME PROGRAM WHICH PROVIDES SOPHISTICATED
                        ;	FRONT PANEL MONITOR SERVICE, AND AN INTERRUPT-TIME PROGRAM WHICH
                        ;	PROVIDES BOTH A REAL-TIME CLOCK AND EMULATES AN EFFECTIVE
                        ;	HARDWARE FRONT PANEL.
                        
                        ;	INTERRUPTS.
                        ;
                        ;	PAM/8 IS THE PRIMARY PROCESSOR FOR ALL INTERRUPTS.
                        ;	THEY ARE PROCESSED AS FOLLOWS:
                        ;
                        ;	RST	USE
                        ;
                        ;	0	MASTER CLEAR. (NEVER USES FOR I/O OR RESET)
                        ;
                        ;	1	CLOCK INTERRUPT. NORMALLY TAKEN BY PAM/8.
                        ;		SETTING BIT *U0.CLK* IN BYTE *MFLAG* ALLOWS
                        ;		USER PROCESSING (VIA A JUMP THROUGH *UIVEC*).
                        ;		UPON ENTRY OF THE USER ROUTINE, THE STACK
                        ;		CONTAINS:
                        ;		(STACK+0)  = RETURN ADDRESS (TO PAM/8)
                        ;		(STACK+2)  = (STACKPTR+4)
                        ;		(STACK+4)  = (AF)
                        ;		(STACK+6)  = (BC)
                        ;		(STACK+8)  = (DE)
                        ;		(STACK+10) = (HL)
                        ;		(STACK+12) = (PC)
                        ;		THE USER'S ROUTINE SHOULD RETURN TO PAM/8 VIA
                        ;		A *RET* WITHOUT ENABLING INTERRUPTS.
                        ;
                        ;	2	SINGLE STEP. SINGLE STEP INTERRUPTS GENERATED
                        ;		BY PAM/8 ARE PROCESSED BY PAM/8.
                        ;		ANY SINGLE STEP INTERRUPT RECEIVED WHEN IN
                        ;		USER MODE CAUSES A JUMP THROUGH *UIVEC*+3.
                        ;		STACK UPON USER ROUTINE ENTRY;
                        ;		(STACK+0)  = (STACKPTR+12)
                        ;		(STACK+2)  = (AF)
                        ;		(STACK+4)  = (BC)
                        ;		(STACK+6)  = (DE)
                        ;		(STACK+8)  = (HL)
                        ;		(STACK+10) = (PC)
                        ;		THE USER'S ROUTINE SHOULD HANDLE ITS OWN RETURN
                        ;		FROM THE INTERRUPT.
                        ;
                        ;
                        ;	THE FOLLOWING INTERRUPTS ARE VECTORED DIRECTLY THROUGH *UIVEC*.
                        ;	THE USER ROUTINE MUST HAVE SETUP A JUMP IN *UIVEC* BEFORE ANY
                        ;	OF THESE INTERRUPTS MAY OCCUR.
                        ;
                        ;	3	I/O 3. CAUSES A DIRECT JUMP THROUGH *UIVEC*+6
                        ;
                        ;	4	I/O 4. CAUSES A DIRECT JUMP THROUGH *UIVEC*+9
                        ;
                        ;	5	I/O 5. CAUSES A DIRECT JUMP THROUGH *UIVEC*+12
                        ;
                        ;	6	I/O 6. CAUSES A DIRECT JUMP THROUGH *UIVEC*+15
                        ;
                        ;	7	I/O 7. CAUSES A DIRECT JUMP THROUGH *UIVEC*+18
                        
                        
                        ;		ASSEMBLY CONSTANTS
                        
                        ;		I/O PORTS
                        
   00f0                 IP.PAD	EQU	360Q		; PAD INPUT PORT
   00f0                 OP.CTL	EQU	360Q		; CONTROL OUTPUT PORT
   00f0                 OP.DIG	EQU	360Q		; DIGIT SELECT OUTPUT PORT
   00f1                 OP.SEG	EQU	361Q		; SEGMENT SELECT OUTPUT PORT
   00f9                 IP.TPC	EQU	371Q		; TAPE CONTROL IN
   00f9                 OP.TPC	EQU	371Q		; TAPE CONTROL OUT
   00f8                 IP.TPD	EQU	370Q		; TAPE DATA IN
   00f8                 OP.TPD	EQU	370Q		; TAPE DATA OUT
                        
                        ;		ASCII CHARACTERS.
                        
   0016                 A.SYN	EQU	026Q		; SYNC CHARACTER
   0002                 A.STX	EQU	002Q		; STX CHARACTER
                        
                        ;		FRONT PANEL HARDWARE CONTROL BITS.
                        
   0010                 CB.SSI	EQU	00010000B	; SINGLE STEP INTERRUPT
   0020                 CB.MTL	EQU	00100000B	; MONITOR LIGHT
   0040                 CB.CLI	EQU	01000000B	; CLOCK INTERRUPT ENABLE
   0080                 CB.SPK	EQU	10000000B	; SPEAKER ENABLE
                        
                        ;		DISPLAY MODE FLAGS (IN *DSPMOD*)
                        
   0000                 DM.MR	EQU	0		; MEMORY READ
   0001                 DM.MW	EQU	1		; MEMORY WRITE
   0002                 DM.RR	EQU	2		; REGISTER READ
   0003                 DM.RW	EQU	3		; REGISTER WRITE
                        
                        ;		MACHINE INSTRUCTIONS.
                        
   0076                 MI.HLT	EQU	01110110B	; HALT
   00c9                 MI.RET	EQU	11001001B	; RETURN
   00db                 MI.IN	EQU	11011011B	; INPUT
   00d3                 MI.OUT	EQU	11010011B	; OUTPUT
   003a                 MI.LDA	EQU	00111010B	; LDA
   00e6                 MI.ANI	EQU	11100110B	; ANI
   0011                 MI.LXID EQU	00010001B	; LXI D
                        
                        ;		USER OPTION BITS.
                        ;
                        ;		THESE BITS ARE SET IN CELL MFLAG.
                        
   0080                 UO.HLT	EQU	10000000B	; DISABLE HALT PROCESSING
   0040                 UO.NFR	EQU	CB.CLI		; NO REFRESH OF FRONT PANEL
   0002                 UO.DDU	EQU	00000010B	; DISABLE DISPLAY UPDATE
   0001                 UI.CLK	EQU	00000001B	; ALLOW CLOCK INTERRUPT PROCESSING
                        
                        ;
                        ;	H8 Mini equates
                        ;
                        ;	8255 PPI at 0F0-0F3
                        ;
   00f0                 PPI	EQU	0F0H
   0000                 IO.A	EQU	0
   0001                 IO.B	EQU	1
   0002                 IO.C	EQU	2
   0003                 CTRL	EQU	3
                        
   0010                 KNUM	EQU	00010000B	; PC4
   0020                 KMATH	EQU	00100000B	; PC5
   0040                 KR	EQU	01000000B	; PC6
   0080                 K0	EQU	10000000B	; PC7
                        
                        ;
                        ;	Equates used by GWMON
                        ;
                        ;	ASCII Equates
                        ;
   0003                 CTLC	EQU	03
   0008                 BS	EQU	08
   000a                 LF	EQU	10
   000d                 CR	EQU	13
                        
   0003                 CANCEL	EQU	CTLC		; Escape/cancel character, CTRL+C
   000d                 NEXTLOC	EQU	CR		; Keystroke for next location in E
                        				; defaults to CR
                        				
   8000                 STACK	equ	8000H		; Stack at top of RAM (32K for H8 Mini)
                        
                        ;
                        ;	Keypad autorepeat delay (ARDLY) and debounce delay (DBDLY) in ms.
                        ;
   0190                 ARDLY	EQU	400
   000a                 DBDLY	EQU	10
                        
                        ;
                        ;	Bit times for bit-banged serial
                        ;
                        ; Using Intel Application Note AP-29 the following are computed for
                        ; use with 4.0 MHz crystal - gfr
                        ;
                        ;BITTIME	EQU	010AH		;9600 BPS with 4.0 MHz crystal
                        ;HALFBIT	EQU	0106H		;Half-bit time
                        
   0137                 BITTIME	EQU	0137H		;2400 BPS with 4.0 MHz crystal
   011c                 HALFBIT	EQU	011CH		;Half-bit time
                        
                        	INCLUDE	"u8251.asm"	; DEFINE THE 8251 USART BITS
                        ;        STL     '8251 USART BIT DEFINITIONS.'
                        ;        EJECT
                        	PAGE
                        ;      8251 USART BIT DEFINITIONS.
                        ;
                        
                        ;      PORT ADDRESSES
                        
   0000                 UDR     EQU     0               ; DATA REGISTER IS EVEN
   0001                 USR     EQU     1               ; STATUS REGISTEP IS NEXT
                        
   00fa                 SC.UART EQU     372Q            ; CONSOLE USAPT ADDPESS (IFF 8251)
                        
                        
                        ;      MODE INSTRUCTION CONTROL BITS.
                        
   0040                 UMI.1B  EQU     01000000B       ; 1 STOP BIT
   0080                 UMI.HB  EQU     10000000B       ; 1 1/2 STOP BITS
   00c0                 UMI.2B  EQU     11000000B       ; 2 STOP BITS
   0020                 UMI.PE  EQU     00100000B       ; EVEN PARITY
   0010                 UMI.PA  EQU     00010000B       ; USE PARITY
   0000                 UMI.L5  EQU     00000000B       ; 5 BIT CHARACTERS
   0004                 UMI.L6  EQU     00000100B       ; 6 BIT CHARACTERS
   0008                 UMI.L7  EQU     00001000B       ; 7 BIT CHARACTERS
   000c                 UMI.L8  EQU     00001100B       ; 8 BIT CHARACTERS
   0001                 UMI.1X  EQU     00000001B       ; CLOCK 8 1
   0002                 UMI.16X EQU     00000010B       ; CLOCK X 16
   0003                 UMI.64X EQU     00000011B       ; CLOCK 8 64
                        
                        ;      COMMAND INSTRUCTION BITS.
                        
   0040                 UCI.IR  EQU     01000000B       ; INTERNAL RESET
   0020                 UCI.RO  EQU     00100000B       ; READER-ON CONTROL FLAG
   0010                 UCI.ER  EQU     00010000B       ; ERROR RESET
   0004                 UCI.RE  EQU     00000100B       ; RECEIVE ENABLE
   0002                 UCI.IE  EQU     00000010B       ; ENABLE INTERRUPTS FLAG
   0001                 UCI.TE  EQU     00000001B       ; TRANSMIT ENABLE
                        
                        ;      STATUS READ COMMANB BITS.
                        
   0040                 USR.BD  EQU     01000000B       ; Break Detect                    /80.08.gc/
   86a0                 USR.FE  EQU     00100000D       ; FRAMING ERROR
   0010                 USR.OE  EQU     00010000B       ; OVERRUN ERROR
   0008                 USR.PE  EQU     00001000B       ; PARITY ERROR
   0004                 USR.TXE EQU     00000100B       ; TRANSMITTER EMPTY
   0002                 USR.RXR EQU     00000010B       ; RECEIVER READY
   0001                 USR.TXR EQU     00000001B       ; TRANSMITTER READY
                        
                        
                        ;	INTERRUPT VECTORS.
                        ;
                        
                        ;	LEVEL 0 - RESET
                        ;
                        ;	The CPU will jump here on a cold start
                        ;
                        ;	THIS 'INTERRUPT' MAY NOT BE PROCESSED BY A USER PROGRAM.
                        
   0000                 	ORG	0
                        
   0000   11 f9 03      INIT0	LXI	D,PRSROM	; (DE) = ROM COPY OF PRS CODE
   0003   21 0a 20      	LXI	H,PRSRAM+PRSL-1 ; (HL) = RAM DESTINATION FOR CODE
   0006   c3 a7 00      	JMP	INIT		; INITIALIZE
                        ;	ERRPL	INIT-1000Q	; BYTE IN WORD 10A MUST BE 0
                        
   0009   4d 49 4e 49   PAMVER$	DB 'MINIPAM 00.09.02 ','B' + 80H
   000d   50 41 4d 20   
   0011   30 30 2e 30   
   0015   39 2e 30 32   
   0019   20 c2         
                        
                        
                        ;	Interrupt 5.5 - caused by RTM/0 key combination
                        ;
                        ;	On the original H8 RTM/0 generated a level 10 
                        ;	interrupt - basically the clock handler. The CLOCK
                        ;	routine would test for the RTM/0 combination and
                        ;	drop back into the monitor.
                        ;
                        ;	The H8 Mini has its own direct interrupt handler for the
                        ;	RTM/0 key combo. Need to insert similar code here.
                        ;
                        ;	This interrupt is maskable via SIM instruction.
                        ;
                        ;	NOTE: In PAM-8 location 53Q is the address of DLY, a
                        ;	general purpose delay routine. Unfortunately
                        ;	we will have to relocate DLY because of the INT5.5
                        ;	code.
                        
   002c                 	ORG	54Q
   002c                 INT5.5	EQU	*
   002c   fb            	EI
   002d   c9            	RET
                        	
                        ;	Interrupt 6.5 - Serial I/O
                        ;
                        
   0034                 	ORG	64Q
   0034   c3 5e 00      	JMP	CINT		; jump directly to handler
                        
                        	
                        ;	Interrupt 7.5 - generated by 2ms clock
                        ;
                        ;	Every 2ms this interrupt updates the TICCNT counter,
                        ;	then calls Refresh Front Panel (RFP), which refreshes
                        ;	the LED display and checks for keypad hits.
                        ;
   003c                 	ORG	74Q
   003c   cd d5 00      INT7.5	CALL	SAVALL		; save user registers
                        ;
                        ;	We need to do nested interrupt handling here, allowing the lower
                        ;	priority (RST 6.5) serial line IRQ to interrupt the front panel
                        ;	refresh. Without this serial data will be lost. First enable interrupts
                        ;	and then specifically mask out the 7.5 ones to allow lower ones in
                        ;
   003f   fb            	EI			; ok to interrupt us
   0040   3e 0d         	MVI	A,00001101B	; enable RST 6.5 - serial start bit IRQ
   0042   30            	SIM			; apply the mask
                        
   0043   16 00         	MVI	D,0		; needed for proper RFP execution
   0045   c3 fd 00      	JMP	CLOCK		; process clock interrupt
                        
   0053                 	ORG	53H
                        	
                        ;	DLY - Delay time interval
                        ;
                        ;	This routine now lives at 053H (in PAM/8 was 053Q)
                        ;	It is a much simplified version as HORN now done differently.
                        ;
                        ;	ENTRY:	(A) = (ms. delay count)/2
                        ;
                        ;	USES	A,F
                        ;
   0053   e5            DLY:	PUSH	H		; (HL) used for working storage
   0054   21 1b 20      	LXI	H,TICCNT	; (M) = low byte of TICCNT
   0057   86            	ADD	M		; (A) = TICCNT + count (ignore wrap around)
                        ;
                        ;	wait required number of tick counts. Just loop here until
                        ;	the interrupt-driven TICCNT number matches the right number.
                        ;
   0058   be            DLY2:	CMP	M		; wait until ticks have passed
   0059   c2 58 00      	JNZ	DLY2
                        
   005c   e1            	POP	H
   005d   c9            	RET
                        
                        ;	CINT - serial I/O interrupt handler
                        ;
                        ;	This interrupt is triggered by a transition from low to high on the
                        ;	SID line, which is an inverted version of the RX signal on the serial
                        ;	input header. This transition indicates the start bit of a 10-bit sequence
                        ;	(start bit, 8-bit data byte,and stop bit).
                        ;
                        ;	This handler first decodes the byte and stores it in a buffer by
                        ;	first incrementing the buffer count and then adding the byte to the
                        ;	tail of the buffer. The task-time code to read data can check the
                        ;	byte count to see if there is any data in the buffer. Currently this
                        ;	routine silently discards any overrun bytes.
                        ;
                        ;	Since the 2ms interrupt (RST 7.5) is a higher priority and involves
                        ;	somewhat lengthy processing, its handler must yield for the RST 6.5
                        ;	handler to process a byte even if it is in the middle of a clock update.
                        ;
                        ;	The SID and SOD pins on the Intel 8085 are used for bit-banged serial I/O.
                        ;	The effective BAUD rate is set by fixed bit rate constants, which are used
                        ;	to delay between bit samples. For more information consult Intel Application
                        ;	Note AP-29, August 1977.
                        ;
   005e   f5            CINT:	PUSH	PSW
   005f   c5            	PUSH	B
   0060   e5            	PUSH	H
                        ;
                        ;	We know we have a start bit (that generated the interrupt). First
                        ;	we delay 1/2 the bit time (HALFBIT). This puts us in the middle of the
                        ;	start bit. Once we are thus shifted we just sample bits every BITTIME.
                        ;	Use (C) to build the byte (not necessary to clear it as we will overwrite
                        ;	all 8 bits). Use (B) to count the bits.
                        ;
   0061   06 09         	MVI	B,9		; Received bits counter
                        
   0063   21 1c 01      	LXI	H,HALFBIT	; Delay one half-bit time
   0066   2d            CI2:	DCR	L		; putting us in the middle of the start bit
   0067   c2 66 00      	JNZ	CI2
   006a   25            	DCR	H
   006b   c2 66 00      	JNZ	CI2
                        ;
                        ;	Loop over the bits
                        ;
   006e   21 37 01      CI3:	LXI	H,BITTIME	; Delay one bit-time. puts us in the middle
   0071   2d            CI4:	DCR	L		; of the next bit and will keep
   0072   c2 71 00      	JNZ	CI4		; us in the middle of bits for
   0075   25            	DCR	H		; reliable sampling.
   0076   c2 71 00      	JNZ	CI4
                        
   0079   20            	RIM			; Read the SID line
   007a   2f            	CMA			; invert it (for H8 Mini)
   007b   17            	RAL			; save the bit in the CY flag
   007c   05            	DCR	B		; decrement the bit counter
   007d   ca 87 00      	JZ	CI5		; Stop bit, done with char receive!
                        
   0080   79            	MOV	A,C		; get the byte under construction
   0081   1f            	RAR			; rotate the bit into place
   0082   4f            	MOV	C,A		; and save it
   0083   00            	NOP			; Equalize OUT and IN loop times
   0084   c3 6e 00      	JMP	CI3		; Get more bits
                        ;
                        ;	We now have all 8 bits in (C), store the byte in the buffer
                        ;
   0087   21 36 20      CI5:	LXI	H,INBADDR	; (HL) = address of buffer
   008a   cd 25 03      	CALL	$HLIHL		; (HL) = buffer
   008d   3a 38 20      	LDA	INBLEN		; (A) = buffer length
   0090   be            	CMP	M		; see if there's room for more
   0091   da 99 00      	JC	CI6		; no, just ignore (should do more)
                        ;
                        ;	There's room to store the byte so process it
                        ;
   0094   34            	INR	M		; bump the count
   0095   7e            	MOV	A,M		; fetch the count
   0096   85            	ADD	L		; A = L + A
   0097   6f            	MOV	L,A		; L += A; (HL) = address of character
   0098   71            	MOV	M,C		; store the character
                        
   0099   e1            CI6:	POP	H
   009a   c1            	POP	B
   009b   f1            	POP	PSW
   009c   fb            	EI
   009d   c9            	RET
                        
                        ;	PPSROM - PPI Setup code
                        ;
                        ;	Here we use a trick. This is the code to initialize the configuration
                        ;	of the 8255 PPI. There is a catch 22 here because this will momentarily
                        ;	disable the visibility of ROM in low memory. One solution would be to
                        ;	copy the code to RAM and execute it there, but here we use a different
                        ;	approach. The H8 Mini mirrors the low 8K of ROM to 32K,	so the routine is
                        ;	visible at this location plus 32K. We will store it here but call it from
                        ;	a location 8000H higher (PPS).
                        ;
   009e   3e 88         PPSROM:	MVI	A,10001000B	; all bits OUT except PC4..PC7
   00a0   d3 f3         	OUT	PPI+CTRL
   00a2   3e 10         	MVI	A,00010000B	; make sure PA4 stays high (ROM/RAM line)
   00a4   d3 f0         	OUT	PPI+IO.A
   00a6   c9            	RET
                        
   809e                 PPS	EQU	PPSROM+8000H	; where we will actually call it from
                        
                        
                        ;	INIT - initialize system
                        ;
                        ;	INIT is called whenever a hardware master-clear is initiated.
                        ;
                        ;	Setup PAM/8 control cells in RAM.
                        ;	Setup stackpointer, and
                        ;	enter the monitor loop.
                        ;
                        ;	ENTRY:	from master clear
                        ;	EXIT:	into PAM/8 main loop
                        ;
                        ;	First, initalize key locations in RAM using initial
                        ;	values stored in ROM (PRSROM). Values are copied in
                        ;	reverse order.
                        ;
   00a7   1a            INIT	LDAX	D		; copying from *PRSROM* into RAM
   00a8   77            	MOV	M,A		; move a byte
   00a9   2b            	DCX	H		; decrement destination
   00aa   1c            	INR	E		; increment source
   00ab   c2 a7 00      	JNZ	INIT		; and loop 'til done
                        ;
                        ;	Show something interesting on the LEDs
                        ;
   00ae   21 1b 20      	LXI	H,TICCNT	; Tick counter
   00b1   22 14 20      	SHLD	ABUSS		; store it
                        ;
                        ;	The original PAM/8 determined the top of RAM by probing
                        ;	every 1K for live RAM and then set the stack pointer
                        ;	there. For the H8 Mini we assume a 32K RAM space and
                        ;	set SP there.
                        ;
   00b4   21 00 80      	LXI	H,STACK		; Stack at top of RAM
   00b7   2b            INIT2:	DCX	H		; set to one minus memory limit
   00b8   f9            	SPHL			; set SP
   00b9   e5            	PUSH	H		; save *PC* value on stack
   00ba   21 92 01      	LXI	H,ERROR		; ERROR = general bail out routine
   00bd   e5            	PUSH	H		; set as 'return address'
                        ;
                        ;	H8 Mini-specific Initializations
                        ;
                        ;	Call the PPI setup code from its "shadow" location 8000H higher
                        ;
   00be   cd 9e 80      	CALL	PPS
                        ;
                        ;	Set up console serial interrupt handler values in RAM
                        ;
   00c1   21 39 20      	LXI	H,$INBUF	; (HL) = default input buffer
   00c4   22 36 20      	SHLD	INBADDR		; save that location
   00c7   af            	XRA	A		; clear serial I/O byte count
   00c8   77            	MOV	M,A		; set byte count to 0
   00c9   3e 01         	MVI	A,$INBUFL	; buffer length
   00cb   32 38 20      	STA	INBLEN		; save that too
                        ;
                        ;	Enable clock and console interrupts
                        ;
   00ce   3e 09         	MVI	A,00001001B	; enable RST 7.5 (clock) and RST 6.5 (serial)
   00d0   30            	SIM			; apply the mask
   00d1   fb            	EI			; globally enable interrupts
                        	
                        ;
                        ;	Use GWMON as main loop while we debug things...
                        ;
   00d2   c3 0c 04      	JMP	GWMON
                        	
                        ;	JMP	SAVALL		; begin front panel monitor
                        
                        ;	Now just fall through to SAVALL and then return to the
                        ;	general bailout routine ERROR.
                        
                        ;
                        ;	SAVALL - save all registers on stack.
                        ;
                        ;	Called when an interrupt is accepted, in order to
                        ;	save the contents of the registers on the stack.
                        ;
                        ;	ENTRY	called directly from the interrupt routine.
                        ;	EXIT	all registers pushed on stack.
                        ;		if not yet in monitor mode, REGPTR = address of registers
                        ;		on stack.
                        ;		(DE) = address of CTLFLG
                        
                        
   00d5   e3            SAVALL	XTHL			; set H,L on stack top
   00d6   d5            	PUSH	D
   00d7   c5            	PUSH	B
   00d8   f5            	PUSH	PSW
   00d9   eb            	XCHG			; (D,E) = return address
   00da   21 0a 00      	LXI	H,10
   00dd   39            	DAD	SP		; (H,L) = address of users SP
   00de   e5            	PUSH	H		; set on stack as 'register'
   00df   d5            	PUSH	D		; set return address
   00e0   11 09 20      	LXI	D,CTLFLG
   00e3   1a            	LDAX	D		; (A) = CTLFLG
   00e4   2f            	CMA
   00e5   e6 30         	ANI	CB.MTL+CB.SSI	; save register addr if user or single-step
   00e7   c8            	RZ			; return if was interrupt or monitor loop
   00e8   21 02 00      	LXI	H,2
   00eb   39            	DAD	SP		; (H,L) = address of 'STACKPTR' on stack
   00ec   22 1d 20      	SHLD	REGPTR
   00ef   c9            	RET
                        ;
                        ;	INTXID - Return to program from interrupt.
                        ;
   00f0   f1            INTXIT	POP	PSW		; remove fake 'stack register'
                        ;
                        ;	Make sure clock interrupts are enabled
                        ;
   00f1   20            	RIM			; Read interrupt mask
   00f2   e6 03         	ANI	00000011B	; leave 5.5 and 6.5 alone
   00f4   f6 08         	ORI	00001000B	; 7.5 LOW (interrupts on)
   00f6   30            	SIM			; set new mask
                        	
   00f7   f1            	POP	PSW
   00f8   c1            	POP	B
   00f9   d1            	POP	D
   00fa   e1            	POP	H
   00fb   fb            	EI
   00fc   c9            	RET
                        ;
                        ;	CLOCK - process clock interrupt
                        ;
                        ;	Entered whenever a 2 millisecond clock interrupt is
                        ;	processed.
                        ;
                        ;	TICCNT is incremented every interrupt, then fall
                        ;	through to RFP to refresh front panel and PCK to
                        ;	probe console keypad.
                        ;
   00fd   2a 1b 20      CLOCK	LHLD	TICCNT
   0100   23            	INX	H
   0101   22 1b 20      	SHLD	TICCNT		; INCREMENT TICCOUNT
                        
                        ;	RFP - Refresh Front Panel (and probe keypad switches)
                        ;
                        ;	This code uses the 8255 PIA lines to do two things: 1) refresh the
                        ;	front panel LEDs and 2) probe to detect front panel keypad closures.
                        ;	This is called for every clock interrupt so it updates only one
                        ;	7-segment LED unit at a time (working right to left).
                        ;	The REFIND variable keeps track of the refresh index.
                        ;
                        ;	Since the H8 Mini makes dual purpose of the PA0..PA3 lines
                        ;	to both select LEDS and switches, it makes sense to simultaneously
                        ;	scan for keyswitch closures.
                        ;
                        ;	ENTRY: 	calling program should set (D) = 0
                        ;
   0104   21 08 20      RFP	LXI	H,MFLAG		; ((HL)) = MFLAG
   0107   7e            	MOV	A,M		; (A) = current MFLAG value
   0108   47            	MOV	B,A		; save it in (B)
   0109   e6 40         	ANI	UO.NFR		; Test No Front Refresh bit
   010b   23            	INX	H		; code assumes CTLFLG follows MFLAG
                        
   010c   7e            	MOV	A,M		; (A) = CTLFLG
   010d   4a            	MOV	C,D		; (C) = 0 in case no panel refresh
                        ;
                        ;	The original PAM/8 had an ability to skip over front panel
                        ;	refresh to save CPU time, but since the keypad scan is now
                        ;	accomplished that way we have to be careful. For now 
                        ;	disable this capability. We may be able to re-introduce it
                        ;	differently later...
                        ;
                        ;	JNZ	CLK3		; NFR bit was set - no refresh
                        
   010e   23            	INX	H		; code assumes REFIND follows CTLFLG
                        ;
                        ;	Here (HL) points to the refresh index (REFIND). Since the front
                        ;	panel LED pattern bytes (FPLEDS) immediately follow that location
                        ;	they are indexed from 1 to 9. REFIND was initialized to 1 at startup.
                        ;
   010f   35            	DCR	M		; decrement digit index
   0110   c2 1a 01      	JNZ	CLK2		; still positive, keep going
                        ;
                        ;	A little housekeeping for the upcoming keypad scan: Starting a new
                        ;	refresh cycle. Get ready for a new round of keypad scans:
                        ;	set PCKTMP to 0FFH
                        ;
   0113   3e ff         	MVI	A,0FFH		; default to return if no keys pressed
   0115   32 35 20      	STA	PCKTMP		; after scanning all 9.
                        	
   0118   36 09         	MVI	M,9		; loop continuously counting down from 9
   011a   5e            CLK2	MOV	E,M		; (DE) = index pointer to pattern
   011b   19            	DAD	D		; ((HL)) = (M) = LED pattern
                        ;
                        ;	Port B controls which of the segments to light
                        ;	(M) = pattern to send to the LED
                        ;
   011c   af            	XRA	A		; first zero the pattern
   011d   d3 f1         	OUT	PPI+IO.B	; this avoids "ghosting"
                        	
   011f   db f0         CLK3	IN	PPI+IO.A	; read Port A status
   0121   e6 f0         	ANI	11110000B	; clear lower 4 bits
   0123   b3            	ORA	E		; set bits for digit to select
   0124   d3 f0         	OUT	PPI+IO.A	; select it
                        ;
                        ;	Now set the segments to be lit on Port B
                        ;
   0126   7e            	MOV	A,M		; (A) = LED pattern from table
   0127   d3 f1         	OUT	PPI+IO.B	; set it!
                        ;
                        ;	PCK - Probe Console Keypad
                        ;
                        ;	While we have this line selected we can probe for switch closures by
                        ;	examining PC4..PC7. These input lines are matrixed with the various
                        ;	key switches. If a key is pressed the appropriate value is stored in PCKTMP,
                        ;	per the table below. PCKTMP is initally set to "no key pressed" (0FFH) when
                        ;	the scan cycle begins.
                        ;
                        ;	If no key is pressed on this pass we continue scanning with next clock interrupt.
                        ;	After 9 scans the value of PCKTMP is "published" to PCKVAL, where it can be
                        ;	read by the RCK routine. If no key was pressed during the 9 cycles then
                        ;	PCKVAL will be 0FFH.
                        ;
                        ;	Key Values to be returned in PCKVAL:
                        ;
                        ;	Key	  Value (decimal)
                        ;	0-9		0-9
                        ;	'+'		10
                        ;	'-'		11
                        ;	'*'		12
                        ;	'/'		13
                        ;	'#'		14
                        ;	'.'		15
                        ;     <no key>		255
                        ;
   0129   c5            PCK:	PUSH	B		; using B for scratch
                        ;
                        ;	PC4..PC7 are four input lines on the PPI chip that are matrixed
                        ;	with the various switches.
                        ;
                        ;	PC4	KNUM	Active "low"; Number [1..9]
                        ;	PC5	KMATH	Active "low"; '.', '*', '-', '+'
                        ;	PC6	KR	Active "high";'/' (RST)
                        ;	PC7	K0	Active "high", '0'
                        ;
   012a   db f2         	IN	PPI+IO.C	; read PC4..PC7
   012c   ee 30         	XRI	00110000B	; make all signals "active high"
   012e   47            	MOV	B,A		; keep a copy
   012f   e6 40         	ANI	KR		; check for '/'
   0131   c2 6b 01      	JNZ	PCKR		; pressed, jump
                        	
   0134   78            	MOV	A,B		; restore reading
   0135   e6 80         	ANI	K0		; check for '0'
   0137   c2 70 01      	JNZ	PCKZ		; pressed, jump
                        	
   013a   78            	MOV	A,B		; restore reading
   013b   e6 10         	ANI	KNUM		; check for [1..9]
   013d   c2 74 01      	JNZ	PCKN
                        	
   0140   78            	MOV	A,B		; restore reading
   0141   e6 20         	ANI	KMATH		; check for '.', '*', '-', '+'
   0143   ca 7b 01      	JZ	PCKQ		; no match to any, skip to end
                        ;
                        ;	A "math" key pressed ('#', '.', '*', '-' or '+')
                        ;
                        ;	First we need to test whether this came from the SM ('#')
                        ;	switch. To test that we need to momentarily turn off all refresh
                        ;	lines (LED segments will briefly extinguish).
                        ;
   0146   db f0         PCKM:	IN	PPI+IO.A	; read Port A status
   0148   4f            	MOV	C,A		; save it (for restoration later)
   0149   e6 f0         	ANI	11110000B	; clear refresh lines
   014b   d3 f0         	OUT	PPI+IO.A	; turn off all lines
   014d   db f2         	IN	PPI+IO.C	; re-read the inputs
   014f   47            	MOV	B,A		; save it
                        ;
                        ;	now immediately turn the LEDs back on (hopefully nobody noticed!)
                        ;	
   0150   79            	MOV	A,C		; get back desired line state
   0151   d3 f0         	OUT	PPI+IO.A	; select it
                        	
   0153   78            	MOV	A,B		; now let's see if KMATH was asserted
   0154   e6 20         	ANI	KMATH		; (remember "low" = key pressed)
   0156   c2 5e 01      	JNZ	PCKM1		; "high" -> no key pressed (not SM)
   0159   3e 0e         	MVI	A,14		; "low" -> SM ('#') key was pressed
   015b   c3 78 01      	JMP	PCK1		; done!
                        ;
                        ;	Set key value according to original PAM/8 scheme:
                        ; E = 1:	'.'	15
                        ; E = 2:	'*'	12
                        ; E = 3:	'-'	11
                        ; E = 4:	'+'	10
                        ;
                        ; for E = 2, 3 or 4 just subtract from 14. E = 1 is special case
                        ;
   015e   3e 0e         PCKM1:	MVI	A,14
   0160   93            	SUB	E		; A = 14 - (E)
   0161   fe 0d         	CPI	13		; 13 should be 15
   0163   da 78 01      	JC	PCK1		; <13 is OK
   0166   c6 02         	ADI	2		; make the adjustment
   0168   c3 78 01      	JMP	PCK1
                        ;
                        ;	RST ('/') pressed
                        ;
   016b   3e 0d         PCKR:	MVI	A,13		; '/' = 13
   016d   c3 78 01      	JMP	PCK1		; done
                        ;
                        ;	'0' pressed
                        ;
   0170   af            PCKZ:	XRA	A		; '0' = 0
   0171   c3 78 01      	JMP	PCK1		; done
                        ;
                        ;	'1' through '9' pressed
                        ;
   0174   7b            PCKN:	MOV	A,E		; return the scan number
   0175   c3 78 01      	JMP	PCK1		; done
                        ;
                        ;	Come here with (A) = keycode if key press was detected
                        ;
   0178   32 35 20      PCK1:	STA	PCKTMP		; save the key value
                        
                        
   017b   c1            PCKQ:	POP	B		; restore B, and done ...
   017c   1d            	DCR	E		; set 'Z' flag
   017d   c2 86 01      	JNZ	PCKX		; not done yet
                        ;
                        ;	Done with 9 scans, move "temp" value to actual
                        ;
   0180   3a 35 20      	LDA	PCKTMP		; load our scratch copy
   0183   32 34 20      	STA	PCKVAL		; make it official
                        ;
                        ;	End of keypad processing
                        ;
   0186                 PCKX	EQU	*
                        ;
                        ;	See if time to decode display values
                        ;
   0186   21 1b 20      	LXI	H,TICCNT	; check the clock
   0189   7e            	MOV	A,M		; low byte only
   018a   e6 1f         	ANI	31		; multiple of 32?
                        ;
                        ;	every 32 interrupts update the front panel and
                        ;	check for key presses
                        ;
   018c   cc e6 02      	CZ	UFD		; Update front panel display
                        ;
                        ;	Exit clock interrupt
                        ;
                        ;	For now simply exit here. Code that follows is to handle
                        ;	processing of HLT instructions
                        ;
   018f   c3 f0 00      	JMP	INTXIT
                        
                        
                        ;	LXI	B,CTLFLG
                        ;	LDAX	B		; (A) = CTLFLG
                        ;	ANI	CB.MTL
                        ;	JNZ	INTXIT		; IF IN MONITOR CODE
                        ;	DCX	B
                        ;	ERRNZ	CTLFLG-MFLAG-1	; code assumes CTLFLG follows MFLAG
                        ;	LDAX	B		; (A) = MFLAG
                        ;	ERRNZ	UO.HLT-200Q	; ASSUME HIGH-ORDER
                        ;	RAL
                        ;	JC	CLK4		; SKIP IT
                        
                        ;	NOT IN MONITOR MODE, CHECK FOR HALT
                        
                        ;	MVI	A,10		; (A) = INDEX OF *P* REG
                        ;	CALL	LRA.		; LOCATE REGISTER ADDRESS
                        ;	MOV	E,M
                        ;	INX	H
                        ;	MOV	D,M		; (D,E) = PC CONTENTS
                        ;	DCX	D
                        ;	LDAX	D
                        ;	CPI	MI.HLT		; CHECK FOR HALT
                        ;	JZ	ERROR		; IF HALT, BE IN MONITOR MODE
                        
                        ;	CHECK FOR 'RETURN TO MONITOR' KEY ENTRY.
                        ;CLK4	EQU	*
                        ;	 IN	 IP.PAD
                        ;	 CPI	 56Q		 ; SEE IF '0' AND '#'
                        ;	 JNZ	 CUI1		 ; IF NOT, ALLOW USER PROCESSING OF CLOCK
                        
                        ;	ERROR - Command error or general bail out
                        ;
                        ;	Error is called as a 'bail-out' routine.
                        ;
                        ;	It resets the operational mode, and restores the stackpointer.
                        ;
                        ;	ENTRY	NONE
                        ;	EXIT	TO MTR LOOP
                        ;		CTLFLG SET
                        ;		MFLAG CLEARED
                        ;	USES	ALL
                        
   0192   21 08 20      ERROR:	LXI	H,MFLAG
   0195   7e            	MOV	A,M		; (A) = MFLAG
   0196   e6 bd         	ANI	377Q-UO.DDU-UO.NFR ; Re-enable displays
   0198   77            	MOV	M,A		; replace
   0199   23            	INX	H		; next point to CTLFLG
   019a   36 f0         	MVI	M,CB.SSI+CB.MTL+CB.CLI+CB.SPK ; Restore *CTLFLG*
                        ;	ERRNZ	CTLFLG-MFLAG-1	; code assumes CTLFLG follows MFLAG
   019c   fb            	EI
   019d   2a 1d 20      	LHLD	REGPTR
   01a0   f9            	SPHL			; Restore stack pointer to empty state
   01a1   cd 74 02      	CALL	ALARM		; Alarm for 200 ms
                        ;	JMP	MTR
                        
                        ; =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
                        ;
                        ;	MTR - Monitor Loop.
                        ;
                        ;	This is the main executive loop for the front panel emulator.
                        ;
                        ; =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
   01a4   fb            MTR:	EI
                        
   01a5   21 a5 01      MTR1:	LXI	H,MTR1		; set top of the monitor loop
   01a8   e5            	PUSH	H		; as return address
   01a9   01 07 20      	LXI	B,DSPMOD	; (BC) = #DSPMOD
   01ac   0a            	LDAX	B		; (A) = DSPMOD
   01ad   e6 01         	ANI	1		; (A) = 1 if in alter mode
                        ;	CMA			; H8 Mini uses opposite sense - gfr
   01af   32 06 20      	STA	DSPROT		; rotate LED periods if alter
                        ;
                        ;	Read a key from the keypad and take appropriate action
                        ;
   01b2   cd 44 06      	CALL	RCK		; read console keypad
   01b5   2a 14 20      	LHLD	ABUSS		; (HL) = ABUSS
   01b8   fe 0a         	CPI	10		; test for [0..9]
   01ba   d2 c4 01      	JNC	MTR4		; everything else is "always valid"
   01bd   5f            	MOV	E,A		; save RCK result
   01be   0a            	LDAX	B		; (A) = DSPMOD
   01bf   0f            	RRC			; move low bit to CY
   01c0   da e8 01      	JC	MTR5		; if in alter mode
   01c3   7b            	MOV	A,E		; (A) = code
                        ;
                        ;	"Always Valid": have a command (not a value)
                        ;
   01c4   d6 04         MTR4	SUI	4		; Offset so "Go" is zero
   01c6   da 92 01      	JC	ERROR		; if bad
   01c9   5f            	MOV	E,A		; save it
   01ca   e5            	PUSH	H		; save ABUSS value
   01cb   21 dc 01      	LXI	H,MTRA		; point to dispatch table
   01ce   16 00         	MVI	D,0		; (DE) = offset
   01d0   19            	DAD	D		; (HL) = address of table entry
   01d1   5e            	MOV	E,M		; (DE) = offset to processor
   01d2   19            	DAD	D		; (HL) = address of processor
                        ;
                        ;	Prepare to dispatch to processor. Put dispatch address on the
                        ;	stack (RET will jump there), point DE to REG Index, set
                        ;	'Z' if memory and load A with DSPMOD
                        ;
   01d3   e3            	XTHL			; set address, (HL) = (ABUSS)
   01d4   11 05 20      	LXI	D,REGI		; (DE) = address of reg index
   01d7   0a            	LDAX	B		; (A) = DSPMOD
   01d8   e6 02         	ANI	2		; set 'Z' if memory
   01da   0a            	LDAX	B		; (A) = DSPMOD
   01db   c9            	RET			; jump to processor
                        ;
                        ;	Command dispatch table (NOTE single byte offsets so
                        ;	it is important that the dispatch routine not be farther away than
                        ;	256 bytes)
                        ;
   01dc   77            MTRA:	DB	GO-$		; 4 - go
   01dd   63            	DB	IN- $		; 5 - input
   01de   65            	DB	OUT-$		; 6 - output
   01df   79            	DB	SSTEP-$		; 7 - single step
   01e0   47            	DB	ABORT-$		; 8 - cassette load (N/A)
   01e1   46            	DB	ABORT-$		; 9 - cassette dump (N/A)
   01e2   38            	DB	NEXT-$		; + - next
   01e3   45            	DB	LAST-$		; - - last
   01e4   43            	DB	ABORT-$		; * - abort
   01e5   31            	DB	RW-$		; / - display/alter
   01e6   4f            	DB	MEMM-$		; # - memory mode
   01e7   1c            	DB	REGM-$		; . - register mode
                        
                        ;	Process memory/register alterations.
                        ;
                        ;	This code is entered if
                        ;
                        ;	1) we are in alter mode, and
                        ;	2) a key from 0-7 was entered.
                        
   01e8   0f            MTR5	RRC
   01e9   7b            	MOV	A,E		; (A) = U
   01ea   da f6 01      	JC	MTR6		; is register
   01ed   37            	STC			; indicate 1st digit is in (A)
   01ee   cd ab 02      	CALL	IOB		; input octal byte
   01f1   23            	INX	H		; display next location
                        
                        ;	SAE - Store ABUSS and exit.
                        ;
                        ;	ENTRY:	(HL) = ABUSS value
                        ;	EXIT:	to (RET)
                        ;	USES:	NONE
                        ;
   01f2   22 14 20      SAE	SHLD	ABUSS
   01f5   c9            	RET
                        ;
                        ;	alter register
                        ;
   01f6   f5            MTR6	PUSH	PSW		; save code
   01f7   cd 9c 02      	CALL	LRA		; locate register address
   01fa   a7            	ANA	A
   01fb   ca 92 01      	JZ	ERROR		; not allowed to alter stackpointer
   01fe   23            	INX	H
   01ff   f1            	POP	PSW		; restore value and carry flag
   0200   c3 a7 02      	JMP	IOA		; input octal address
                        ;
                        ;	REGM - enter register display mode.
                        ;
                        ;	ENTRY:	(A) = DSPMOD
                        ;		(BC) = #DSPMOD
                        ;
   0203   3e 02         REGM	MVI	A,00000010B	; Set dispolay to register mode
   0205   02            	STAX	B		; set display register mode
                        ;	ERRNZ	DSPMOD-DSPROT-1	; code assumesDSPMOD follows DSPROT
   0206   0b            	DCX	B		; (BC) = #DSPROT
   0207   af            	XRA	A
   0208   2f            	CMA			; H8 Mini uses '1' for LED segment on - gfr
   0209   02            	STAX	B		; set all periods on
   020a   cd 44 06      	CALL	RCK		; read key entry
   020d   3d            	DCR	A		; displace
   020e   fe 06         	CPI	6
   0210   d2 92 01      	JNC	ERROR		; not 1-6
   0213   07            	RLC
   0214   12            	STAX	D		; set new reg ind
   0215   c9            	RET
                        
                        ;	RW - toggle display/alter mode.
                        ;
                        ;	ENTRY	(A) = DSPMOD
                        ;		(BC) = ADDRESS OF DSPMOD
                        
   0216   ee 01         RW	XRI	1
   0218   02            	STAX	B
   0219   c9            	RET
                        
                        ;	NEXT - Increment display element
                        ;
                        ;	ENTRY	(HL) = (ABUSS)
                        ;		(DE) = address of REGIND
                        ;
   021a   23            NEXT	INX	H
   021b   ca f2 01      	JZ	SAE		; if memory, store values and exit
                        ;
                        ;	Is register mode.
                        ;
   021e   1a            	LDAX	D		; (A) = REGI
   021f   c6 02         	ADI	2		; increment register index
   0221   12            	STAX	D		; wrap to *SP*
   0222   fe 0c         	CPI	12
   0224   d8            	RC			; if not too large, exit
   0225   af            	XRA	A		; overflow
   0226   12            	STAX	D
   0227   c9            ABORT	RET
                        
                        ;	LAST - Increment display element
                        ;
                        ;	ENTRY	(HL) = (ABUSS)
                        ;		(DE) = address of REGIND
                        ;
   0228   2b            LAST	DCX	H
   0229   ca f2 01      	JZ	SAE		; if memory, store and exit
                        ;
                        ;	Is register mode
                        ;
   022c   1a            LST2	LDAX	D		; (A) = REGI
   022d   d6 02         	SUI	2
   022f   12            	STAX	D
   0230   d0            	RNC			; If OK
   0231   3e 0a         	MVI	A,10		; Underflow to *PC*
   0233   12            	STAX	D
   0234   c9            	RET
                        ;
                        ;	MEMM - Enter display memory mode
                        ;
                        ;	ENTRY	(BC) = Address of DSPMOD
                        ;
   0235   af            MEMM	XRA	A		; (A) = 0
   0236   02            	STAX	B		; set display memory mode
                        ;	ERRNZ	DSPMOD-DSPROT-1	; code assumes DSPMOD follows DSPROT
   0237   0b            	DCX	B		; (BC) = #DSPROT
   0238   2f            	CMA			; H8 Mini uses '1' for 
   0239   02            	STAX	B		; set all periods on
   023a   21 15 20      	LXI	H,ABUSS+1
   023d   c3 a7 02      	JMP	IOA		; input octal address
                        
                        ;	IN - Input a data byte
                        ;
                        ;	OUT - Output a data byte
                        ;
                        ;	ENTRY:	(HL) = (ABUSS)
                        ;		(H) = value (for OUT)
                        ;		(L) = port
                        ;
                        ;	EXIT:	ABUSS updated
                        ;		(A) = value (for IN)
                        ;
   0240   06 db         IN	MVI	B,MI.IN		; Store the IN instruction in RAM
   0242   11            	DB	MI.LXID		; clever trick (skip over 'OUT' if doing 'IN')
   0243   06 d3         OUT	MVI	B,MI.OUT	; store the OUT instruction in RAM
   0245   7c            	MOV	A,H		; (A) = value
   0246   65            	MOV	H,L		; (H) = port
   0247   68            	MOV	L,B		; (L) = IN/OUT instruction
   0248   22 02 20      	SHLD	IOWRK		; Store instruction and port
   024b   cd 02 20      	CALL	IOWRK		; do the actual I/O call
   024e   6c            	MOV	L,H		; (L) = port
   024f   67            	MOV	H,A		; (H) = value
   0250   c3 f2 01      	JMP	SAE		; store ABUSS and exit
                        ;
                        ;	GO - return to user mode
                        ;
                        ;	ENTRY	NONE
                        
   0253   3e d0         GO	MVI     A,CB.SSI+CB.CLI+CB.SPK ; off monitor mode light
   0255   c3 60 02              JMP     SST1            ; return to user program
                        
                        
                        ;	SSTEP - SINGLE STEP INSTRUCTION
                        ;
                        ;	ENTRY	NONE
                        
   0258   f3            SSTEP:	DI			; disable interrupts until the right time
   0259   3a 09 20      	LDA	CTLFLG
   025c   ee 10         	XRI	CB.SSI		; clear single step inhibit
   025e   d3 f0         	OUT	OP.CTL		; prime single step interrupt
                        
   0260   32 09 20      SST1	STA	CTLFLG		; set new flag values
   0263   e1            	POP	H		; clean stack
   0264   c3 f0 00      	JMP	INTXIT		; return to user routine for step
                        ;
                        ;	STPRTN - Single step return
                        ;
   0267   f6 10         STPRTN:	ORI	CB.SSI		; disable single step interruption
   0269   d3 f0         	OUT	OP.CTL		; turn off single step enable
   026b   12            	STAX	D
   026c   e6 20         	ANI	CB.MTL		; see if in monitor mode
   026e   c2 a4 01      	JNZ	MTR
   0271   c3 22 20      	JMP	UIVEC+3		; transfer to user's routine
                        ;
                        ;	HORN - make noise
                        ;
                        ;	This routine works completely differently than the PAM/8
                        ;	version. The H8 Mini has to continuously toggle the speaker to
                        ;	generate a tone (the H8 just has to turn on/off a 1kHz square wave).
                        ;	For best results interrupts should be disabled (2ms clock interrupts
                        ;	will otherwise affect the sound).
                        ;
                        ;	To be compatible with the H8 we play "high" C (C6) at 1046.5 Hz.
                        ;
                        ;	ENTRY	(A) = duration (ms.)
                        ;
                        ;	USES	A,F
                        ;
   0274   3e c8         ALARM:	MVI	A,200		; 200 ms. beep
                        
   0276   c5            HORN:	PUSH	B		; BC used for working storage
   0277   4f            	MOV	C,A		; C = duration
   0278   f3            	DI			; interrupts off
   0279   cd 20 06      	CALL	BLANK		; blank the LEDs
                        ;
                        ;	Set speaker to "high" state
                        ;
   027c   db f0         	IN	PPI+IO.A	; Read Port A settings
   027e   e6 3f         	ANI	00111111B	; Clear top two bits (PA6-7)
   0280   f6 80         	ORI	10000000B	; PA7 on; PA6 off
   0282   d3 f0         	OUT	PPI+IO.A	; set speaker bits
                        ;
                        ;	Play the tone
                        ;
   0284   06 35         HDLY1:	MVI	B,53		; half period
                        ;
                        ;	9 uS delay loop
                        ;
   0286   00            HDLY2:	NOP			; 4 T-states
   0287   05            	DCR	B		; 4 T-states
   0288   c2 86 02      	JNZ	HDLY2		; 10 T-states
                        ;
                        ;	Toggle the speaker
                        ;
   028b   db f0         	IN	PPI+IO.A	; Read Port A settings
   028d   ee c0         	XRI	11000000B	; toggle PA6, PA7
   028f   d3 f0         	OUT	PPI+IO.A	; set speaker bits
   0291   17            	RAL			; test bit 7
   0292   da 84 02      	JC	HDLY1		; now wait the other half period
                        	
   0295   0d            	DCR	C		; decrement duration counter
   0296   c2 84 02      	JNZ	HDLY1		; repeat cycle 'til done
                        	
   0299   fb            	EI
   029a   c1            	POP	B
   029b   c9            	RET
                        
                        
                        ;	LRA - LOCATE REGISTER ADDRESS
                        ;
                        ;	ENTRY	NONE.
                        ;	EXIT	(A) = REGISTER INDEX
                        ;		(H,L) = STORAGE ADDRESS
                        ;		(D,E) = (0,A)
                        ;	USES	A,D,E,H,L,F
                        
   029c   3a 05 20      LRA	LDA	REGI
   029f   5f            LRA.	MOV	E,A
   02a0   16 00         	MVI	D,0
   02a2   2a 1d 20      	LHLD	REGPTR
   02a5   19            	DAD	D		; (DE) = (REGPTR)+(REGI)
   02a6   c9            	RET
                        
                        ;	IOA - INPUT OCTAL NUMBER
                        ;
                        ;	ENTRY	(H,L) = ADDRESS OF RECEPTION DOUBLE BYTE.
                        ;	EXIT	TO *RET* IF ERROK
                        ;		TO *RET*+1 IF OK, VALUE IN MEMORY.
                        ;	USES	A,B,E,H,C,F
                        
   02a7   cd ab 02      IOA	CALL	IOB		; INPUT BYTE
   02aa   2b            	DCX	H
                        
                        ;	IOB - INPUT OCTAL BYTE.
                        ;
                        ;	READ ONE OCTAL BYTE FROM THE KEYSET.
                        ;
                        ;	ENTRY	(H,L) = ADDRESS OF BYTE TO HOLD VALUE
                        ;		'C' SET IF FIRST DIGIT IN (A)
                        ;	EXIT	TO *RET* IF ALL OK
                        ;		TO *ERROR* IF ERROR
                        ;	USES	A,D,E,H,L,F
                        
   02ab   16 03         IOB	MVI	D,3		; (D) = DIGIT COUNT
   02ad   d4 44 06      IOB1	CNC	RCK		; READ CONSOLE KEYSET
                        
   02b0   fe 08         	CPI	8
   02b2   d2 92 01      	JNC	ERROR		; IF ILLEGAL DIGIT
                        
   02b5   5f            	MOV	E,A		; (E) = VALUE
   02b6   7e            	MOV	A,M
   02b7   07            	RLC			; SHIFT 3
   02b8   07            	RLC
   02b9   07            	RLC
   02ba   e6 f8         	ANI	370Q
   02bc   b3            	ORA	E
   02bd   77            	MOV	M,A		; REPLACE
   02be   15            	DCR	D
   02bf   c2 ad 02      	JNZ	IOB1		; IF NOT DONE
   02c2   3e 0f         	MVI	A,30/2		; BEEP FOR 30 MS
   02c4   c3 76 02      	JMP	HORN
                        
                        ;	DOD - DECODE FOR OCTAL DISPLAY
                        ;
                        ;	ENTRY	(H,L) = ADDRESS OF LED REFRESH AREA
                        ;		(B) = *OR* PATTERN TO FORCE ON BARS OR PERIODS
                        ;		(A) = OCTAL VALUE
                        ;	EXIT	(H,L) = HEX DIGIT ADDRESS
                        ;	USES	A,B,C,D,H,L
                        
   02c7   d5            DOD	PUSH	D
   02c8   16 06         	MVI	D,DODA/256
   02ca   0e 03         	MVI	C,3
   02cc   17            DOD1	RAL			; LEFT 3 PLACES
   02cd   17            	RAL
   02ce   17            	RAL
   02cf   f5            	PUSH	PSW		; SAVE FOR NEXT DIGIT
   02d0   e6 07         	ANI	7
   02d2   c6 73         	ADI	LOW DODA	; HRJ was DODA#256
   02d4   5f            	MOV	E,A		; (D) = INDEX
   02d5   1a            	LDAX	D		; (A) = PATTERN
   02d6   a8            	XRA	B
   02d7   e6 7f         	ANI	177Q
   02d9   a8            	XRA	B
   02da   77            	MOV	M,A		; SET IN MEMORY
   02db   23            	INX	H
   02dc   78            	MOV	A,B
   02dd   07            	RLC
   02de   47            	MOV	B,A
   02df   f1            	POP	PSW		; (A) = VALUE
   02e0   0d            	DCR	C
   02e1   c2 cc 02      	JNZ	DOD1		; IF MORE TO GO
   02e4   d1            	POP	D
   02e5   c9            	RET			; RETURN
                        
                        ;	UFD - UPDATE FRONT PANEL DISPLAYS.
                        ;
                        ;	UFD IS CALLED BY THE CLOCK INTERRUPT PROCESSOR WHEN IT IS
                        ;	TIME TO UPDATE THE DISPLAY CONTENTS. CURRENTLY, THIS IS DONE
                        ;	EVERY 32 INTERRUPTS, OR ABOUT 32 TIMES A SECOND.
                        ;
                        ;	ENTRY	(H,L) = ADDRESS OF REFCNT
                        ;		(B) = MFLAG 	(gfr)
                        ;
                        ;	EXIT	NONE
                        ;	USES	ALL
                        
   02e6   3e 02         UFD	MVI	A,UO.DDU	; Disable Display Update
   02e8   a0            	ANA	B		; in MFLAG?
   02e9   c0            	RNZ			; IF NOT TO HANDLE UPDATE
                        
   02ea   2e 06         	MVI	L,LOW DSPROT	; (HL) = DSPROT (same page)
   02ec   7e            	MOV	A,M		; fetch period pattern
   02ed   07            	RLC			; rotate it left
   02ee   77            	MOV	M,A		; and save
   02ef   47            	MOV	B,A
   02f0   23            	INX	H		; now point to DSPMOD
                        ;	ERRNZ	DSPMOD-DSPROT-1	; code assumes DSPMOD follows DSPROT
   02f1   7e            	MOV	A,M		; (A) = DSPMOD
   02f2   e6 02         	ANI	00000010B	; Memory display mode?
   02f4   2a 14 20      	LHLD	ABUSS
   02f7   ca 0c 03      	JZ	UFD1		; IF MEMORY
                        
                        ;	Displaying registers
                        
   02fa   cd 9c 02      	CALL	LRA		; LOCATE REGISTER ADDRESS
   02fd   e5            	PUSH	H
   02fe   21 67 06      	LXI	H,DSPA
   0301   19            	DAD	D		; (H,L) = ADDRESS OF REG NAME PATTERNS
   0302   7e            	MOV	A,M
   0303   23            	INX	H
   0304   66            	MOV	H,M
   0305   6f            	MOV	L,A		; (H,L) = REG NAME PATTERN
   0306   e3            	XTHL
   0307   b4            	ORA	H		; CLEAR 'Z'
   0308   7e            	MOV	A,M
   0309   23            	INX	H
   030a   66            	MOV	H,M
   030b   6f            	MOV	L,A		; (HL) = ADDRESS OF REGISTER PAIR CONTENTS
                        
                        ;	Displaying Memory
                        
   030c   f5            UFD1	PUSH	PSW
   030d   eb            	XCHG
   030e   21 0b 20      	LXI	H,ALEDS
   0311   7a            	MOV	A,D
   0312   cd c7 02      	CALL	DOD		; FORMAT ABANK HIGH HALF
   0315   7b            	MOV	A,E
   0316   cd c7 02      	CALL	DOD		; FORMAT ABANK LOW HALF
   0319   f1            	POP	PSW
   031a   1a            	LDAX	D
   031b   ca c7 02      	JZ	DOD		; IF MEMORY, DECODE BYTE VALUE
                        
                        ;	IS REGISTER, SET REGISTER NAME,
                        
   031e   36 00         	MVI	M,0		; CLEAR DIGIT - gfr
   0320   e1            	POP	H
   0321   22 12 20      	SHLD	DLEDS+1
   0324   c9            	RET
                        
                        ;	$HLIHL - Load HL indirect through HL
                        ;
                        ;	(HL) = ((HL))
                        ;
                        ;	USES:	A,H,L
   0325   7e            $HLIHL:	MOV	A,M
   0326   23            	INX	H
   0327   66            	MOV	H,M
   0328   6f            	MOV	L,A
   0329   c9            	RET
                        
                        ;	I/O ROUTINES TO BE COPIED INTO AND USED IN RAM.
                        ;
                        ;	MUST CONTINUE TO 3777A FOR PROPER COPY.
                        ;	THE TABLE MUST ALSO BE BACKWARDS TO THE FINAL RAM.
                        
   03f9                 	ORG	0400H-7
                        
   03f9   01            PRSROM:	DB	1	; REFIND
   03fa   00            	DB	0	; CTLFLG
   03fb   00            	DB	0	; MFLAG
   03fc   00            	DB	0	; DSPMOD
   03fd   00            	DB	0	; DSPROT
   03fe   0a            	DB	10	; REGI
   03ff   c9            	DB	MI.RET
                        
                        
                        
                        
                        ;
                        ;	Here is a modified version of Jon Chapman's
                        ;	GWMON. Jumping here invokes the console monitor loop.
                        ;	All initialization code has been moved to the main
                        ;	PAM-8 section.
                        ;
                        ;	- gfr
                        ;
                        ;SM8085R1 -- GWMON-80 Small Monitor for 8085 SBC rev 1
                        ;
                        ;This customization uses the 8085's built-in serial I/O and
                        ;is configured for the Glitch Works 8085 SBC rev 1 memory
                        ;map. By Jon Chapman, Glitch Works.
                        ;
                        ;;Modified by Lee Hart for H8 Mini - 9 Aug 2026
                        ;;double semicolons denote changes from Jon Chapman's code
                        ;;resume editing at ------------
                        ;;
                        ;
                        ;Hardware Equates
                        ;
                        ;;H8 Mini memory map, 27C256 32k ROM, jumper P3 in ROM position
                        ;; ROM at 0-1FFFh, 8000-FFFF (0-1FFFh mirrors 8000-9FFFh)
                        ;; RAM at 2000-7FFFh
                        
                        ; get console ready for I/O
                        ;
                        ;
                        ;	To maintain known entry points for useful routines
                        ;	we put the appropriate jump instructions here
                        
   0400                 	ORG	0400H
                        	
   0400   c3 0c 04      	JMP	GWMON		; 400H - Main monitor entry point
   0403   c3 1c 04      	JMP	WSTART		; 403H - warm restart
   0406   c3 d9 05      	JMP	CINNE		; 406H - Read character from console (no echo)
   0409   c3 fc 05      	JMP	COUT		; 409H - Write character to console
                        	
                        
   040c   af            GWMON:	XRA	A		;NUL in A
   040d   cd fc 05      	CALL	COUT		;Clear the line
                        	
   0410   21 f8 04      	LXI	H, SIGNON$	; SM signon
   0413   cd e8 04      	CALL	PRTCLS
                        	
   0416   21 09 00      	LXI	H, PAMVER$	; report PAM/8 version too
   0419   cd e8 04      	CALL	PRTCLS
                        ;
                        ;WSTART -- Warm start routine
                        ;
                        ;Falls through to the command processor.
                        ;
   041c   31 00 80      WSTART: LXI	SP,STACK	; Reload stack pointer
                        
                        ;
                        ;SCP -- GWMON-80 Small Command Processor
                        ;
                        ;This is the small command processor for Glitch Works
                        ;Monitor for 8080/8085/Z80 and compatible.
                        ;
                        
                        
                        ;
                        ;CMDLP -- Small command processor loop
                        ;
                        ;Get a character from the console device and immediately 
                        ;handle it by passing off to helper function.
                        ;
                        ;Falls through to ERROR if an invalid command is specified.
                        ;
   041f   21 1c 04      CMDLP:	LXI	H,WSTART	; (HL) = warm start address
   0422   e5            	PUSH	H		; prime stack for RET
                        
   0423   21 07 05      	LXI	H,PROMPT$	; console prompt
   0426   cd e8 04      	CALL	PRTCLS		; print it
   0429   cd 6b 04      	CALL	CIN		; wait for single character
   042c   f6 20         	ORI	20H		; allow lowercase input
                        ;
                        ;	Command dispatch
                        ;
   042e   21 c5 05      	LXI	H,CMDTAB-1
   0431   23            CMDLP1:	INX	H		; Point to next valid command char
   0432   be            	CMP	M		; match?
   0433   ca 48 04      	JZ	RUNCMD		; yes, run command handler
   0436   47            	MOV	B,A		; save user entry
   0437   7e            	MOV	A,M		; examine command
   0438   b7            	ORA	A		; set flags
   0439   78            	MOV	A,B		; restore user entry
   043a   23            	INX	H		; Get past handler address
   043b   23            	INX	H
   043c   c2 31 04      	JNZ	CMDLP1		; fall through if at end of table
                        
                        ;
                        ;ERRMSG -- Print generic error message and abort
                        ;
                        ;Falls through to PRTERR.
                        ;
   043f   21 0f 05      ERRMSG:	LXI	H,ERR$		;Fall through to PRTERR
                        
                        ;
                        ;PRTERR -- Print a null-terminated error string
                        ;
                        ;entry: HL contains pointer to start of null-terminated string
                        ;exit: string at HL printed to console
                        ;exit: program execution returned to command loop
                        ;
   0442   cd e8 04      PRTERR:	CALL	PRTCLS
   0445   c3 1c 04      	JMP	WSTART		;Warm start, restore SP
                        
                        ;
                        ;RUNCMD -- Run a command handler from CMDTAB
                        ;
                        ;entry: H register points to command letter
                        ;exit: control transferred to command handler
                        ;
   0448   cd d9 04      RUNCMD:	CALL	PRTSPC
   044b   23            	INX	H		;Point to low handler address
   044c   5e            	MOV	E,M
   044d   23            	INX	H
   044e   56            	MOV	D,M
   044f   eb            	XCHG
   0450   e9            	PCHL
                        
                        ;
                        ;GETADR -- Get a 16-bit address from the console
                        ;
                        ;pre: none
                        ;post: HL contains address from console
                        ;
   0451   cd 5a 04      GETADR:	CALL	GETHEX
   0454   67            	MOV	H,A
   0455   cd 5a 04      	CALL	GETHEX
   0458   6f            	MOV	L,A
   0459   c9            	RET
                        
                        ;
                        ;GETHEX -- Get byte from console as hex
                        ;
                        ;Enter at GETHE2 with character in A register from EDTCMD.
                        ;
                        ;entry: none
                        ;exit: A register contains byte from hex input
                        ;exit: Carry flag set if non-hex character received
                        ;
   045a   cd 6b 04      GETHEX:	CALL	CIN
   045d   e5            GETHE2:	PUSH	H
   045e   67            	MOV	H,A
   045f   cd 6b 04      	CALL	CIN
   0462   6f            	MOV	L,A
   0463   cd 71 04      	CALL	HEXBYT
   0466   e1            	POP	H
   0467   da 3f 04      	JC	ERRMSG		;Invalid hex char, abort
   046a   c9            	RET
                        ;;end of INCLUDE 'SCP.INC'
                        					
                        ;;	INCLUDE	'common.inc' (included inline)
                        ;
                        ;COMMON -- Functions Common to SM and XM
                        ;
                        ;These functions are used by both the SM and XM versions
                        ;of GWMON-80.
                        ;
                        
                        
                        ;
                        ;CIN -- Get a char from the console and echo
                        ;
                        ;Returns through COUT.
                        ;
                        ;entry: console device is initialized
                        ; exit: received char is in A register
                        ;		received char is echoed
                        ;
   046b   cd d9 05      CIN:	CALL	CINNE
   046e   c3 fc 05      	JMP	COUT
                        
                        ;
                        ;HEXBYT -- Convert pair of ASCII characters to byte
                        ;
                        ;entry: H register contains high ASCII coded hex nybble
                        ;		L register contains low ASCII coded hex nybble
                        ; exit: A register contains converted byte
                        ;		CY flag set if non-hex character input
                        ;		Z flag set if conversion results in 0x00
                        ;
   0471   7c            HEXBYT:	MOV	A,H
   0472   cd 82 04      	CALL	ASCHEX
   0475   d8            	RC
   0476   07            	RLC
   0477   07            	RLC
   0478   07            	RLC
   0479   07            	RLC
   047a   67            	MOV	H,A
   047b   7d            	MOV	A,L
   047c   cd 82 04      	CALL	ASCHEX
   047f   d8            	RC
   0480   b4            	ORA	H
   0481   c9            	RET
                        
                        ;
                        ;ASCHEX -- Convert ASCII character to hex nybble
                        ;
                        ;entry: A register contains ASCII coded nybble
                        ; exit: A register contains nybble
                        ;		CY flag set if ASCII character is invalid hex
                        ;
   0482   d6 30         ASCHEX:	SUI	'0'		; remove ASCII bias
   0484   d8            	RC			; Return error if less than 0
   0485   fe 0a         	CPI	10		; check for hex
   0487   3f            	CMC			; Clear CY
   0488   f8            	RM			; if [0..9] ... done
   0489   e6 5f         	ANI	01011111B	; Upper case
   048b   d6 07         	SUI	'A'-'9'-1	; ASCII to hex bias
   048d   fe 10         	CPI	16		; check for hexadecimal range
   048f   3f            	CMC			; return error if >= 16
   0490   c9            	RET
                        
                        ;
                        ;HEXDMP -- Hex dump memory to console
                        ;
                        ;This routine prints the contents of memory starting at HL
                        ;and ending at DE in 16-byte blocks.
                        ;
                        ;entry: HL register pair contains starting address
                        ;		DE register pair contains ending address
                        ; exit:	contents of memory printed to console
                        ;
   0491   06 00         HEXDMP:	MVI	B,0		;Initialize B as completion flag
                        
   0493   cd b4 04      HEXDM1:	CALL	PRTADR
   0496   0e 10         	MVI	C,16		;C = line loop counter
   0498   cd d9 04      HEXDM2:	CALL	PRTSPC
   049b   cd c4 04      	CALL	DMPLOC
   049e   7b            	MOV	A,E		;A = low byte of end address
   049f   bd            	CMP	L		;Compare current low byte
   04a0   c2 a9 04      	JNZ	HEXDM3
   04a3   7a            	MOV	A,D		;A = high byte of end address
   04a4   bc            	CMP	H		;Compare current high byte
   04a5   c2 a9 04      	JNZ	HEXDM3
   04a8   05            	DCR	B		;B = nonzero, done
                        
   04a9   23            HEXDM3:	INX	H		;Increment current address pointer
   04aa   0d            	DCR	C
   04ab   c2 98 04      	JNZ	HEXDM2		;Print more lines
                        
   04ae   78            	MOV	A,B
   04af   b7            	ORA	A
   04b0   ca 93 04      	JZ	HEXDM1		;Yes, dump more memory
   04b3   c9            	RET			;No, done
                        
                        ;
                        ;PRTADR -- Print an address to the console
                        ;
                        ;Prints CR, LF, a 16-bit address, a space, and a colon. 
                        ;Destroys A register contents.
                        ;
                        ;Returns through COUT.
                        ;
                        ;entry: HL pair contains address to print
                        ; exit: HL printed to console as hex
                        ;
   04b4   cd de 04      PRTADR: CALL	CRLF
   04b7   7c            	MOV	A,H
   04b8   cd c5 04      	CALL	PRTHEX
   04bb   7d            	MOV	A,L
   04bc   cd c5 04      	CALL	PRTHEX
   04bf   3e 3a         	MVI	A,':'
   04c1   c3 fc 05      	JMP	COUT
                        
                        ;
                        ;DMPLOC -- Print a byte at HL to console
                        ;
                        ;Falls through to PRTHEX.
                        ;
                        ;pre: HL pair contains address of byte
                        ;post: byte at HL printed to console
                        ;
   04c4   7e            DMPLOC:	MOV	A,M
                        
                        ;
                        ;PRTHEX -- Output byte to console as hex
                        ;
                        ;Falls through to PRTNIB.
                        ;
                        ;entry: A register contains byte to be output
                        ; exit: byte is output to console as hex
                        ;
   04c5   f5            PRTHEX: PUSH	PSW		;Save A register on stack
   04c6   0f            	RRC			;Rotate high nybble down
   04c7   0f            	RRC
   04c8   0f            	RRC
   04c9   0f            	RRC
   04ca   cd ce 04      	CALL	PRTNIB		;Print high nybble
   04cd   f1            	POP	PSW		;Restore A register
                        
                        ;
                        ;PRTNIB -- Print hex nybble on console
                        ;
                        ;Returns through COUT.
                        ;
                        ;entry: A register contains nybble
                        ; exit: nybble printed to console
                        ;
   04ce   e6 0f         PRTNIB:	ANI	0FH		;Mask off low nybble
   04d0   c6 90         	ADI	90H
   04d2   27            	DAA
   04d3   ce 40         	ACI	40H
   04d5   27            	DAA
   04d6   c3 fc 05      	JMP	COUT
                        
                        ;
                        ;PRTSPC -- Print a space to the console
                        ;
                        ;Returns through COUT.
                        ;
                        ;pre: none
                        ;post: ASCII space printed to console
                        ;
   04d9   3e 20         PRTSPC:	MVI	A,' '
   04db   c3 fc 05      	JMP	COUT
                        
                        ;
                        ;CRLF -- Print a CR, LF
                        ;
                        ;Returns through COUT.
                        ;
                        ;entry: none
                        ; exit: CR, LF printed to console
                        ;
   04de   3e 0d         CRLF:	MVI	A,CR
   04e0   cd fc 05      	CALL	COUT
   04e3   3e 0a         	MVI	A,LF
   04e5   c3 fc 05      	JMP	COUT
                        ;
                        ;PRTCLS -- Print CR, LF, and a high bit terminated string
                        ;
                        ;Falls through to PRTSTR
                        ;
                        ;entry: HL contains pointer to start of string
                        ; exit: CR, LF, and string at HL printed to console
                        ;
   04e8   cd de 04      PRTCLS:	CALL	CRLF
                        
                        ;
                        ;PRTSTR -- Print a high bit terminated string
                        ;
                        ;Destroys contents of A register.
                        ;
                        ;entry: HL contains pointer to start of string
                        ; exit: string at HL printed to console
                        ;
   04eb   7e            PRTSTR:	MOV	A, M
   04ec   e6 7f         	ANI	07FH		;Strip high bit
   04ee   cd fc 05      	CALL	COUT
   04f1   7e            	MOV	A,M
   04f2   b7            	ORA	A		;Set flags
   04f3   f8            	RM			;High bit set, done
   04f4   23            	INX	H
   04f5   c3 eb 04      	JMP	PRTSTR
                        ;;end of INCLUDE 'common.inc'
                        
                        ;; ---------------------
                        ;;
                        ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        ;Small Monitor Strings
                        ;
                        ;These strings are terminated by setting the high bit in the
                        ;last character.
                        ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   04f8   47 57 4d 4f   SIGNON$:	DB 'GWMON-80 1.1 S', 'M' + 80H
   04fc   4e 2d 38 30   
   0500   20 31 2e 31   
   0504   20 53 cd      
   0507   0a be         PROMPT$:	DB LF, '>' + 80H
   0509   43 4b 53 55   CSERR$:		DB 'CKSUM '
   050d   4d 20         
   050f   45 52 52 4f   ERR$:		DB 'ERRO', 'R' + 80H
   0513   d2            
                        
                        ;;end of INCLUDE 'sm.inc'
                        
                        ;;	INCLUDE	'scmdstd.inc'	;SM standard commands
                        ;
                        ;SCMDSTD -- Small Monitor Standard Commands
                        ;
                        ;This file contains implementations of all standard SM
                        ;commands. The command table is located at the end of the
                        ;file.
                        ;
                        
                        ;
                        ;HDCMD -- Hex dump command
                        ;
   0514   cd 51 04      HDCMD:	CALL	GETADR		;HL = start address
   0517   eb            	XCHG			;DE = start address
   0518   cd d9 04      	CALL	PRTSPC
   051b   cd 51 04      	CALL	GETADR		;HL = end address
   051e   eb            	XCHG			;HL = start, DE = end
   051f   c3 91 04      	JMP	HEXDMP		;Return through HEXDMP
                        
                        ;
                        ;EDTCMD -- Edit memory command
                        ;
                        ;Breaks out to main command loop through GETHEX jump to
                        ;WSTART.
                        ;
   0522   cd 51 04      EDTCMD:	CALL	GETADR		;HL = address to open
   0525   cd b4 04      EDTCM1:	CALL	PRTADR		;Print location address
   0528   cd d9 04      	CALL	PRTSPC
   052b   cd c4 04      	CALL	DMPLOC		;Print contents of location
   052e   cd d9 04      	CALL	PRTSPC
   0531   cd 6b 04      	CALL	CIN		;Get user input
   0534   fe 0d         	CPI	NEXTLOC		;Check for NEXTLOC character
   0536   ca 43 05      	JZ	EDTCM2		;Yes, go to next location
   0539   cd 5d 04      	CALL	GETHE2		;No, process as hex input
   053c   77            	MOV	M,A
   053d   cd d9 04      	CALL	PRTSPC
   0540   cd c4 04      	CALL	DMPLOC		;Print contents of location (verification)
   0543   23            EDTCM2:	INX	H
   0544   c3 25 05      	JMP	EDTCM1
                        
                        ;
                        ;GOCMD -- Call out to a specified address
                        ;
                        ;The stack is primed with the GWMON-80 warm start address.
                        ;Called program can return control to GWMON-80 through a RET
                        ;as long as the stack is not disturbed.
                        ;
   0547   cd 51 04      GOCMD:	CALL	GETADR		;HL = Address to call
   054a   e9            	PCHL			;Go to specified address
                        
                        ;
                        ;INPCMD -- Input to port command; print value to console
                        ;
                        ;	Revised to use PAM-8 port I/O routine
                        ;		-gfr
                        ;
   054b   cd 5a 04      INPCMD:	CALL	GETHEX		; Get port from console
   054e   6f            	MOV	L,A		; save in (L)
   054f   cd d9 04      	CALL	PRTSPC		; space separator
   0552   cd 40 02      	CALL	IN		; input via PAM-8 IN routine
   0555   c3 c5 04      	JMP	PRTHEX		; display the result
                        
                        ;
                        ;OUTCMD -- Output to port command
                        ;
                        ;	Revised to use PAM-8 port I/O routine
                        ;		-gfr
                        ;
   0558   cd 5a 04      OUTCMD:	CALL	GETHEX		; get port number
   055b   6f            	MOV	L,A		; (L) = port
   055c   cd d9 04      	CALL	PRTSPC		; space separator
   055f   cd 5a 04      	CALL	GETHEX		; get value to output
   0562   67            	MOV	H,A		; (H) = value
   0563   c3 43 02      	JMP	OUT		; output via PAM-8 OUT routine
                        
                        ;
                        ;LODCMD -- Load an Intel HEX file from console
                        ;
                        ;This loader accepts data with both CR (*NIX) and
                        ;CR,LF (DOS/Windows) terminated lines.
                        ;
                        ;Intel HEX record may be ended with:
                        ;   * DATA (0x00) record with length of 0
                        ;   * Any nonzero record type
                        ;
                        ; exit: Intel HEX file loaded, or error printed
                        ;
                        ; First suspend all clock interrupts (RST 7.5) and clear LEDs. We leave
                        ; other interrupts running in anticipation of interrupt-driven serial
                        ; I/O in the future.
                        ;
   0566   20            LODCMD:	RIM			; Read interrupt mask
   0567   e6 03         	ANI	00000011B	; leave 5.5 and 6.5 alone
   0569   f6 0c         	ORI	00001100B	; 7.5 HIGH (interrupts off)
   056b   30            	SIM			; set new mask
                        	
   056c   cd 20 06      	CALL	BLANK		; blank the LEDs
                        ;
                        ;	Loop over records
                        ;
   056f   cd de 04      LODCM0:	CALL	CRLF		; start a new ouput line
   0572   cd d9 05      LODCM1:	CALL	CINNE		; read a byte
   0575   fe 3a         	CPI	':'		; all records start with ':'
   0577   c2 72 05      	JNZ	LODCM1		; Wait for start colon
                        ;
                        ;	Have new record
                        ;
   057a   cd fc 05      	CALL	COUT		; Print starting colon
   057d   cd 5a 04      	CALL	GETHEX		; Get record length
   0580   ca a6 05      	JZ	LODCM4		; Length == 0, done
   0583   47            	MOV	B,A		; Record length in B
   0584   4f            	MOV	C,A		; Start checksumming in C
                        
   0585   cd 51 04      	CALL	GETADR		; HL = 16-bit starting address
   0588   81            	ADD	C		; A == L from GETADR
   0589   84            	ADD	H
   058a   4f            	MOV	C,A		; Checksum
                        
   058b   cd 5a 04      	CALL	GETHEX		; Get record type
   058e   c2 a6 05      	JNZ	LODCM4		; Not Record Type 00 (DATA), done
                        ;
                        ;	Process the record
                        ;
   0591   cd 5a 04      LODCM2:	CALL	GETHEX		; This record processing loop
   0594   77            	MOV	M,A		; Store char at HL
   0595   81            	ADD	C
   0596   4f            	MOV	C,A		; update checksum
   0597   23            	INX	H		; point to next destination
   0598   05            	DCR	B		; decrement the line count
   0599   c2 91 05      	JNZ	LODCM2		; Not done with the line
                        	
   059c   cd 5a 04      LODCM3:	CALL	GETHEX		; Get checksum byte
   059f   81            	ADD	C
   05a0   c2 b1 05      	JNZ	CSUMER		; Checksum bad, print error
   05a3   c3 6f 05      	JMP	LODCM0		; Process more records
                        ;
                        ;	Done getting data, eat remaining characters.
                        ;
   05a6   cd 6b 04      LODCM4:	CALL	CIN		; grab a byte
   05a9   fe 0a         	CPI	LF		; end of line?
   05ab   c2 a6 05      	JNZ	LODCM4		; No LF, keep eating
   05ae   c3 b7 05      	JMP	LODEXT		; Got LF, done!
                        ;
                        ;	Checksum error
                        ;
   05b1   21 09 05      CSUMER:	LXI	H,CSERR$	; Print checksum error to console
   05b4   cd 42 04      	CALL	PRTERR
                        ;
                        ;	Exit, reenable clock interrupts and LED refresh.
                        ;
   05b7   20            LODEXT:	RIM			; Read interrupt mask
   05b8   e6 03         	ANI	00000011B	; leave 5.5 and 6.5 alone
   05ba   f6 08         	ORI	00001000B	; 7.5 LOW (interrupts on)
   05bc   30            	SIM			; set new mask
                        
   05bd   3a 08 20      	LDA	MFLAG		; get MFLAG byte
   05c0   e6 bf         	ANI	377Q-UO.NFR	; turn on FP refresh
   05c2   32 08 20      	STA	MFLAG		; save it
   05c5   c9            	RET			; and done...
                        
                        ;
                        ;	CMDTAB -- Table/array of commands
                        ;
                        ;	Table entry structure:
                        ;	  * Single command character, lowercase only (0x00 = end)
                        ;	  * Pointer to implementation routine
                        ;
   05c6   64            CMDTAB:	DB	'd'
   05c7   14 05         	DW	HDCMD
   05c9   65            	DB	'e'
   05ca   22 05         	DW	EDTCMD
   05cc   67            	DB	'g'
   05cd   47 05         	DW	GOCMD
   05cf   69            	DB	'i'
   05d0   4b 05         	DW	INPCMD
   05d2   6c            	DB	'l'
   05d3   66 05         	DW	LODCMD
   05d5   6f            	DB	'o'
   05d6   58 05         	DW	OUTCMD
                        	
   05d8   00            NULCMD:	DB	0		; terminate command list
                        
                        				;;end of INCLUDE 'scmdnull.inc'
                        ;;---------------
                        ;;	INCLUDE	'8085sio1.inc'	;Intel 8085 SID/SOD driver
                        ;
                        ;8085SIO1 -- Console I/O Drivers for 8085 Built-In Serial
                        ;
                        ;
                        
                        	
                        ;
                        ;	CINNE -- Get a char from the console, no echo
                        ;
                        ;	This is a blocking read. We wait until a character is available.
                        ;	Since serial I/O is interrupt-driven we simply look to see if
                        ;	a byte is available. If not, we wait otherwise retrieve the byte
                        ;	and shift the buffer contents down one. We put interrupts on hold
                        ;	while we're playing with these values.
                        ;
   05d9   e5            CINNE:	PUSH	H
   05da   c5            	PUSH	B
                        	
   05db   21 36 20      	LXI	H,INBADDR	; (HL) = address of buffer location
   05de   cd 25 03      	CALL	$HLIHL		; (HL) = buffer
   05e1   7e            CINN1:	MOV	A,M		; get byte count
   05e2   b7            	ORA	A		; test for zero
   05e3   ca e1 05      	JZ	CINN1		; loop if nothing there
                        ;
                        ;	we have a byte in the buffer! - load it and return
                        ;
   05e6   f3            	DI			; don't step on the IRQ handler
                        	
   05e7   35            	DCR	M		; decrement the byte count
   05e8   4e            	MOV	C,M		; (C) = count - 1
   05e9   23            	INX	H		; point to byte to be read
   05ea   46            	MOV	B,M		; (B) = character we want
                        	
   05eb   0d            CINN2:	DCR	C		; move others down
   05ec   fa f7 05      	JM	CINN3		; no more
   05ef   23            	INX	H		; next one
   05f0   7e            	MOV	A,M		; fetch it
   05f1   2b            	DCX	H		; back one
   05f2   77            	MOV	M,A		; store it
   05f3   23            	INX	H		; fix pointer
   05f4   c3 eb 05      	JMP	CINN2		; and loop
                        	
   05f7   fb            CINN3:	EI			; restore interrupts
   05f8   78            	MOV	A,B		; get back our byte
                        	
   05f9   c1            	POP	B
   05fa   e1            	POP	H
                        
                        ;	warm restart feature disabled - gfr
                        ;	
                        ;	CPI	CANCEL		; Check for CANCEL character
                        ;	JZ	WSTART		; Yes, warm start monitor
   05fb   c9            	RET
                        	
                        
                        ;
                        ;COUT -- Output a character to the console
                        ;
                        ;This routine *must* preserve the contents of the A register
                        ;or CIN will not function properly.
                        ;
                        ;Interrupts are disabled to maintain critical timing in this
                        ;routine. They are unconditionally re-enabled before return.
                        ;
                        ;entry: A register contains char to be printed
                        ;		BITTIME, HALFBIT are initialized
                        ; exit: character is printed to the console
                        ;		interrupts are enabled
                        ;
   05fc   f5            COUT:	PUSH	PSW		;Preserve char in A
   05fd   c5            	PUSH	B		;Preserve registers
   05fe   e5            	PUSH	H
   05ff   f3            	DI			;Must disable interrupts
   0600   4f            	MOV	C,A		;C = character to output
   0601   af            	XRA	A		;Clear CY
   0602   06 0a         	MVI	B,10		;Bit count for entire serial transaction (10 - gfr)
                        
   0604   3e 80         CO1:	MVI	A,80H		;Set what will become SOD enable bit
   0606   1f            	RAR			;Move CY into SOD data bit
   0607   30            	SIM			;Output it on SOD
   0608   21 37 01      	LXI	H,BITTIME	;Delay one bit time
   060b   2d            CO2:	DCR	L
   060c   c2 0b 06      	JNZ	CO2
   060f   25            	DCR	H
   0610   c2 0b 06      	JNZ	CO2
                        
   0613   37            	STC			;Set CY, will become stop bit	
   0614   79            	MOV	A,C		
   0615   1f            	RAR			;Get a bit from the byte to output into CY
   0616   4f            	MOV	C,A
   0617   05            	DCR	B		;Decrement bit count
   0618   c2 04 06      	JNZ	CO1		;Not done, send more bits
                        		
   061b   e1            	POP	H		;Restore registers
   061c   c1            	POP	B
   061d   fb            	EI
                        
   061e   f1            	POP	PSW		;A = char printed
   061f   c9            	RET
                        
                        ;	END GWMON Code
                        
                        ;
                        ;	BLANK - ensure that all LED segments are extinguished.
                        ;
                        ;	This is useful when interrupts are disabled for any noticeable period of
                        ;	time, otherwise some LED segments will appear to be "stuck" on (as the
                        ;	interrupt-driven refresh cycle was stopped mid refresh.)  Typically
                        ;	immediately preceded by a DI instruction.
                        ;
                        ;	USES:	A,F
                        ;
   0620   c5            BLANK:	PUSH	B		; BC used for working storage
                        
   0621   db f0         	IN	PPI+IO.A	; read port A settings
   0623   e6 f0         	ANI	11110000B	; clear LED selects (PA0..PA3)
   0625   47            	MOV	B,A		; save it
   0626   0e 09         	MVI	C,9		; 9 LEDs, work right to left
   0628   81            BLOOP:	ADD	C		; address an LED
   0629   d3 f0         	OUT	PPI+IO.A	; select it
   062b   af            	XRA	A		; zero = all segments off
   062c   d3 f1         	OUT	PPI+IO.B	; turn off all segments
   062e   78            	MOV	A,B		; get back mask
   062f   0d            	DCR	C		; count down
   0630   c2 28 06      	JNZ	BLOOP		; and loop through all 9
                        
   0633   c1            	POP	B
   0634   c9            	RET
                        
                        
                        ;	DLYNOI - Delay with No Interrupts. Delays the specified number of
                        ;	2ms intervals, e.g. if A = 100/2 then delay 100 ms.
                        ;
                        ;	Functionally equivalent to the original Heath DLY routine
                        ;	but for use when interrupts are disabled. Uses simple nested
                        ;	loop counters to delay.
                        ;
                        ;	Timing parameters are tuned for an 8085 running at 2Mhz.
                        ;
                        ;	USES:	A,F
                        ;
                        ; =====================================================================
   0635   c5            DLYNOI:	PUSH	B		; BC used for working storage
   0636   47            	MOV	B,A		; B = outer loop counter
                        ;
                        ;	Each inner loop takes 18 T-states or 9 uS of time. 222 repetitions
                        ;	gives 1,998 uS of time.
                        ;
   0637   0e de         OUTER:	MVI	C,222		; 222 * 9 ~= 2 ms
   0639   00            INNER:	NOP			; kill time (4 T-states)
   063a   0d            	DCR	C		; decrement inner counter (4 T-states)
   063b   c2 39 06      	JNZ	INNER		; count down (10 T-states each jump)
                        	
   063e   05            	DCR	B		; decrement outer counter
   063f   c2 37 06      	JNZ	OUTER		; loop 'til done
                        	
   0642   c1            	POP	B		; restore BC
   0643   c9            	RET
                        
                        ;	RCK - Read Console Keypad
                        ;
                        ;	RCK is called to read a keystroke from the console keypad.
                        ;	Read operations are blocking - the routine will wait until a key
                        ;	is pressed before returning.
                        ;
                        ;	This version differs substantially from the original PAM/8 version.
                        ;	The H8 Mini multiplexes the LED panel refresh with keypad reads. Reading a
                        ;	keystroke, therefore, is broken into two components: an interrupt-time
                        ;	service routine (PCK) and a task-time routine to return the result (RCK).
                        ;	Probe Console Keypad (PCK) is called at each 2ms interrupt, however it takes
                        ;	9 calls to scan all possible keys, therefore it can take up to 18ms to
                        ;	detect and return a keystroke.
                        ;
                        ;	RCK performs debouncing, and auto-repeat. a *bip* is sounded
                        ;	when a value is accepted.
                        ;
                        ;	EXIT:	Key value in (A):
                        ;
                        ;	Key	  Value (decimal)
                        ;	0-9		0-9
                        ;	'+'		10
                        ;	'-'		11
                        ;	'*'		12
                        ;	'/'		13
                        ;	'#'		14
                        ;	'.'		15
                        ;
                        ;	USES	A,F
                        ;
   0644   e5            RCK:	PUSH	H
   0645   c5            	PUSH	B
                        	
   0646   0e 28         	MVI	C,ARDLY/DBDLY	; loop for auto-repeat
   0648   21 16 20      	LXI	H,RCKA		; point to keypad byte
                        ;
                        ;	First wait for some keyboard action
                        ;
   064b   3a 34 20      RCK1:	LDA	PCKVAL		; get most recent key hit
   064e   47            	MOV	B,A		; save it
   064f   3e 05         	MVI	A,DBDLY/2	; delay to debounce
   0651   cd 53 00      	CALL	DLY
   0654   78            	MOV	A,B		; get back candidate
                        	
   0655   be            	CMP	M		; compare to RCKA
   0656   c2 5d 06      	JNZ	RCK2		; have a change
   0659   0d            	DCR	C		; wait N cycles (auto repeat)
   065a   c2 4b 06      	JNZ	RCK1		; changed, start over
                        
   065d   77            RCK2:	MOV	M,A
   065e   b7            	ORA	A		; set flag bits
   065f   fa 4b 06      	JM	RCK1		; bit 7 set... no key pressed
                        ;
                        ;	have a key
                        ;	
                        ;
                        ;	Make noise here...
                        ;
   0662   e6 0f         	ANI	17Q		; make sure it's 4 bits
                        	
   0664   c1            	POP	B
   0665   e1            	POP	H
   0666   c9            	RET
                        
                        ;	DISPLAY SEGMENT CODING:
                        ;
                        ;	BYTE = 76 5453 210
                        ;
                        ;	   1
                        ;	  ---
                        ;	6|   |2
                        ;	 | 0 |
                        ;	  ---
                        ;	5|   |3
                        ;	 |   |
                        ;	  --- o7
                        ;	   4
                        
                        ;	Register index to 7-segment pattern
                        ;
                        ;	NOTE: H8 Mini is inverse of H8
                        
   0667   5b 67         DSPA:	DW	675BH		; SP
   0669   6f 63         	DW	636FH		; AF
   066b   79 72         	DW	7279H		; BC
   066d   3d 73         	DW	733DH		; DE
   066f   6d 70         	DW	706DH		; HL
   0671   67 31         	DW	3167H		; PC
                        
                        ;	Octal to 7-segment pattern
                        ;
                        ;	NOTE: H8 Mini is inverse of H8
                        
                        
   0673   7e            DODA:	DB	7EH		; 0
   0674   0c            	DB	0CH		; 1
   0675   37            	DB	37H		; 2
   0676   1f            	DB	1FH		; 3
   0677   4d            	DB	4DH		; 4
   0678   5b            	DB	5BH		; 5
   0679   7b            	DB	7BH		; 6
   067a   0e            	DB	0EH		; 7
   067b   7f            	DB	7FH		; 8
   067c   5f            	DB	5FH		; 9
                        
                        ; =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
                        ;
                        ;	Tape routines from PAM/8 - these are specific to the H8 hardware
                        ;	and need to be either removed or rewritten 
                        ;	
                        ;
                        ;	CRC - COMPUTE CRC-16
                        ;
                        ;	CRC COMPUTES A CRC-16 CHECKSUM FOR THE POLYNOMIAL
                        ;
                        ;	(X + 1) * (X^15 + X + 1)
                        ;
                        ;	SINCE THE CHECKSUM GENERATED IS A DIVISION REMAINDER,
                        ;	A CHECKSUMED DATA SEQUENCE CAN BE VERIFIED BY RUNNING
                        ;	THE DATA THROUGH CRC, AND THEN RUNNING THE PREVIOUSLY OBTAINED
                        ;	CHECKSUM THROUGH CRC. THE RESULTANT CHECKSUM SHOULD BE 0.
                        ;
                        ;	ENTRY	(CRCSUM) = CURRENT CHECKSUM
                        ;		(A) = BYTE
                        ;	EXIT	(CRCSUM) UPDATED
                        ;		(A) UNCHANGED
                        ;	USES	F
                        
   067d   c5            CRC	PUSH	B		; SAVE (BC)
   067e   06 08         	MVI	B,8		; (B) = BIT COUNT
   0680   e5            	PUSH	H
   0681   2a 17 20      	LHLD	CRCSUM
   0684   07            CRC1	RLC
   0685   4f            	MOV	C,A		; (C) = BIT
   0686   7d            	MOV	A,L
   0687   87            	ADD	A
   0688   6f            	MOV	L,A
   0689   7c            	MOV	A,H
   068a   17            	RAL
   068b   67            	MOV	H,A
   068c   17            	RAL
   068d   a9            	XRA	C
   068e   0f            	RRC
   068f   d2 9a 06      	JNC	CRC2		; IF NOT TO XOR
   0692   7c            	MOV	A,H
   0693   ee 80         	XRI	200Q
   0695   67            	MOV	H,A
   0696   7d            	MOV A,L
   0697   ee 05         	XRI	5Q
   0699   6f            	MOV	L,A
   069a   79            CRC2	MOV	A,C
   069b   05            	DCR	B
   069c   c2 84 06      	JNZ	CRC1		; IF MORE TO GO
   069f   22 17 20      	SHLD	CRCSUM
   06a2   e1            	POP	H		; RESTORE (HL)
   06a3   c1            	POP	B		; RESTORE (BC)
   06a4   c9            	RET			; EXIT
                        
                        ;	RMEM - LOAD MEMORY FROM TAPE
                        ;
                        
   06a5   21 7f 07      RMEM	LXI	H,TPABT
   06a8   22 19 20      	SHLD	TPERRX		; SETUP ERROR EXIT ADDRESS
   06ab   c3 ae 06      	JMP	LOAD
                        
                        ;	LOAD - LOAD MEMORY FROM TAPE
                        ;
                        ;	READ THE NEXT RECORD FROM THE CASSETTE TAPE.
                        ;
                        ;	USE THE LOAD ADDRESS IN THE TAPE RECORD.
                        ;
                        ;	ENTRY	(HL) = ERROR EXIT ADDRESS
                        ;	EXIT	USER P-REG (IN STACK) SET TO ENTRY ADDRESS
                        ;		TO CALLER IF ALL OK
                        ;		TO ERROR EXIT IF TAPE ERRORS DETECTED.
                        
   06ae   01 00 fe      LOAD	LXI	B,177000Q	 ; 400Q-RT.MI*256-256 (BC) = - REQUIRED TYPE AND #
   06b1   cd 90 07      LOA0	CALL	SRS		; SCAN FOR RECORD START
   06b4   6f            	MOV	L,A		; (HL) = COUNT
   06b5   eb            	XCHG			; (DE) = COUNT, (HL) = TYPE AND #
   06b6   0d            	DCR	C		; (C) = - NEXT #
   06b7   09            	DAD	B
   06b8   7c            	MOV	A,H
   06b9   c5            	PUSH	B		; SAVE TYPE AND #
   06ba   f5            	PUSH	PSW		; SAVE TYPE CODE
   06bb   e6 7f         	ANI	177Q		; CLEAR END FLAG BIT
   06bd   b5            	ORA	L
   06be   3e 02         	MVI	A,2		; SEQUENCE ERROR
   06c0   c2 60 07      	JNZ	TPERR		; IF NOT RIGHT TYPE OF SEQUENCE
   06c3   cd b0 07      	CALL	RNP		; READ ADDR
   06c6   44            	MOV	B,H
   06c7   4f            	MOV	C,A		; (BC) = P-REG ADDRESS
   06c8   3e 0a         	MVI	A,10
   06ca   d5            	PUSH	D		; SAVE (DE)
   06cb   cd 9f 02      	CALL	LRA.		; LOCATE REG ADDRESS
   06ce   d1            	POP	D		; RESTORE (DE)
   06cf   71            	MOV	M,C		; SET P-REG IN MEM
   06d0   23            	INX	H
   06d1   70            	MOV	M,B
   06d2   cd b0 07      	CALL	RNP		; READ ADDRESS
   06d5   6f            	MOV	L,A		; (HL) = ADDRESS, (DE) = COUNT
   06d6   22 00 20      	SHLD	START
                        
   06d9   cd b4 07      LOA1	CALL	RNB		; READ BYTE
   06dc   77            	MOV	M,A
   06dd   22 14 20      	SHLD	ABUSS		; SET ABUSS FOR DISPLAY
   06e0   23            	INX	H
   06e1   1b            	DCX	D
   06e2   7a            	MOV	A,D
   06e3   b3            	ORA	E
   06e4   c2 d9 06      	JNZ	LOA1		; IF MORE TO GO
                        
   06e7   cd 55 07      	CALL	CTC		; CHECK TAPE CHECKSUM
                        
                        ;	READ NEXT BLOCK
                        
   06ea   f1            	POP	PSW		; (A) = FILE TYPE BYTE
   06eb   c1            	POP	B		; (BC) = -(LAST TYPE, LAST #0
   06ec   07            	RLC
   06ed   da 52 07      	JC	TFT		; ALL DONE - TURN OFF TAPE
   06f0   c3 b1 06      	JMP	LOA0		; READ ANOTHER RECORD
                        ;	DUMP - DUMP MEMORY TO MAG TAPE.
                        ;
                        ;	DUMP SPECIFIED MEMORY RANGE TO MAG TAPE.
                        ;
                        ;	ENTRY	(START) = START ADDRESS
                        ;		(ABUSS) = END ADDRESS
                        ;		USER PC = ENTRY POINT ADDRESS
                        ;	EXIT	TO CALLER.
                        
   06f3   21 7f 07      WMEM	LXI	H,TPABT
   06f6   22 19 20      	SHLD	TPERRX		; TAPE ERROR EXIT
                        
   06f9   3e 01         DUMP	MVI	A,UCI.TE
   06fb   d3 f9         	OUT	OP.TPC		; SETUP TAPE CONTROL
   06fd   3e 16         	MVI	A,A.SYN
   06ff   26 20         	MVI	H,32		; (H) = # OF SYNC CHARACTERS
   0701   cd c7 07      WME1	CALL	WNB
   0704   25            	DCR	H
   0705   c2 01 07      	JNZ	WME1		; WRITE SYN HEADER
   0708   3e 02         	MVI	A,A.STX
   070a   cd c7 07      	CALL	WNB		; WRITE STX
   070d   6c            	MOV	L,H		; (HL) = 00
   070e   22 17 20      	SHLD	CRCSUM		; CLEAR CRC 16
   0711   21 01 81      	LXI	H,100401Q	; RT.MI+80H*256+1 FIRST AND LAST MI RECORD
   0714   cd c2 07      	CALL	WNP
   0717   2a 00 20      	LHLD	START
   071a   eb            	XCHG			; (D,E) = START ADDRESS
   071b   2a 14 20      	LHLD	ABUSS		; (H,L) = STOP ADDR
   071e   23            	INX	H		; COMPUTE WITH STOP+1
   071f   7d            	MOV	A,L
   0720   93            	SUB	E
   0721   6f            	MOV	L,A
   0722   7c            	MOV	A,H
   0723   9a            	SBB	D
   0724   67            	MOV	H,A		; (HL) = COUNT
   0725   cd c2 07      	CALL	WNP		; WRITE COUNT
   0728   e5            	PUSH	H
   0729   3e 0a         	MVI	A,10
   072b   d5            	PUSH	D		; SAVE (DE)
   072c   cd 9f 02      	CALL	LRA.		; LOCATE P-REG ADDRESS
   072f   7e            	MOV	A,M
   0730   23            	INX	H
   0731   66            	MOV	H,M
   0732   6f            	MOV	L,A		; (HL) = CONTENTS OF PC
   0733   cd c2 07      	CALL	WNP		; WRITE HEADER
   0736   e1            	POP	H		; (HL) = ADDRESS
   0737   d1            	POP	D		; (DE) = COUNT
   0738   cd c2 07      	CALL	WNP
                        
   073b   7e            WME2	MOV	A,M
   073c   cd c7 07      	CALL	WNB		; WRITE BYTE
   073f   22 14 20      	SHLD	ABUSS		; SET ADDRESS FOR DISPLAY
   0742   23            	INX	H
   0743   1b            	DCX	D
   0744   7a            	MOV	A,D
   0745   b3            	ORA	E
   0746   c2 3b 07      	JNZ	WME2		; IF MORE TO GO
                        
                        ;	WRITE CHECKSUM
                        
   0749   2a 17 20      	LHLD	CRCSUM
   074c   cd c2 07      	CALL	WNP		; WRITE IT
   074f   cd c2 07      	CALL	WNP		; FLUSH CHECKSUM
                        ;	JMP	TFT
                        
                        ;	TFT - TURN OFF TAPE.
                        ;
                        ;	STOP THE TAPE TRANSPORT.
                        ;
                        
   0752   af            TFT	XRA	A
   0753   d3 f9         	OUT	OP.TPC		; TURN OFF TAPE
                        
                        ;	CTC - VERIFY CHECKSUM.
                        ;
                        ;	ENTRY	TAPE JUST BEFORE CRC
                        ;	EXIT	TO CALLER IF OK
                        ;		TO *TPERR* IF BAD
                        ;	USES	A,F,H,L
                        
   0755   cd b0 07      CTC	CALL	RNP		; READ NEXT PAIR
   0758   2a 17 20      	LHLD	CRCSUM
   075b   7c            	MOV	A,H
   075c   b5            	ORA	L
   075d   c8            	RZ			; RETURN IF OK
   075e   3e 01         	MVI	A,1		; CHECKSUM ERROR
                        ;	JMP	TPERR		; (B) = CODE
                        
                        ;	TPERR - PROCESS TAPE ERROR.
                        ;
                        ;	DISPLAY ERR NUMBER IN LOW BYTE OF ABUSS
                        ;
                        ;	IF ERROR NUMBER EVEN, DON'T ALLOW #
                        ;	IF ERROR NUMBER ODD, ALLOW #
                        ;
                        ;	ENTRY	(A) = NUMBER
                        
   0760   32 14 20      TPERR	STA	ABUSS
   0763   47            	MOV	B,A		; (B) = CODE
   0764   cd 52 07      	CALL	TFT		; TURN OFF TAPE
                        
                        ;	IS #, RETURN (IF PARITY ERROR)
                        
   0767   e6            	DB	MI.ANI		; FALL THROUGH WITH CARRY CLEAR
   0768   78            TER3	MOV	A,B
                        
   0769   0f            	RRC
   076a   d8            	RC			; RETURN IF OK
                        
                        ;	BEEP AND FLASH ERROR NUMBER
                        
   076b   dc 74 02      TER1	CC	ALARM		; ALARM IF PROPER TIME
   076e   cd 85 07      	CALL	TPXIT		; SEE IF #
   0771   db f0         	IN	IP.PAD
   0773   fe 2f         	CPI	00101111B	; CHECK FOR #
   0775   ca 68 07      	JZ	TER3		; IF #
   0778   3a 1c 20      	LDA	TICCNT+1
   077b   1f            	RAR			; 'C' SET IF 1/2 SECOND
   077c   c3 6b 07      	JMP	TER1
                        
                        ;	TPABT - ABORT TAPE LOAD OR DUMP.
                        ;
                        ;	ENTERED WHEN LOADING OR DUMPING, AND THE '*' KEY
                        ;	IS STRUCK.
                        
   077f   af            TPABT	XRA	A
   0780   d3 f9         	OUT	OP.TPC		; OFF TAPE
   0782   c3 92 01      	JMP	ERROR
                        
                        ;	TPXIT - CHECK FOR USER FORCED EDIT.
                        ;
                        ;	TPXIT CHECKS FOR AN `*` KEYPAD ENTRY. IF SO, TAKE
                        ;	THE TAPE DRIVER ABNORMAL EXIT.
                        ;
                        ;	ENTRY	NONE
                        ;	EXIT	TO *RET* IF NOT '*'
                        ;		(A) = PORT STATUS
                        ;		TO (TPERRX) IF '*' DOWN
                        ;	USES	A,F
                        
   0785   db f0         TPXIT	IN	IP.PAD
   0787   fe 6f         	CPI	01101111B	; *
   0789   db f9         	IN	IP.TPC		; READ TAPE STATUS
   078b   c0            	RNZ			; NOT '*', RETURN WITH STATUS
   078c   2a 19 20      	LHLD	TPERRX
   078f   e9            	PCHL			; ENTER (TPERRX)
                        
                        ;	SRS - SCAN RECORD START
                        ;
                        ;	SRS READS BYTES UNTIL IT RECOGNIZES THE START OF A RECORD.
                        ;
                        ;	THIS REQUIRES
                        ;	AT LEAST 10 SYNC CHARACTERS
                        ;	1 STX CHARACTER
                        ;
                        ;	THE CRC-16 IS THEN INITIALIZED.
                        ;
                        ;	ENTRY	NONE
                        ;	EXIT	TAPE POSITIONED (AND MOVING), CRCSUM=0
                        ;		(DE) = HEADER BYTES
                        ;		(HL) = RECORD COUNT
                        ;	USES	A,F,D,E,H,L
                        
   0790                 SRS
   0790   16 00         SRS1	MVI	D,0
   0792   62            	MOV	H,D
   0793   6a            	MOV	L,D		; (HL) = 0
   0794   cd b4 07      SRS2	CALL	RNB		; READ NEXT BYTE
   0797   14            	INR	D
   0798   fe 16         	CPI	A.SYN
   079a   ca 94 07      	JZ	SRS2		; HAVE SYN
   079d   fe 02         	CPI	A.STX
   079f   c2 90 07      	JNZ	SRS1		; NOT STX - START OVER
                        
   07a2   3e 0a         	MVI	A,10
   07a4   ba            	CMP	D		; SEE IF ENOUGH SYNC CHARACTERS
   07a5   d2 90 07      	JNC	SRS1		; NOT ENOUGH
   07a8   22 17 20      	SHLD	CRCSUM		; CLEAR CRC-16
   07ab   cd b0 07      	CALL	RNP		; READ LEADER
   07ae   54            	MOV	D,H
   07af   5f            	MOV	E,A
                        ;	JMP	RNP		; READ COUNT
                        
                        ;	RNP - READ NEXT PAIR.
                        ;
                        ;	RNP READS THE NEXT TWO BYTES FROM THE INPUT DEVICE.
                        ;
                        ;	ENTRY	NONE
                        ;	EXIT	(H,A) = BYTE PAIR
                        ;	USES	A,F,H
                        
   07b0   cd b4 07      RNP	CALL	RNB		; READ NEXT BYTE
   07b3   67            	MOV	H,A
                        ;	JMP	RNB		; READ NEXT BYTE
                        
                        ;	RNB - READ NEXT BYTE
                        ;
                        ;	RNB READS THE NEXT SINGLE BYTE FROM THE INPUT DEVICE.
                        ;	THE CHECKSUM IS TAKEN FOR THE CHARACTER.
                        ;
                        ;	ENTRY	NONE
                        ;	EXIT	(A) = CHARACTER
                        ;	USES	A,F
                        
   07b4   3e 34         RNB	MVI	A,UCI.RO+UCI.ER+UCI.RE ; TURN ON READER FOR NEXT BYTE
   07b6   d3 f9         	OUT	OP.TPC
   07b8   cd 85 07      RNB1	CALL	TPXIT		; CHECK FOR *, READ STATUS
   07bb   e6 02         	ANI	USR.RXR
   07bd   ca b8 07      	JZ	RNB1		; IF NOT READY
   07c0   db f8         	IN	IP.TPD		; INPUT DATA
                        ;	JMP	CRC		; CHECKSUM
                        
                        
                        ;	WNP - WRITE NEXT PAIR
                        ;
                        ;	WNP WRITE THE NEXT TWO BYTES TO THE CASSETTE DRIVE.
                        ;
                        ;	ENTRY	(H,L) = BYTES
                        ;	EXIT	WRITTEN.
                        ;	USES	A,F
                        
   07c2   7c            WNP	MOV	A,H
   07c3   cd c7 07      	CALL	WNB
   07c6   7d            	MOV	A,L
                        ;	JMP	WNB		; WRITE NEXT BYTE
                        
                        ;	WNB - WRITE NEXT BYTE
                        ;
                        ;	WNB WRITE THE NEXT BYTE TO THE CASSETTE TAPE.
                        ;
                        ;	ENTRY	(A) = BYTE
                        ;	EXIT	NONE.
                        ;	USES	F
                        
   07c7   f5            WNB	PUSH	PSW
   07c8   cd 85 07      WNB1	CALL	TPXIT		; CHECK FOR #, READ STATUS
   07cb   e6 01         	ANI	USR.TXR
   07cd   ca c8 07      	JZ	WNB1		; IF MORE TO GO
   07d0   3e 11         	MVI	A,UCI.ER+UCI.TE ; ENABLE TRANSMITTER
   07d2   d3 f9         	OUT	OP.TPC		; TURN ON TAPE
   07d4   f1            	POP	PSW
   07d5   d3 f8         	OUT	OP.TPD		; OUTPUT DATA
   07d7   c3 7d 06      	JMP	CRC		; COMPUTE CRC
                        
                        
                        
                        ;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
                        ;
                        ;	RAM storage
                        ;
                        ;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
                        
   2000                 	ORG	2000H	; 8192 = beginning of RAM
                        
                        ;
                        ;	PAM-8 uses the first 64 bytes of RAM for working space
                        ;
                        ;	THE FOLLOWING ARE CONTROL CELLS AND FLAGS USED BY THE KEYPAD
                        ;	MONITOR.
                        	
   2000                 START	DS	2	; DUMP STARTING ADDRESS
                        ;
                        ;	These two bytes are updated in real time to be either
                        ;	IN or OUT instructions and the associated port - gfr
                        ;
   2002                 IOWRK	DS	2	; IN OR OUT INSTRUCTION
                        ;
                        ;	The following locations are initialized from PRSROM - gfr
                        ;
   2004                 PRSRAM	DS	1	; RET (from IOWRK)
                        
                        ;
                        ;	REGI:	2	AF
                        ;		4	BC
                        ;		6	DE
                        ;		8	HL
                        ;		A	Pc
                        ;
   2005                 REGI	DS	1	; INDEX OF REGISTER UNDER DISPLAY
   2006                 DSPROT	DS	1	; PERIOD FLAG BYTE
   2007                 DSPMOD	DS	1	; DISPLAY MODE (if bit 0 set then in Alter mode)
                        
   2008                 MFLAG	DS	1	; USER FLAG OPTIONS
                        			; SEE *UI.XXX* BITS DESCRIBED AT FRONT
                        
   2009                 CTLFLG	DS	1	; FRONT PANEL CONTROL BITS
   200a                 REFIND	DS	1	; REFRESH INDEX (0 TO 7)
   0007                 PRSL	EQU	7	; END OF AREA INITIALIZED FROM ROM
                        
                        
                        
   200b                 FPLEDS			; FRONT PANEL LED PATTERNS
   200b                 ALEDS	DS	1	; ADDR 0
   200c                 	DS	1	; ADDR 1
   200d                 	DS	1	; ADDR 2
                        
   200e                 	DS	1	; ADDR 3
   200f                 	DS	1	; ADDR 4
   2010                 	DS	1	; ADDR 5
                        
   2011                 DLEDS	DS	1	; DATA 0
   2012                 	DS	1	; DATA 1
   2013                 	DS	1	; DATA 2
                        
   2014                 ABUSS	DS	2	; ADDRESS BUS
   2016                 RCKA	DS	1	; RCK SAVE AREA
   2017                 CRCSUM	DS	2	; CRC-16 CHECKSUM
   2019                 TPERRX	DS	2	; TAPE ERROR EXIT ADDRESS
   201b                 TICCNT	DS	2	; CLOCK TIC COUNTER
                        
   201d                 REGPTR	DS	2	; REGISTER CONTENTS POINTER
                        
   201f                 UIVEC			; USER INTERRUPT VECTOR
   201f                 	DS	3	; JUMP TO CLOCK PROCESSOR
   2022                 	DS	3	; JUMP TO SINGLE STEP PROCESSOR
   2025                 	DS	3	; JUMP TO I/O 3
   2028                 	DS	3	; JUMP TO I/O 4
   202b                 	DS	3	; JUMP TO I/O 5
   202e                 	DS	3	; JUMP TO I/O 6
   2031                 	DS	3	; JUMP TO I/O 7
                        ;
                        ;	new RAM locations for MiniPAM8
                        ;
   2034                 PCKVAL	DS	1	; PCK value from most recent scan (9 ticks)
   2035                 PCKTMP	DS	1	; temporary candidate keypad response from PCK
                        ;
                        ;	We want to limit our monitor RAM storage to 40H or fewer bytes
                        ;	so we have only a small serial handler buffer here (2 bytes)
                        ;	but the user can overwrite these values to make it as
                        ;	large as need be.
                        ;
   2036   39 20         INBADDR	DW	$INBUF	; points to location of input buffer
   2038   01            INBLEN	DB	$INBUFL	; max length of buffer
   2039   00            $INBUF	DB	0	; input buffer count
   203a                 	DS	2	; very small buffer
   0001                 $INBUFL	EQU	*-$INBUF-2	; max length of buffer
                        
                        
   203c                 	END
0325  $HLIHL        2039  $INBUF        0001  $INBUFL       0002  A.STX     
